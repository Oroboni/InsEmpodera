<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>InsEmpodera-Local-Development</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);deploy/**;TestResults/**;strix_runs/**;scripts/**;docs/**;.config/**;.github/**;.vs/**;.vscode/**;InsEmpodera.Tests/**;InsEmpodera.E2ETests/**;Frontend.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive;</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="NovaPasta\" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/uploads/**" />
    <None Remove="wwwroot/uploads/**" />
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="dotnet-tools.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update=".config/dotnet-tools.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="InsEmpodera.Tests\**\*.cs" />
    <Compile Remove="scripts\ForeignKey.Tests\**\*.cs" />
    <Content Remove="InsEmpodera.Tests\**" />
    <EmbeddedResource Remove="InsEmpodera.Tests\**" />
    <None Remove="InsEmpodera.Tests\**" />
    <Compile Remove="InsEmpodera.E2ETests\**\*.cs" />
    <Content Remove="InsEmpodera.E2ETests\**" />
    <EmbeddedResource Remove="InsEmpodera.E2ETests\**" />
    <None Remove="InsEmpodera.E2ETests\**" />
    <Compile Remove="Frontend.Tests\**\*.cs" />
    <Content Remove="Frontend.Tests\**" />
    <EmbeddedResource Remove="Frontend.Tests\**" />
    <None Remove="Frontend.Tests\**" />
    <Compile Remove="TestResults\**\*.cs" />
    <Content Remove="TestResults\**" />
    <EmbeddedResource Remove="TestResults\**" />
    <None Remove="TestResults\**" />
    <Compile Remove="strix_runs\**\*.cs" />
    <Content Remove="strix_runs\**" />
    <EmbeddedResource Remove="strix_runs\**" />
    <None Remove="strix_runs\**" />
  </ItemGroup>
</Project>
