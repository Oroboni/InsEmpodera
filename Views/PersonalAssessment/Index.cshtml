@model List<Empodera.Models.AvaliacaoPessoal>

@{
    ViewData["Title"] = "Avaliações Pessoais";
    Layout = "_Layout";
    ViewData["PageCSS"] = "homepage";
    int? selectedAtorId = ViewBag.SelectedAtorId;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/comunidadesDetalhes.css" />
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css"/>
    <link rel="stylesheet" href="~/css/pages/personal-assessment.css" />
}

<div class="modern-container">
    <!-- Header -->
    <div class="header-section">
        <h2>
            <strong class="text-primary">Avaliações Pessoais</strong>
        </h2>
    </div>

    <!-- Filtro de Ator -->
    <div class="input-card full-width">
        <div class="icon-box"><i class="fa-solid fa-user"></i></div>
        <div class="input-content">
            <label for="atorSelect">Selecione o Ator</label>
            <form asp-action="Index" method="get" id="atorSelectForm">
                <select id="atorSelect" name="atorId" class="clean-input" asp-items="ViewBag.AtoresList"
                    onchange="document.getElementById('atorSelectForm').submit();">
                    <option value="">Selecione um Ator</option>
                </select>
            </form>
        </div>
    </div>

    @if (selectedAtorId.HasValue)
    {
        <!-- Barra de Busca -->
        <div class="search-container">
            <div class="search-input-group">
                <div class="search-wrapper">
                    <input type="search" id="searchAssessmentInput" placeholder="Busque por data ou avaliador..."
                        aria-label="Buscar avaliações" />
                    <button type="button" class="btn-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>

            <button type="button" class="btn-add" 
                onclick="window.location.href='@Url.Action("Create", "PersonalAssessment", new { atorId = selectedAtorId })'"
                title="Adicionar Nova Avaliação">
                <i class="fa-solid fa-plus"></i>
            </button>
        </div>

        @if (Model != null && Model.Any())
        {
            <!-- Estatísticas -->
            <div class="section-label">Resumo</div>
            <div class="actions-grid">
                <div class="action-card stats-card">
                    <span class="card-title" style="font-size: var(--font-size-4xl);" id="totalAssessments">@Model.Count()</span>
                    <span class="card-subtitle">Total de Avaliações</span>
                    <div class="card-icons">
                        <i class="fas fa-star"></i>
                    </div>
                </div>

                @{
                    var avaliadoresUnicos = Model.Select(a => a.Usuario?.Nome).Distinct().Count();
                }
                <div class="action-card stats-card" style="background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%);">
                    <span class="card-title" style="font-size: var(--font-size-4xl);">@avaliadoresUnicos</span>
                    <span class="card-subtitle">Avaliadores</span>
                    <div class="card-icons">
                        <i class="fas fa-user-friends"></i>
                    </div>
                </div>

                @{
                    var ultimaAvaliacao = Model.OrderByDescending(a => a.DtCriacao).FirstOrDefault();
                    var diasDesdeUltima = ultimaAvaliacao != null ? 
                        (DateTime.Now - ultimaAvaliacao.DtCriacao).Days : 0;
                }
                <div class="action-card stats-card" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);">
                    <span class="card-title" style="font-size: var(--font-size-4xl);">@diasDesdeUltima</span>
                    <span class="card-subtitle">Dias desde última</span>
                    <div class="card-icons">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                </div>
            </div>

            <!-- Lista de Avaliações -->
            <div class="purple-divider"></div>
            <div class="section-label">Todas as Avaliações</div>

            <div class="forms-list" id="assessmentsGrid">
                @foreach (var avaliacao in Model.OrderByDescending(a => a.DtCriacao))
                {
                    var dataFormatada = avaliacao.DtCriacao.ToString("dd/MM/yyyy");
                    var avaliadorNome = avaliacao.Usuario?.Nome ?? "Não informado";
                    
                    <div class="form-item assessment-item" 
                         data-date="@dataFormatada.ToLower()" 
                         data-evaluator="@avaliadorNome.ToLower()">
                        
                        <div class="form-info" style="flex: 1;">
                            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
                                <div class="activity-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                    <i class="fas fa-star"></i>
                                </div>
                                <div style="flex: 1;">
                                    <p class="name" style="margin: 0;">Avaliação de @dataFormatada</p>
                                    <p style="color: var(--color-gray-500); font-size: 0.875rem; margin: 0.25rem 0 0 0;">
                                        <i class="fas fa-user" style="margin-right: 0.25rem;"></i>
                                        Avaliado por @avaliadorNome
                                    </p>
                                    
                                    @{
                                        // Calcular média das métricas
                                        var metricas = new[] { 
                                            avaliacao.CCrimes, 
                                            avaliacao.Prevencao, 
                                            avaliacao.Substancias,
                                            avaliacao.Moradia,
                                            avaliacao.AssBasica,
                                            avaliacao.Educacao,
                                            avaliacao.Saude,
                                            avaliacao.Ocupacao,
                                            avaliacao.Lazer
                                        };
                                        var media = metricas.Average();
                                        var statusClass = media <= 2 ? "tag-green" : media <= 3.5 ? "tag-yellow" : "tag-red";
                                        var statusText = media <= 2 ? "Ótimo" : media <= 3.5 ? "Moderado" : "Atenção";
                                    }
                                    
                                    <div class="tag-list" style="margin-top: 0.5rem;">
                                        <span class="tag-item @statusClass">
                                            <i class="fas fa-chart-line"></i>
                                            @statusText (Média: @media.ToString("F1"))
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="actions">
                            <a class="btn-action" asp-controller="PersonalAssessment" asp-action="Edit" 
                               asp-route-id="@avaliacao.IdAvaliacao" title="Ver detalhes">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Nenhuma avaliação cadastrada -->
            <div class="no-records" style="padding: 3rem; text-align: center;">
                <div style="margin-bottom: 1.5rem;">
                    <i class="fas fa-star" style="font-size: 4rem; color: var(--color-gray-400);"></i>
                </div>
                <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Nenhuma avaliação cadastrada</h3>
                <p style="color: var(--color-gray-500); margin-bottom: 1.5rem;">
                    Comece adicionando a primeira avaliação pessoal para este ator.
                </p>
                <button type="button" class="btn-save" 
                    onclick="window.location.href='@Url.Action("Create", "PersonalAssessment", new { atorId = selectedAtorId })'">
                    <i class="fa-solid fa-plus"></i> Adicionar Primeira Avaliação
                </button>
            </div>
        }

        <!-- Mensagem quando nenhum resultado for encontrado -->
        <div class="no-records" id="noResultsMessage" style="display: none; padding: 3rem; text-align: center;">
            <div style="margin-bottom: 1.5rem;">
                <i class="fas fa-search" style="font-size: 4rem; color: var(--color-gray-400);"></i>
            </div>
            <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Nenhuma avaliação encontrada</h3>
            <p style="color: var(--color-gray-500);">
                Tente ajustar os termos de busca.
            </p>
        </div>
    }
    else
    {
        <!-- Estado vazio - Selecione um ator -->
        <div class="no-records" style="padding: 3rem; text-align: center;">
            <div style="margin-bottom: 1.5rem;">
                <i class="fas fa-user" style="font-size: 4rem; color: var(--color-gray-400);"></i>
            </div>
            <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Selecione um Ator</h3>
            <p style="color: var(--color-gray-500);">
                Para visualizar as avaliações, primeiro selecione um ator no filtro acima.
            </p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchAssessmentInput');
            
            if (!searchInput) return;

            const assessmentsGrid = document.getElementById('assessmentsGrid');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const assessmentItems = document.querySelectorAll('.assessment-item');

            // Função para filtrar avaliações
            function filterAssessments() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                assessmentItems.forEach(item => {
                    const date = item.getAttribute('data-date') || '';
                    const evaluator = item.getAttribute('data-evaluator') || '';

                    // Verificar se corresponde à busca
                    const matchesSearch = date.includes(searchTerm) || evaluator.includes(searchTerm);

                    if (matchesSearch) {
                        item.style.display = 'flex';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                // Mostrar/ocultar mensagem de "nenhum resultado"
                if (visibleCount === 0 && assessmentItems.length > 0) {
                    if (assessmentsGrid) assessmentsGrid.style.display = 'none';
                    if (noResultsMessage) noResultsMessage.style.display = 'block';
                } else {
                    if (assessmentsGrid) assessmentsGrid.style.display = 'flex';
                    if (noResultsMessage) noResultsMessage.style.display = 'none';
                }
            }

            // Event listener para busca
            searchInput.addEventListener('input', filterAssessments);

            // Limpar busca ao pressionar ESC
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    searchInput.value = '';
                    filterAssessments();
                }
            });
        });
    </script>
}