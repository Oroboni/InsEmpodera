@model List<Empodera.Models.AvaliacaoPessoal>
@{
    ViewData["Title"] = "Avaliações Pessoais";
    Layout = "_Layout";
    ViewData["DisableMainScroll"] = "true";
    int? selectedAtorId = ViewBag.SelectedAtorId;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/atores.css" /> 
    <link rel="stylesheet" href="~/css/pages/activity-form.css" />
    <link rel="stylesheet" href="~/css/pages/create-form.css" />
    <link rel="stylesheet" href="~/css/pages/personal-assessment.css" />
}

<div class="assessment-page-container">

    <div class="assessment-header">
        <div class="assessment-title">
            <h2>Avaliações Pessoais</h2>
        </div>
        
        <form asp-action="Index" method="get" id="atorSelectForm">
            <div class="form-group">
                <label for="atorId">Ator</label>
                <div class="select-wrapper">
                    <i class="fa-solid fa-user"></i>
                    <select id="atorId" name="atorId" class="form-control" asp-items="ViewBag.AtoresList" 
                            onchange="document.getElementById('atorSelectForm').submit();">
                        <option value="">Selecione um Ator</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>
        </form> @if (selectedAtorId.HasValue)
        {
            <div class="assessment-controls">
                
                <form class="search-bar" asp-action="Index" method="get">
                    <input type="hidden" name="atorId" value="@selectedAtorId" />
                    
                    
                    <button type="submit" class="search-icon-button">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    </button>
                </form> <a asp-action="Create" asp-route-atorId="@selectedAtorId" class="btn-add-assessment">
                    <i class="fa-solid fa-plus"></i> ADICIONAR
                </a>
            </div>

            <div class="bottom-filters">
            <div class="search-container">
                <div class="search-input-group">
                    <div class="search-wrapper">
                        <div asp-action="Index" method="get">
                          
                            
                    <input type="search" class="search-input" name="searchQuery" placeholder="Buscar por data ou avaliador..." />
                     <button type="submit" class="btn-search">
                            <i class="fa fa-search"></i>
                        </button>
                            
                        </div>
                    </div>
                </div>
                <a class="btn-add" asp-controller="Atividades" asp-action="Create" title="Adicionar Nova Ficha">
                    <i class="fa fa-plus"></i>
                </a>
            </div>
    </div>
        }
    </div> <div class="assessment-content-area">
        @if (!selectedAtorId.HasValue)
        {
            <div class="empty-state-container">
                <img src="~/img/undraw_selection.svg" alt="Selecione um ator" />
                <p>Primeiro Selecione o Ator</p>
            </div>
        }
        else if (Model == null || Model.Count == 0)
        {
            <div class="no-items-found">
                Nenhum item encontrado
            </div>
        }
        else
        {
            <div class="assessment-list-container">
                @foreach (var item in Model)
                {
                    <div class="assessment-card">
                        <div class="assessment-card-info">
                            <div class="date">@item.DtCriacao.ToString("dd/MM/yyyy")</div>
                            <div class="evaluator">Avaliado por @item.Usuario.Nome</div>
                        </div>
                        <a class="details-icon" asp-action="Edit" asp-route-id="@item.IdAvaliacao">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" /></svg>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>