@model Empodera.Models.AvaliacaoPessoal
@{
    ViewData["Title"] = "Avaliação Pessoal - Editar";
    ViewData["PageCSS"] = "personal-assessment-form";
    Layout = "_Layout";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/personal-assessment.css" />
}

<form asp-controller="PersonalAssessment" asp-action="Edit" asp-route-id="@Model.IdAvaliacao" method="post" class="main-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdAvaliacao" />

    <div class="modern-container">
        <!-- Header -->
        <div class="header-section">
            <h2>
                <a asp-controller="PersonalAssessment" asp-action="Index" class="text-primary">Avaliações Pessoais</a>
                <span class="separator">></span>
                <strong class="text-muted">Detalhes da Avaliação Pessoal</strong>
            </h2>
        </div>

        <!-- Seleção de Ator -->
        <div class="input-card full-width">
            <div class="icon-box"><i class="fa-solid fa-user"></i></div>
            <div class="input-content">
                <label asp-for="FkIdUsuario">Ator</label>
                <select asp-for="FkIdUsuario" class="clean-input" asp-items="ViewBag.AtoresList" disabled>
                    <option value="">Selecione um Ator</option>
                </select>
            </div>
        </div>

        <!-- Métricas de Avaliação -->
        <div class="purple-divider"></div>
        <div class="section-label">Dimensões de Avaliação</div>

        <div class="metric-form-group">
            <label class="metric-label" for="RedePrimaria">Rede primária 
                <span class="tooltip-icon" data-tooltip="1. Muitas Relações diversificadas e seguras.&#10;5. Poucas relações diversificadas e seguras.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="CCrimes" min="1" max="5">
        </div>
        
        <div class="metric-form-group">
            <label class="metric-label" for="SeguridadeSocial">Seguridade Social 
                <span class="tooltip-icon" data-tooltip="1. Acesso pleno e fácil.&#10;5. Sem acesso ou com muitas barreiras.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Prevencao" min="1" max="5">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Substancias">Substâncias 
                <span class="tooltip-icon" data-tooltip="1. Uso problemático ou dependência.&#10;5. Nenhum uso ou uso não problemático.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Substancias" min="1" max="5">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Moradia">Moradia 
                <span class="tooltip-icon" data-tooltip="1. Moradia segura, estável e adequada.&#10;5. Moradia precária, instável ou inexistente.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Moradia" min="1" max="5">
        </div>
        
        <div class="metric-form-group">
            <label class="metric-label" for="AssistenciaBasica">Assistência Básica 
                <span class="tooltip-icon" data-tooltip="1. Necessidades básicas (comida, roupa) atendidas.&#10;5. Necessidades básicas não atendidas.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="AssBasica" min="1" max="5">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Educacao">Educação 
                <span class="tooltip-icon" data-tooltip="1. Acesso pleno à educação.&#10;5. Fora da escola ou acesso precário.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Educacao" min="1" max="5">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Saude">Saúde 
                <span class="tooltip-icon" data-tooltip="1. Acesso regular a serviços de saúde (física e mental).&#10;5. Sem acesso ou acesso dificultado.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Saude" min="1" max="5">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Ocupacao">Ocupação 
                <span class="tooltip-icon" data-tooltip="1. Trabalho/ocupação estável e satisfatório.&#10;5. Desempregado ou em trabalho precário.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Ocupacao" min="1" max="5">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Lazer">Lazer 
                <span class="tooltip-icon" data-tooltip="1. Acesso regular a atividades de lazer e cultura.&#10;5. Nenhum acesso a lazer.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Lazer" min="1" max="5">
        </div>

        <!-- Informações do Sistema -->
        @if (Model.IdAvaliacao > 0)
        {
            <div class="purple-divider"></div>
            <div class="section-label">Informações do Sistema</div>

            <div class="input-card full-width">
                <div class="icon-box"><i class="fa-solid fa-user-edit"></i></div>
                <div class="input-content">
                    <label>Criado por</label>
                    <div class="system-info-display">
                        <span class="info-user">
                            <i class="fa-solid fa-user"></i>
                            @Model.Usuario?.Nome
                        </span>
                    </div>
                </div>
            </div>

            <div class="input-card full-width">
                <div class="icon-box"><i class="fa-solid fa-calendar-plus"></i></div>
                <div class="input-content">
                    <label>Data de Criação</label>
                    <div class="system-info-display">
                        <span class="info-date">@Model.DtCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
            </div>

            <div class="input-card full-width">
                <div class="icon-box"><i class="fa-solid fa-calendar-day"></i></div>
                <div class="input-content">
                    <label>Última Atualização</label>
                    <div class="system-info-display">
                        <span class="info-date">@Model.DtModificacao.ToString("dd/MM/yyyy HH:mm")</span>
                        @if (Model.Usuario != null)
                        {
                            <span class="info-user">
                                <i class="fa-solid fa-user"></i>
                                @Model.Usuario.Nome
                            </span>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Botões de Ação -->
        <div class="buttons-container">
            <a asp-controller="PersonalAssessment" asp-action="Index" asp-route-atorId="@Model.IdAvaliacao" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

            <div class="action-buttons-group">
                <button type="button" class="wizard-btn" id="edit-save-btn">
                    <i class="fa-solid fa-edit"></i> Editar
                </button>

                @if (Model.IdAvaliacao > 0)
                {
                    <button type="button" class="wizard-btn btn-delete" id="openDeleteModalBtn">
                        <i class="fa-solid fa-trash"></i> Deletar
                    </button>
                }
            </div>
        </div>
    </div>
</form>

<!-- Modal de Confirmação de Exclusão -->
@if (Model.IdAvaliacao > 0)
{
    <div class="modal-overlay" id="deleteConfirmationModal">
        <div class="modal-content">
            <div class="modal-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h3 class="modal-title">Confirmar Exclusão</h3>
            <p class="modal-text">
                Você tem certeza que deseja deletar esta avaliação pessoal?
                <br><br>
                Essa ação não pode ser desfeita.
            </p>

            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel wizard-btn btn-prev" id="cancelDeleteBtn">
                    Cancelar
                </button>

                <form asp-controller="PersonalAssessment" asp-action="Delete" method="post" asp-route-id="@Model.IdAvaliacao">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-modal-confirm wizard-btn btn-delete">
                        Sim, Deletar
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/personal-assessment.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.main-form');
            const inputFields = form.querySelectorAll('.clean-input, .metric-slider');
            const editSaveBtn = document.getElementById('edit-save-btn');
            
            let isEditMode = false;
            let isSubmitting = false;

            // Configurar estado dos campos
            function setPageState() {
                if (isEditMode) {
                    inputFields.forEach(field => field.disabled = false);
                    editSaveBtn.innerHTML = '<i class="fa-solid fa-check"></i> Salvar Alterações';
                    editSaveBtn.setAttribute('type', 'submit');
                    editSaveBtn.classList.add('btn-save-final');
                    editSaveBtn.classList.remove('btn-next');
                } else {
                    inputFields.forEach(field => field.disabled = true);
                    editSaveBtn.innerHTML = '<i class="fa-solid fa-edit"></i> Editar';
                    editSaveBtn.setAttribute('type', 'button');
                    editSaveBtn.classList.add('btn-next');
                    editSaveBtn.classList.remove('btn-save-final');
                }
            }

            setPageState();

            // Handler do botão editar/salvar
            editSaveBtn.addEventListener('click', function (e) {
                if (editSaveBtn.getAttribute('type') === 'submit') {
                    if (!isSubmitting && form.checkValidity()) {
                        isSubmitting = true;
                        editSaveBtn.disabled = true;
                        editSaveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processando...';
                        form.submit();
                    }
                } else {
                    e.preventDefault();
                    isEditMode = true;
                    setPageState();
                }
            });

            // Lógica do modal de exclusão
            const deleteModal = document.getElementById('deleteConfirmationModal');
            const openDeleteBtn = document.getElementById('openDeleteModalBtn');
            const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');

            if (openDeleteBtn) {
                openDeleteBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    deleteModal.style.display = 'flex';
                    setTimeout(() => deleteModal.classList.add('active'), 10);
                });
            }

            if (cancelDeleteBtn) {
                cancelDeleteBtn.addEventListener('click', function () {
                    closeDeleteModal();
                });
            }

            window.addEventListener('click', function (e) {
                if (e.target === deleteModal) {
                    closeDeleteModal();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && deleteModal && deleteModal.classList.contains('active')) {
                    closeDeleteModal();
                }
            });

            function closeDeleteModal() {
                deleteModal.classList.remove('active');
                setTimeout(() => deleteModal.style.display = 'none', 300);
            }
        });
    </script>
}