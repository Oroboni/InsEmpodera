@model Empodera.Models.AvaliacaoPessoal
@{
    ViewData["Title"] = "Avaliação Pessoal - Criar";
    ViewData["PageCSS"] = "personal-assessment-form";
    Layout = "_Layout";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/personal-assessment.css" />
}

<form asp-controller="PersonalAssessment" asp-action="Create" method="post" class="main-form">
    @Html.AntiForgeryToken()

    <div class="modern-container">
        <!-- Header -->
        <div class="header-section">
            <h2>
                <a asp-controller="PersonalAssessment" asp-action="Index" asp-route-atorId="@ViewBag.AtorId" class="text-primary">Avaliações Pessoais</a>
                <span class="separator">></span>
                <strong class="text-muted">Nova Avaliação Pessoal</strong>
            </h2>
        </div>

        <!-- Seleção de Ator -->
        <div class="input-card full-width">
            <div class="icon-box"><i class="fa-solid fa-user"></i></div>
            <div class="input-content">
                <label asp-for="FK_id_Atores">Ator <span class="text-danger">*</span></label>
                <select asp-for="FK_id_Atores" class="clean-input" asp-items="ViewBag.AtoresList" required>
                    <option value="">Selecione um Ator</option>
                </select>
                <span asp-validation-for="FK_id_Atores" class="text-danger"></span>
            </div>
        </div>

        <!-- Métricas de Avaliação -->
        <div class="purple-divider"></div>
        <div class="section-label">Dimensões de Avaliação</div>

        <div class="metric-form-group">
            <label class="metric-label" for="RedePrimaria">Rede primária 
                <span class="tooltip-icon" data-tooltip="1. Muitas Relações diversificadas e seguras.&#10;5. Poucas relações diversificadas e seguras.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="CCrimes" min="1" max="5" value="1">
        </div>
        
        <div class="metric-form-group">
            <label class="metric-label" for="SeguridadeSocial">Seguridade Social 
                <span class="tooltip-icon" data-tooltip="1. Não desenvolve atividades ilegais.&#10;5. Desenvolve atividades ilegais.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Prevencao" min="1" max="5" value="1">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Substancias">Substâncias 
                <span class="tooltip-icon" data-tooltip="1.Não faz uso abusivo de substâncias.&#10;5. Faz uso abusivo de substâncias.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Substancias" min="1" max="5" value="1">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Moradia">Moradia 
                <span class="tooltip-icon" data-tooltip="1. Tem garantida moradia digna.&#10;5. Não tem garantida moradia digna.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Moradia" min="1" max="5" value="1">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Prevencao">Prevenção
                <span class="tooltip-icon" data-tooltip="-">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Prevencao" min="1" max="5" value="1">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="AssistenciaBasica">Assistência Básica 
                <span class="tooltip-icon" data-tooltip="1. Possui suas necessidades básicas de alimentação e documentação garantidas.&#10;5. Não possui suas necessidades básicas de alimentação e documentação garantidas.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="AssBasica" min="1" max="5" value="1">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Educacao">Educação 
                <span class="tooltip-icon" data-tooltip="1. Sabe ler, escrever e tem oportunidades e interesse para aprender sobre diversos temas.&#10;5. Não tem oportunidades e nem interesse em aprender sobre diversos temas.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Educacao" min="1" max="5" value="1">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Saude">Saúde 
                <span class="tooltip-icon" data-tooltip="1.Tem os cuidados a saúde assegurado e se cuida.&#10;5. Não tem os cuidados a saúde assegurados e não se cuida.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Saude" min="1" max="5" value="1">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Ocupacao">Ocupação 
                <span class="tooltip-icon" data-tooltip="1. Reconhece suas habilidade e gera renda com elas.&#10;5. Não reconhece habilidades e não gera renda.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Ocupacao" min="1" max="5" value="1">
        </div>

        <div class="metric-form-group">
            <label class="metric-label" for="Lazer">Lazer 
                <span class="tooltip-icon" data-tooltip="1. Tem momento e espaços para lazer.&#10;5. Não tem espaço de lazer.">?</span>
            </label>
            <input type="range" class="metric-slider" asp-for="Lazer" min="1" max="5" value="1">
        </div>

        <!-- Botões de Ação -->
        <div class="buttons-container">
            <a asp-controller="PersonalAssessment" asp-action="Index" asp-route-atorId="@Context.Request.Query["atorId"]" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

            <div class="action-buttons-group">
                <button type="submit" class="wizard-btn btn-next" id="create-assessment-btn">
                    <i class="fa-solid fa-plus"></i> Criar Avaliação
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/personal-assessment.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.main-form');
            const createBtn = document.getElementById('create-assessment-btn');
            let isSubmitting = false;

            // Handler do botão criar
            form.addEventListener('submit', function (e) {
                if (!isSubmitting && form.checkValidity()) {
                    isSubmitting = true;
                    createBtn.disabled = true;
                    createBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Criando...';
                } else if (!form.checkValidity()) {
                    e.preventDefault();
                }
            });
        });
    </script>
}