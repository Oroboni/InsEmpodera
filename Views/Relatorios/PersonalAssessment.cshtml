@{
    ViewData["Title"] = "Relatório - Avaliações Pessoais";
    ViewData["PageCSS"] = "reports";
    Layout = "_Layout";
    // A linha "DisableMainScroll" FOI REMOVIDA daqui para CORRIGIR a rolagem.
    
    // Pega o AtorId selecionado (enviado pelo Controller)
    int? selectedAtorId = ViewBag.SelectedAtorId; 
    var avaliacoes = ViewBag.Avaliacoes as IReadOnlyList<Empodera.Models.AvaliacaoPessoal>
        ?? Array.Empty<Empodera.Models.AvaliacaoPessoal>();
    var avaliacao = ViewBag.AvaliacaoSelecionada as Empodera.Models.AvaliacaoPessoal;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/reports.css" />
}

<div class="report-page-container">
    <div class="report-breadcrumb">
    <h1>
        <a asp-controller="Relatorios" asp-action="Index">Relatórios</a>
        > 
        <strong>Avaliações Pessoais</strong>
    </h1>
</div>

    <div class="report-content-box">
        <div class="report-filters">
            
            <form asp-action="PersonalAssessment" method="get" id="atorSelectForm">
                <div class="form-group">
                    <label>Ator</label>
                    <div class="select-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <select name="atorId" asp-items="ViewBag.AtorList" onchange="this.form.submit()">
                            <option value="">Selecione um Ator...</option>
                        </select>
                        <i class="fa-solid fa-chevron-down select-arrow"></i>
                    </div>
                </div>
            </form>

            @if (selectedAtorId != null && avaliacoes.Count > 0)
            {
                <form asp-action="PersonalAssessment" method="get">
                    <input type="hidden" name="atorId" value="@selectedAtorId" />
                    <div class="form-group">
                        <label for="avaliacaoId">Avaliações pessoais</label>
                        <div class="select-wrapper">
                            <select id="avaliacaoId" name="avaliacaoId" onchange="this.form.submit()">
                                @foreach (var item in avaliacoes)
                                {
                                    <option value="@item.IdAvaliacao" selected="@(avaliacao?.IdAvaliacao == item.IdAvaliacao)">@item.DtCriacao.ToString("dd/MM/yyyy")</option>
                                }
                            </select>
                            <i class="fa-solid fa-chevron-down select-arrow"></i>
                        </div>
                    </div>
                </form>
            }
        </div>

        <div class="report-body">
            @if (selectedAtorId == null)
            {
                <div class="report-empty-state">
                    <img src="~/images/MulherPlaceholder.webp" alt="Selecione um ator" />
                    <p>Primeiro selecione um ator.</p>
                </div>
            }
            else if (avaliacao != null)
            {
                <div class="chart-container-radar">
                    <canvas id="assessmentRadarChart"
                            data-points="@System.Text.Json.JsonSerializer.Serialize(new[] { avaliacao.CCrimes, avaliacao.Substancias, avaliacao.Moradia, avaliacao.Prevencao, avaliacao.AssBasica, avaliacao.Educacao, avaliacao.Saude, avaliacao.Ocupacao, avaliacao.Lazer })"
                            data-label="@avaliacao.DtCriacao.ToString("dd/MM/yyyy")"></canvas>
                </div>
            }
            else
            {
                <div class="report-empty-state"><p>Este ator ainda não possui avaliações pessoais.</p></div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
