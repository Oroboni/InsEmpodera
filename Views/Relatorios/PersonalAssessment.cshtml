@{
    ViewData["Title"] = "Relatório - Avaliações Pessoais";
    Layout = "_Layout";
    // A linha "DisableMainScroll" FOI REMOVIDA daqui para CORRIGIR a rolagem.
    
    // Pega o AtorId selecionado (enviado pelo Controller)
    int? selectedAtorId = ViewBag.SelectedAtorId; 
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/reports.css" />
}

<div class="report-page-container">
    <div class="report-breadcrumb">
    <h1>
        <a asp-controller="Report" asp-action="index">Relatórios</a> 
        > 
        <strong>Avaliações Pessoais</strong>
    </h1>
</div>

    <div class="report-content-box">
        <div class="report-filters">
            
            <form asp-action="PersonalAssessment" method="get" id="atorSelectForm">
                <div class="form-group">
                    <label>Ator</label>
                    <div class="select-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <select name="atorId" asp-items="ViewBag.AtorList" onchange="this.form.submit()">
                            <option value="">Selecione um Ator...</option>
                        </select>
                        <i class="fa-solid fa-chevron-down select-arrow"></i>
                    </div>
                </div>
            </form>

            @if (selectedAtorId != null)
            {
                <div class="form-group">
                    <label>Avaliações Pessoais</label>
                    <div class="select-wrapper">
                        <select><option>02/09/25</option></select>
                        <i class="fa-solid fa-chevron-down select-arrow"></i>
                    </div>
                </div>
            }
        </div>

        <div class="report-body">
            @if (selectedAtorId == null)
            {
                <div class="report-empty-state">
                    <img src="~/images/MulherPlaceholder.webp" alt="Selecione um ator" />
                    <p>Primeiro selecione um ator.</p>
                </div>
            }
            else
            {
                <div class="chart-container-radar">
                    <canvas id="assessmentRadarChart"></canvas>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js"></script>
}