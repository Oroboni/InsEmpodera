@model Empodera.Models.PersonalAssessmentReportViewModel
@using Empodera.Models
@{
    ViewData["Title"] = "Relatório - Avaliações Pessoais";
    ViewData["PageCSS"] = "homepage";
    Layout = "_Layout";
    var cores = PersonalAssessmentReportViewModel.Cores;
    var selecionadas = Model.Selecionadas.Select(a => a.IdAvaliacao).ToHashSet();
    // Cor de cada avaliação: a mesma da sua posição (da mais antiga para a mais recente) no gráfico e no PDF.
    var corPorAvaliacao = Model.Selecionadas.Select((a, i) => (a.IdAvaliacao, Cor: cores[i % cores.Length]))
        .ToDictionary(x => x.IdAvaliacao, x => x.Cor);
    var series = Model.Selecionadas.Select(a => new
    {
        label = a.DtCriacao.ToString("dd/MM/yyyy"),
        cor = corPorAvaliacao[a.IdAvaliacao],
        pontos = PersonalAssessmentReportViewModel.Valores(a)
    });
}
@section Styles {
    <partial name="_EstilosRelatorio" />
}

<div class="modern-container">
    <div class="header-section">
        <h2>
            <a asp-action="Index" class="text-primary">Relatórios</a>
            <span class="separator"> > </span>
            <strong class="text-muted">Avaliações Pessoais</strong>
        </h2>
    </div>

    <div class="relatorio-filtros">
        <form asp-action="PersonalAssessment" method="get" style="display:contents">
            <partial name="_CampoFiltro" model='new RelatorioCampoFiltro("comunidadeId", "Comunidade", "fa-city",
                (IEnumerable<SelectListItem>)ViewBag.Comunidades, "Todas as comunidades", EnviarAoMudar: true)' />
        </form>
        <form asp-action="PersonalAssessment" method="get" style="display:contents" id="atorSelectForm">
            <input type="hidden" name="comunidadeId" value="@Model.ComunidadeId" />
            <partial name="_CampoFiltro" model='new RelatorioCampoFiltro("atorId", "Ator", "fa-user",
                (IEnumerable<SelectListItem>)ViewBag.AtorList, "Selecione um ator...", EnviarAoMudar: true)' />
        </form>
    </div>

    @if (Model.AtorId == null)
    {
        <div class="no-records">
            <div class="no-records-icon"><i class="fas fa-user-check"></i></div>
            <h3>Selecione um ator</h3>
            <p>Use o filtro de comunidade para encontrar o ator mais rápido.</p>
        </div>
    }
    else if (Model.Selecionadas.Count == 0)
    {
        <div class="no-records">
            <div class="no-records-icon"><i class="fas fa-clipboard-list"></i></div>
            <h3>Sem avaliações</h3>
            <p>Este ator ainda não possui avaliações pessoais.</p>
        </div>
    }
    else
    {
        <form asp-action="PersonalAssessment" method="get" id="avaliacoesForm">
            <input type="hidden" name="comunidadeId" value="@Model.ComunidadeId" />
            <input type="hidden" name="atorId" value="@Model.AtorId" />
            <div class="relatorio-cabecalho-secao">
                <div class="section-label">Datas para comparar</div>
                <div class="relatorio-exportar">
                    <button type="submit" name="exportar" value="excel" class="btn-export" data-testid="assessment-export-excel"
                            aria-label="Exportar avaliações para Excel" title="Exportar avaliações para Excel">
                        <i class="fa-solid fa-file-excel" aria-hidden="true"></i>
                    </button>
                    <button type="submit" name="exportar" value="pdf" class="btn-export pdf" data-testid="assessment-export-pdf"
                            aria-label="Exportar avaliações em PDF" title="Exportar avaliações em PDF">
                        <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <p class="relatorio-grupo-descricao">Marque uma ou mais datas: cada avaliação aparece no gráfico com uma cor.</p>
            <div class="date-chips" data-testid="assessment-dates">
                @foreach (var item in Model.Avaliacoes)
                {
                    var marcada = selecionadas.Contains(item.IdAvaliacao);
                    var cor = marcada ? corPorAvaliacao[item.IdAvaliacao] : null;
                    <label class="date-chip" style="@(cor is null ? null : $"--chip-cor:{cor}")">
                        <input type="checkbox" name="avaliacaoIds" value="@item.IdAvaliacao" checked="@marcada" onchange="this.form.submit()" />
                        @if (cor is not null) { <span class="chip-cor" aria-hidden="true"></span> }
                        @item.DtCriacao.ToString("dd/MM/yyyy")
                    </label>
                }
            </div>
        </form>

        <div class="purple-divider"></div>
        <div class="section-label">Gráfico das avaliações</div>
        <div class="relatorio-painel">
            <div class="relatorio-grafico-radar">
                <canvas id="assessmentRadarChart" data-series="@System.Text.Json.JsonSerializer.Serialize(series)"></canvas>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
