@model Empodera.Models.FirstContactReportViewModel
@{
    ViewData["Title"] = "Relatório - Fichas de 1º Contato";
    ViewData["PageCSS"] = "reports";
    Layout = "_Layout";
    string DateValue(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/reports.css" asp-append-version="true" />
    <style>
        .report-summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.25rem; }
        .report-total { background:#f1eafa; color:#582192; padding:.6rem 1rem; border-radius:999px; font-weight:700; }
        .report-series { width:100%; display:grid; gap:.9rem; }
        .series-row { display:grid; grid-template-columns:minmax(150px, 240px) 1fr 92px; gap:1rem; align-items:center; }
        .series-track { height:24px; background:#eeeaf1; border-radius:999px; overflow:hidden; }
        .series-bar { height:100%; min-width:3px; background:linear-gradient(90deg,#6a2a94,#bd4c92); border-radius:inherit; }
        .series-value { text-align:right; font-weight:700; }
        .filter-actions { display:flex; gap:.75rem; align-items:end; }
        @@media (max-width:760px) { .series-row { grid-template-columns:1fr; gap:.35rem; } .series-value { text-align:left; } }
    </style>
}

<div class="report-page-container">
    <div class="report-breadcrumb">
        <h1><a asp-action="Index">Relatórios</a> &gt; <strong>Fichas de 1º Contato</strong></h1>
    </div>

    <div class="report-content-box">
        <form asp-action="FirstContact" method="get" class="report-filters" id="firstContactFilters">
            <div class="form-group">
                <label for="comunidadeId">Comunidade</label>
                <div class="select-wrapper">
                    <i class="fa-solid fa-city"></i>
                    <select id="comunidadeId" name="comunidadeId" asp-items="ViewBag.Comunidades" required>
                        <option value="">Selecione uma comunidade</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>

            @if (Model.ComunidadeId.HasValue)
            {
                <details class="filter-box" open>
                    <summary><span><i class="fa-solid fa-filter"></i> Filtros avançados</span><i class="fa-solid fa-chevron-down"></i></summary>
                    <div class="filter-grid">
                        <div class="form-group">
                            <label for="genero">Gênero</label>
                            <select id="genero" name="genero">
                                <option value="">Todos</option>
                                <option value="2" selected="@(Model.Genero == 2)">Feminino</option>
                                <option value="1" selected="@(Model.Genero == 1)">Masculino</option>
                                <option value="3" selected="@(Model.Genero == 3)">Transgênero</option>
                                <option value="0" selected="@(Model.Genero == 0)">Não declarado</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="estruturaFamiliar">Estrutura familiar</label>
                            <select id="estruturaFamiliar" name="estruturaFamiliar">
                                <option value="">Todas</option>
                                <option value="SemMatrimonio" selected="@(Model.EstruturaFamiliar == "SemMatrimonio")">Companheiro/a sem matrimônio</option>
                                <option value="FamiliaNuclear" selected="@(Model.EstruturaFamiliar == "FamiliaNuclear")">Família nuclear</option>
                                <option value="SemMatrimonioF" selected="@(Model.EstruturaFamiliar == "SemMatrimonioF")">Família sem matrimônio formal</option>
                                <option value="MoraCFilhos" selected="@(Model.EstruturaFamiliar == "MoraCFilhos")">Mora com filhos/as</option>
                                <option value="MoraSozinho" selected="@(Model.EstruturaFamiliar == "MoraSozinho")">Mora sozinho</option>
                                <option value="Outro" selected="@(Model.EstruturaFamiliar == "Outro")">Outro</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="condicao">Condição</label>
                            <input id="condicao" name="condicao" value="@Model.Condicao" placeholder="Ex.: Problemas de saúde" />
                        </div>
                        <div class="form-group">
                            <label for="resultado">Resultado</label>
                            <input id="resultado" name="resultado" value="@Model.Resultado" placeholder="Ex.: Seguiu contato" />
                        </div>
                        <div class="form-group">
                            <label for="resposta">Resposta</label>
                            <input id="resposta" name="resposta" value="@Model.Resposta" placeholder="Ex.: Encaminhamento" />
                        </div>
                        <div class="form-group">
                            <label for="horario">Horário</label>
                            <select id="horario" name="horario">
                                <option value="">Qualquer horário</option>
                                <option value="06_12" selected="@(Model.Horario == "06_12")">06:00 às 12:00</option>
                                <option value="12_20" selected="@(Model.Horario == "12_20")">12:01 às 20:00</option>
                                <option value="20_06" selected="@(Model.Horario == "20_06")">20:01 às 05:59</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="comoEstabeleceu">Como se estabeleceu</label>
                            <select id="comoEstabeleceu" name="comoEstabeleceu">
                                <option value="">Todos</option>
                                <option value="OutrasInstituicoes" selected="@(Model.ComoEstabeleceu == "OutrasInstituicoes")">Em outras instituições</option>
                                <option value="CasaDaPessoa" selected="@(Model.ComoEstabeleceu == "CasaDaPessoa")">Na casa da pessoa</option>
                                <option value="EstruturaOrganizacao" selected="@(Model.ComoEstabeleceu == "EstruturaOrganizacao")">Na estrutura da organização</option>
                                <option value="NaRua" selected="@(Model.ComoEstabeleceu == "NaRua")">Na rua</option>
                                <option value="Outro" selected="@(Model.ComoEstabeleceu == "Outro")">Outro</option>
                                <option value="PorTelefone" selected="@(Model.ComoEstabeleceu == "PorTelefone")">Por telefone</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="escolaridade">Escolaridade</label>
                            <select id="escolaridade" name="escolaridade">
                                <option value="">Todas</option>
                                <option value="sabe_calcular" selected="@(Model.Escolaridade == "sabe_calcular")">Sabe calcular</option>
                                <option value="sabe_ler_escrever" selected="@(Model.Escolaridade == "sabe_ler_escrever")">Sabe ler e escrever</option>
                                <option value="sabe_usar_computador" selected="@(Model.Escolaridade == "sabe_usar_computador")">Sabe usar computador</option>
                            </select>
                        </div>
                        <div class="form-group"><label for="dataDe">De</label><input id="dataDe" type="date" name="dataDe" value="@DateValue(Model.DataDe)" /></div>
                        <div class="form-group"><label for="dataAte">Até</label><input id="dataAte" type="date" name="dataAte" value="@DateValue(Model.DataAte)" /></div>
                    </div>
                </details>

                <div class="report-type-filters">
                    <div class="form-group">
                        <label for="campo">Agrupar por</label>
                        <select id="campo" name="campo">
                            <option value="status" selected="@(Model.Campo == "status")">Situação da ficha</option>
                            <option value="como_estabeleceu_contato" selected="@(Model.Campo == "como_estabeleceu_contato")">Como se estabeleceu o contato</option>
                            <option value="emprego" selected="@(Model.Campo == "emprego")">Emprego</option>
                            <option value="estado_familiar" selected="@(Model.Campo == "estado_familiar")">Estado familiar</option>
                            <option value="estrutura_familiar" selected="@(Model.Campo == "estrutura_familiar")">Estrutura familiar</option>
                            <option value="genero" selected="@(Model.Campo == "genero")">Gênero</option>
                            <option value="hora_primeiro_contato" selected="@(Model.Campo == "hora_primeiro_contato")">Hora do contato</option>
                            <option value="local_tratamento" selected="@(Model.Campo == "local_tratamento")">Local de tratamento</option>
                        </select>
                    </div>
                    <div class="filter-actions">
                        <a asp-action="FirstContact" asp-route-comunidadeId="@Model.ComunidadeId" class="btn btn-secondary">LIMPAR</a>
                        <button type="submit" class="btn btn-primary">APLICAR FILTROS</button>
                    </div>
                </div>
            }
            else
            {
                <button type="submit" class="btn btn-primary">CARREGAR RELATÓRIO</button>
            }
        </form>

        <div class="report-body">
            @if (!Model.ComunidadeId.HasValue)
            {
                <div class="report-empty-state"><i class="fa-solid fa-chart-pie" style="font-size:4rem;color:#9c75ca"></i><p>Primeiro selecione uma comunidade.</p></div>
            }
            else if (Model.Total == 0)
            {
                <div class="report-empty-state"><i class="fa-solid fa-filter-circle-xmark" style="font-size:4rem;color:#9c75ca"></i><p>Nenhuma ficha corresponde aos filtros escolhidos.</p></div>
            }
            else
            {
                <div class="report-summary"><h2>Distribuição das fichas</h2><span class="report-total">@Model.Total ficha(s)</span></div>
                <div class="report-series">
                    @foreach (var item in Model.Series)
                    {
                        <div class="series-row">
                            <strong>@item.Label</strong>
                            <div class="series-track" role="img" aria-label="@item.Label: @item.Value ficha(s), @item.Percentage%">
                                <div class="series-bar" style="width:@item.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                            <span class="series-value">@item.Value (@item.Percentage%)</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
