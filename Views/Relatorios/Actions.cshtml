@{
    ViewData["Title"] = "Relatório - Ações";
    ViewData["PageCSS"] = "reports";
    Layout = "_Layout";
    // A linha "DisableMainScroll" FOI REMOVIDA daqui para CORRIGIR a rolagem.
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/reports.css" />
    
    <style>
        /* CSS Local para alinhar as datas lado a lado */
        .date-row {
            display: flex;
            gap: 15px; /* Espaço entre os campos */
            width: 100%; /* Garante que o grupo ocupe a largura disponível */
        }
        
        /* Faz com que cada campo de data ocupe 50% do espaço */
        .date-row .form-group {
            flex: 1;
            margin-bottom: 0; /* Remove margem extra se houver */
        }
    </style>
}

<div class="report-page-container">
    <div class="report-breadcrumb">
    <h1>
        <a asp-controller="Report" asp-action="index">Relatórios</a> 
        > 
        <strong>Ações</strong>
    </h1>
</div>

    <div class="report-content-box">
        <div class="report-filters">
            <div class="form-group">
                <label>Comunidade</label>
                <div class="select-wrapper">
                    <i class="fa-solid fa-city"></i>
                    <select id="ComunidadeId" name="ComunidadeId" asp-items="ViewBag.Comunidades">
                        <option value="">Selecione...</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>
            <div class="form-group">
                <label>Ator</label>
                <div class="select-wrapper">
                    <i class="fa-solid fa-user"></i>
                    <select asp-items="ViewBag.AtorList"><option value="">Selecione...</option></select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>
            
            <!-- Agrupamento das Datas na mesma linha -->
            <div class="date-row">
                <div class="form-group">
                    <label>De (data)</label>
                    <div class="input-wrapper"><input type="date" /></div>
                </div>
                <div class="form-group">
                    <label>Até (data)</label>
                    <div class="input-wrapper"><input type="date" /></div>
                </div>
            </div>

        </div>

        <div class="report-body">
            <table class="matrix-table">
                <thead>
                    <tr>
                        <th>Eixos</th>
                        <th>Parceiro (0)</th>
                        <th>Equipe (0)</th>
                        <th>Instituído (0)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr> <td>Prevenção (0)</td> <td>0</td> <td>0</td> <td>0</td> </tr>
                    <tr> <td>Assistência Básica (0)</td> <td>0</td> <td>0</td> <td>0</td> </tr>
                    <tr> <td>Educação (0)</td> <td>0</td> <td>0</td> <td>0</td> </tr>
                    <tr> <td>Saúde (0)</td> <td>0</td> <td>0</td> <td>0</td> </tr>
                    <tr> <td>Ocupação (0)</td> <td>0</td> <td>0</td> <td>0</td> </tr>
                    <tr> <td>Lazer (0)</td> <td>0</td> <td>0</td> <td>0</td> </tr>
                    <tr> <td>(Exemplo) Cultura</td> <td>0</td> <td>0</td> <td>0</td> </tr>
                    <tr> <td>(Exemplo) Moradia</td> <td>0</td> <td>0</td> <td>0</td> </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js"></script>
}