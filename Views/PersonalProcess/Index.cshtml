@model IReadOnlyList<Empodera.Models.DiarioProcessoPessoal>
@{
    ViewData["Title"] = "Diário Pessoal";
    Layout = "_Layout";
    int? selectedAtorId = ViewBag.SelectedAtorId;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/atores.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css"/>
    <link rel="stylesheet" href="~/css/pages/personal-assessment.css" asp-append-version="true" />
    <style>
        .process-tags { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:.75rem; }
        .process-tag { padding:.25rem .65rem; border-radius:999px; background:#eee9ff; color:#56239b; font-size:.78rem; font-weight:600; }
        .empty-process { min-height:280px; display:grid; place-content:center; text-align:center; color:#676171; gap:.75rem; }
        .empty-process i { font-size:3.5rem; color:#9c75ca; }
    </style>
}

<div class="assessment-page-container">
    <div class="assessment-header">
        <div class="assessment-title"><h2>Diário de Processo Pessoal</h2></div>

        <form asp-action="Index" method="get" id="atorSelectForm">
            <div class="input-card full-width">
                <div class="icon-box">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div class="input-content">
                    <label for="atorId">Ator</label>

                    <select id="atorId" name="atorId" class="clean-input"
                            asp-items="ViewBag.AtorList" onchange="this.form.submit()">
                        <option value="">Selecione um ator</option>
                    </select>
                </div>
            </div>
        </form>

        @if (selectedAtorId.HasValue)
        {
            <div class="assessment-controls">
                <form class="search-bar" asp-action="Index" method="get">
                    <input type="hidden" name="atorId" value="@selectedAtorId" />
                    <input type="search" class="search-input" name="searchQuery"
                           placeholder="Buscar na descrição..." value="@ViewBag.SearchQuery" />
                    <button type="submit" class="search-icon-button" aria-label="Pesquisar diário">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    </button>
                </form>
                <a asp-action="Create" asp-route-atorId="@selectedAtorId" class="btn-add-assessment">
                    <i class="fa-solid fa-plus"></i> ADICIONAR
                </a>
            </div>
        }
    </div>

    <div class="assessment-content-area">
        @if (!selectedAtorId.HasValue)
        {
            <div class="empty-process">
                <i class="fa-solid fa-book-open-reader"></i>
                <strong>Selecione um ator para consultar seu diário pessoal.</strong>
            </div>
        }
        else if (Model.Count == 0)
        {
            <div class="empty-process">
                <i class="fa-regular fa-clipboard"></i>
                <strong>Nenhum registro encontrado para este ator.</strong>
                <span>Use o botão Adicionar para criar o primeiro.</span>
            </div>
        }
        else
        {
            <div class="assessment-list-container">
                @foreach (var item in Model)
                {
                    <div class="assessment-card">
                        <div class="assessment-card-info">
                            <h3>@item.Data.ToString("dd/MM/yyyy")</h3>
                            <p>@item.Descricao</p>
                            @if (item.Eixos.Count > 0)
                            {
                                <div class="process-tags">
                                    @foreach (var link in item.Eixos.OrderBy(e => e.Eixo.Nome))
                                    {
                                        <span class="process-tag">@link.Eixo.Nome</span>
                                    }
                                </div>
                            }
                        </div>
                        <a asp-action="Edit" asp-route-id="@item.IdDiarioProcesso" class="details-icon"
                           aria-label="Editar diário de @item.Data.ToString("dd/MM/yyyy")">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>
