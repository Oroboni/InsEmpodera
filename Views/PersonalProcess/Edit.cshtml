@model Empodera.Models.DiarioProcessoPessoal
@{
    ViewData["Title"] = "Editar Diário Pessoal";
    Layout = "_Layout";
    bool canDelete = ViewBag.CanDelete == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/diarioCampo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/personal-process.css" asp-append-version="true" />
}

<div class="modern-container">
    <div class="header-section">
        <h2>
            <a asp-action="Index" asp-route-atorId="@Model.FK_id_Atores" class="text-primary">Diário de Processo Pessoal</a>
            <span class="separator">&gt;</span>
            <strong class="text-muted">Detalhes do Registro</strong>
        </h2>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.IdDiarioProcesso" method="post" class="main-form" id="processForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdDiarioProcesso" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <partial name="_CamposDiario" />

        <div class="purple-divider"></div>
        <div class="section-label">Informações do Sistema</div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-calendar-plus"></i></div>
            <div class="input-content">
                <label>Criação</label>
                <div class="user-info-display">
                    <i class="fa-solid fa-user"></i>
                    <span class="user-name">@(Model.Usuario?.Nome ?? "—")</span>
                    <span class="user-date">@Model.DtCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-user-pen"></i></div>
            <div class="input-content">
                <label>Última atualização</label>
                <div class="user-info-display">
                    <i class="fa-solid fa-user"></i>
                    <span class="user-name">@(Model.UsuarioModificacao?.Nome ?? Model.Usuario?.Nome ?? "—")</span>
                    <span class="user-date">@Model.DtModificacao?.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <div class="buttons-container">
            <a asp-action="Index" asp-route-atorId="@Model.FK_id_Atores" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>
            <div class="action-buttons-group">
                <button type="button" class="wizard-btn btn-next" id="edit-save-btn">
                    <i class="fa-solid fa-edit"></i> Editar
                </button>
                @if (canDelete)
                {
                    <button type="button" class="wizard-btn btn-delete" id="openDeleteModalBtn">
                        <i class="fa-solid fa-trash"></i> Deletar
                    </button>
                }
            </div>
        </div>
    </form>
</div>

@if (canDelete)
{
    <div class="modal-overlay" id="deleteConfirmationModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
        <div class="modal-content">
            <div class="modal-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <h3 class="modal-title" id="deleteModalTitle">Confirmar Exclusão</h3>
            <p class="modal-text">
                Você tem certeza que deseja deletar o registro de <strong>@Model.Data.ToString("dd/MM/yyyy")</strong>?<br>
                Essa ação não pode ser desfeita.
            </p>
            <div class="modal-actions">
                <button type="button" class="wizard-btn btn-prev" id="cancelDeleteBtn">Cancelar</button>
                <form asp-action="Delete" asp-route-id="@Model.IdDiarioProcesso" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-modal-confirm wizard-btn btn-next">Sim, Deletar</button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script type="application/json" id="actor-mention-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MentionActors))</script>
    <script src="~/js/personal-process-mentions.js" asp-append-version="true"></script>
    <script src="~/js/axis-picker.js" asp-append-version="true"></script>
    <script>
        // Mesmo comportamento das demais telas de detalhes: abre em visualização e libera os campos em "Editar".
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('processForm');
            const campos = form.querySelectorAll('.clean-input, input[name="eixosIds"]');
            const seletorEixos = form.querySelector('.multiselect-wrapper');
            const btn = document.getElementById('edit-save-btn');
            const temErro = form.querySelector('.validation-summary-errors, .field-validation-error');
            let editando = false;

            function aplicarEstado() {
                campos.forEach(c => c.disabled = !editando);
                form.classList.toggle('modo-visualizacao', !editando);
                if (seletorEixos) {
                    seletorEixos.classList.toggle('is-disabled', !editando);
                    if (!editando) seletorEixos.open = false;
                }
                btn.innerHTML = editando
                    ? '<i class="fa-solid fa-check"></i> Salvar Alterações'
                    : '<i class="fa-solid fa-edit"></i> Editar';
                btn.classList.toggle('btn-save-final', editando);
                btn.classList.toggle('btn-next', !editando);
            }

            seletorEixos?.querySelector('summary')?.addEventListener('click', e => { if (!editando) e.preventDefault(); });

            btn.addEventListener('click', function () {
                if (!editando) {
                    editando = true;
                    aplicarEstado();
                    form.querySelector('textarea')?.focus();
                    return;
                }
                if (form.reportValidity()) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Salvando...';
                    form.submit();
                }
            });

            // Se o servidor devolveu erro de validação, volta direto em modo de edição.
            editando = !!temErro;
            aplicarEstado();

            const modal = document.getElementById('deleteConfirmationModal');
            if (modal) {
                const fecharModal = () => modal.classList.remove('active');
                document.getElementById('openDeleteModalBtn').addEventListener('click', () => modal.classList.add('active'));
                document.getElementById('cancelDeleteBtn').addEventListener('click', fecharModal);
                modal.addEventListener('click', e => { if (e.target === modal) fecharModal(); });
                document.addEventListener('keydown', e => { if (e.key === 'Escape') fecharModal(); });
            }
        });
    </script>
}
