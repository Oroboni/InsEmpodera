@model Empodera.Models.DiarioProcessoPessoal
@using Empodera.Models
@{
    ViewData["Title"] = "Editar Diário Pessoal";
    Layout = "_Layout";
    var selectedEixos = (HashSet<int>)(ViewBag.SelectedEixos ?? new HashSet<int>());
    bool canDelete = ViewBag.CanDelete == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/activity-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/personal-process.css" asp-append-version="true" />
}

<div class="container">
    <div class="breadcrumb">
        <h1><a asp-action="Index" asp-route-atorId="@Model.FK_id_Atores">Diário de Processo Pessoal</a> &gt; <strong>Editar</strong></h1>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.IdDiarioProcesso" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdDiarioProcesso" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="form-group">
            <label asp-for="FK_id_Atores">Ator <span class="text-danger">*</span></label>
            <div class="select-wrapper">
                <i class="fa-solid fa-user"></i>
                <select asp-for="FK_id_Atores" class="form-control" asp-items="ViewBag.AtorList" required></select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
            </div>
            <span asp-validation-for="FK_id_Atores" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Data">Data <span class="text-danger">*</span></label>
            <div class="input-wrapper">
                <i class="fa-solid fa-calendar-day"></i>
                <input asp-for="Data" type="date" required />
            </div>
            <span asp-validation-for="Data" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Eixos</label>
            <details class="multiselect-wrapper">
                <summary>
                    <div class="select-wrapper">
                        <i class="fa-solid fa-tags"></i>
                        <span>Selecione os eixos</span>
                        <i class="fa-solid fa-chevron-down select-arrow"></i>
                    </div>
                </summary>
                <div class="multiselect-panel">
                    <ul>
                        @foreach (var eixo in (IEnumerable<Eixo>)ViewBag.EixosList)
                        {
                            <li>
                                <input type="checkbox" name="eixosIds" value="@eixo.IdEixo" id="eixo-@eixo.IdEixo"
                                       checked="@selectedEixos.Contains(eixo.IdEixo)" />
                                <label for="eixo-@eixo.IdEixo">@eixo.Nome</label>
                            </li>
                        }
                    </ul>
                </div>
            </details>
        </div>

        <div class="form-group">
            <label asp-for="Descricao">Descrição <span class="text-danger">*</span></label>
            <div class="input-wrapper">
                <i class="fa-solid fa-align-left" style="top:15px;transform:none"></i>
                <textarea asp-for="Descricao" maxlength="4000" required></textarea>
            </div>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="form-footer">
            <span>Criado em <strong>@Model.DtCriacao.ToString("dd/MM/yyyy HH:mm")</strong></span>
            <span>Atualizado em <strong>@Model.DtModificacao.ToString("dd/MM/yyyy HH:mm")</strong></span>
        </div>

        <div class="form-buttons">
            @if (canDelete)
            {
                <button type="submit" form="deletePersonalProcessForm" class="btn btn-delete">DELETAR</button>
            }
            <a asp-action="Index" asp-route-atorId="@Model.FK_id_Atores" class="btn btn-secondary">VOLTAR</a>
            <button type="submit" class="btn btn-primary">SALVAR ALTERAÇÕES</button>
        </div>
    </form>

    @if (canDelete)
    {
        <form id="deletePersonalProcessForm" asp-action="Delete" asp-route-id="@Model.IdDiarioProcesso" method="post"
              onsubmit="return confirm('Deseja realmente excluir este registro?');">
            @Html.AntiForgeryToken()
        </form>
    }
</div>
