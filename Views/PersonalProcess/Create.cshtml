@model Empodera.Models.DiarioProcessoPessoal
@{
    ViewData["Title"] = "Adicionar Diário Pessoal";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/diarioCampo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/personal-process.css" asp-append-version="true" />
}

<div class="modern-container">
    <div class="header-section">
        <h2>
            <a asp-action="Index" asp-route-atorId="@(Model.FK_id_Atores == Guid.Empty ? null : Model.FK_id_Atores)" class="text-primary">Diário de Processo Pessoal</a>
            <span class="separator">&gt;</span>
            <strong class="text-muted">Novo Registro</strong>
        </h2>
    </div>

    <form asp-action="Create" method="post" class="main-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <partial name="_CamposDiario" />

        <div class="buttons-container">
            <a asp-action="Index" asp-route-atorId="@(Model.FK_id_Atores == Guid.Empty ? null : Model.FK_id_Atores)" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="wizard-btn btn-next">
                <i class="fa-solid fa-check"></i> Adicionar Registro
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script type="application/json" id="actor-mention-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MentionActors))</script>
    <script src="~/js/personal-process-mentions.js" asp-append-version="true"></script>
    <script src="~/js/axis-picker.js" asp-append-version="true"></script>
}
