@{
    ViewData["Title"] = "HomePage";
    ViewData["PageCSS"] = "homepage"; 
    Layout = "_Layout"; 
    var comunidade = ViewBag.Comunidade as List<Empodera.Models.Comunidade>;
    var ator = ViewBag.Atores as List<Empodera.Models.Atores>;
}

<div class="header">
    <img src="@Url.Content("~/images/logo-empodera.svg")" alt="Logo">
    <div class="text-box">
        <h1 id="sistema-text">sistema</h1>
        <h1 id="lacos-text">laços</h1>
    </div>
</div>

<div class="cards-container">
    <div class="card">
        <h2>@(comunidade?.Count ?? 0)</h2>
        <p>Comunidades</p>
        <a asp-controller="Comunidade" asp-action="Index">Visualizar</a>
    </div>
    <div class="card">
        <h2>@(ator?.Count ?? 0)</h2>
        <p>Atores</p>
        <a asp-controller="Atores" asp-action="Index">Visualizar</a>
    </div>
    <div class="card">
        <h2>@(ViewBag.Usuarios?.Count ?? 0)</h2>
        <p>Usuários</p>
        <a asp-controller="Users" asp-action="Index">Visualizar</a>
    </div>
</div>
