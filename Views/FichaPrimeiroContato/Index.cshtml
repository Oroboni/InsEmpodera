@model IEnumerable<Empodera.Models.FichaPrimeiroContato>
@using Empodera.Models
@{
    ViewData["Title"] = "Ficha de Primeiro Contato";
    ViewData["PageCSS"] = "fichaprimeirocontato";
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
}

<div class="forms-container">
    <h2 class="page-title">Ficha de Primeiro Contato</h2>

    <div class="filter-bar">
        <form asp-action="Index" method="get" id="filterForm">
            <div class="main-select-wrapper">
                <select class="main-select" name="comunidade" id="comunidadeFilter" onchange="submitFilter()">
                    <option value="">Todas as Comunidades</option>
                    @foreach (var item in ViewBag.Comunidades)
                    {
                        var isSelected = item.Value == ViewData["CurrentComunidade"]?.ToString();
                        <option value="@item.Value" selected="@isSelected">@item.Text</option>
                    }
                </select>
            </div>

            <div class="bottom-filters">
                <div class="search-container">
                    <div class="search-input-group">
                        <div class="search-wrapper">
                            <input type="search" 
                                   class="search-input" 
                                   name="search" 
                                   value="@ViewData["CurrentFilter"]"
                                   placeholder="Procure pelo nome do ator" 
                                   id="searchInput" />
                            <button type="submit" class="btn-search">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>

                        <div class="select-wrapper secondary-select-wrapper">
                            <select class="secondary-select" name="status" id="statusFilter" onchange="submitFilter()">
                                <option value="">Todos os Status</option>
                                <option value="EmProgresso"
                                    selected="@(ViewData["CurrentStatus"]?.ToString() == "EmProgresso")">
                                    Em progresso
                                </option>
                                <option value="Concluida"
                                    selected="@(ViewData["CurrentStatus"]?.ToString() == "Concluida")">
                                    Concluídas
                                </option>
                                <option value="Abandonada"
                                    selected="@(ViewData["CurrentStatus"]?.ToString() == "Abandonada")">
                                    Abandonadas
                                </option>
                            </select>
                        </div>
                    </div>

                    <a class="btn-add" asp-action="Create" title="Adicionar Nova Ficha">
                        <i class="fa fa-plus"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="forms-list" id="fichasContainer">
        @if (Model != null && Model.Any())
        {
            @foreach (var form in Model)
            {
                bool isFinalized = form.Status != StatusFicha.EmProgresso;
                var nomeAtor = form.Ator?.Nome?.ToLower() ?? "";
                <div class="form-item" data-search="@nomeAtor">
                    <div class="form-info">
                        <p class="name">@form.Ator?.Nome</p>

                        <!-- Exibir comunidades associadas -->
                        @if (form.FichaComunidades != null && form.FichaComunidades.Any())
                        {
                            <p class="community">
                                @{
                                    var comunidades = form.FichaComunidades.Take(2).ToList();
                                    for (int i = 0; i < comunidades.Count; i++)
                                    {
                                        <span class="community-tag">@comunidades[i].Comunidade.Nome</span>
                                        @if (i < comunidades.Count - 1)
                                        {
                                            <span>, </span>
                                        }
                                    }
                                    @if (form.FichaComunidades.Count > 2)
                                    {
                                        <span>...</span>
                                    }
                                }
                            </p>
                        }

                        <div class="form-status">
                            <p class="date">@form.DtContato.ToString("dd/MM/yyyy")</p>

                            @if (form.Status == StatusFicha.Concluida)
                            {
                                <span class="tag-item tag-green">Concluída</span>
                            }
                            else if (form.Status == StatusFicha.Abandonada)
                            {
                                <span class="tag-item tag-red">Abandonada</span>
                            }
                            else if (form.Status == StatusFicha.EmProgresso)
                            {
                                <span class="tag-item tag-yellow">Em Progresso</span>
                            }
                        </div>
                    </div>

                    <div class="actions">
                        <button type="button" 
                                class="btn-action btn-concluir @(isFinalized ? "gray" : "")"
                                data-id="@form.IdFicha"
                                data-nome="@form.Ator?.Nome" 
                                title="Concluir" 
                                @(isFinalized ? "disabled" : "")>
                            <i class="fa fa-check"></i>
                        </button>

                        <button type="button" 
                                class="btn-action btn-abandonar @(isFinalized ? "gray" : "")"
                                data-id="@form.IdFicha"
                                data-nome="@form.Ator?.Nome"
                                title="Abandonar" 
                                @(isFinalized ? "disabled" : "")>
                            <i class="fa fa-times"></i>
                        </button>

                        <a asp-action="Edit" 
                           asp-route-id="@form.IdFicha" 
                           class="btn-action" 
                           title="Detalhes">
                            <i class="fa fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="no-records">Nenhuma ficha encontrada.</p>
        }
    </div>

    <!-- Modal de Concluir Ficha -->
    <div class="modal-overlay" id="modalConcluir">
        <div class="modal-content">
            <div class="modal-icon">
                <i class="fas fa-check-circle" style="color: #28a745;"></i>
            </div>

            <h3 class="modal-title">Concluir Ficha</h3>

            <p class="modal-text">
                Você realmente deseja marcar a ficha de <strong id="nomeAtorConcluir"></strong> como concluída?
            </p>

            <div class="button-container">
                <div class="modal-actions">
                    <button type="button" 
                            class="btn-modal-cancel wizard-btn btn-prev" 
                            onclick="closeModal('modalConcluir')">
                        Cancelar
                    </button>

                    <form id="formConcluir" method="post" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" 
                                class="btn-modal-confirm wizard-btn btn-next"
                                style="background-color: #28a745 !important;">
                            Sim, Concluir
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Abandonar Ficha -->
    <div class="modal-overlay" id="modalAbandonar">
        <div class="modal-content">
            <div class="modal-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>

            <h3 class="modal-title">Abandonar Ficha</h3>

            <p class="modal-text">
                Você realmente deseja abandonar a ficha de <strong id="nomeAtorAbandonar"></strong>?<br>
                Esta ação pode ser revertida posteriormente.
            </p>

            <div class="button-container">
                <div class="modal-actions">
                    <button type="button" 
                            class="btn-modal-cancel wizard-btn btn-prev" 
                            onclick="closeModal('modalAbandonar')">
                        Cancelar
                    </button>

                    <form id="formAbandonar" method="post" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" 
                                class="btn-modal-confirm wizard-btn btn-next">
                            Sim, Abandonar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Variáveis globais dos modais
    const modalConcluir = document.getElementById('modalConcluir');
    const modalAbandonar = document.getElementById('modalAbandonar');
    const formConcluir = document.getElementById('formConcluir');
    const formAbandonar = document.getElementById('formAbandonar');
    const nomeAtorConcluir = document.getElementById('nomeAtorConcluir');
    const nomeAtorAbandonar = document.getElementById('nomeAtorAbandonar');

    // Função para abrir modal
    function openModal(modalId) {
        const modal = document.getElementById(modalId);
        modal.style.display = 'flex';
        setTimeout(() => {
            modal.classList.add('active');
        }, 10);
    }

    // Função para fechar modal (global para ser chamada inline)
    window.closeModal = function(modalId) {
        const modal = document.getElementById(modalId);
        modal.classList.remove('active');
        setTimeout(() => {
            modal.style.display = 'none';
        }, 300);
    };

    // Botões de concluir
    document.querySelectorAll('.btn-concluir').forEach(btn => {
        btn.addEventListener('click', function() {
            if (this.disabled) return;
            
            const fichaId = this.dataset.id;
            const nomeAtor = this.dataset.nome || 'este ator';
            
            nomeAtorConcluir.textContent = nomeAtor;
            formConcluir.action = `/FichaPrimeiroContato/Concluir/${fichaId}`;
            openModal('modalConcluir');
        });
    });

    // Botões de abandonar
    document.querySelectorAll('.btn-abandonar').forEach(btn => {
        btn.addEventListener('click', function() {
            if (this.disabled) return;
            
            const fichaId = this.dataset.id;
            const nomeAtor = this.dataset.nome || 'este ator';
            
            nomeAtorAbandonar.textContent = nomeAtor;
            formAbandonar.action = `/FichaPrimeiroContato/Abandonar/${fichaId}`;
            openModal('modalAbandonar');
        });
    });

    // Fechar modal ao clicar fora
    window.addEventListener('click', function(e) {
        if (e.target === modalConcluir) {
            closeModal('modalConcluir');
        }
        if (e.target === modalAbandonar) {
            closeModal('modalAbandonar');
        }
    });

    // Fechar modal com ESC
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (modalConcluir.classList.contains('active')) {
                closeModal('modalConcluir');
            }
            if (modalAbandonar.classList.contains('active')) {
                closeModal('modalAbandonar');
            }
        }
    });

    // Função de filtro (se existir)
    window.submitFilter = function() {
        document.getElementById('filterForm').submit();
    };
});
</script>

@section Scripts {
    <script src="~/js/fichaprimeirocontato.js"></script>
    <script src="~/js/site.js"></script>
}