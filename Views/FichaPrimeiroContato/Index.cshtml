@model IEnumerable<Empodera.Models.FichaPrimeiroContato>
@using Empodera.Models
@{
    ViewData["Title"] = "Ficha de Primeiro Contato";
    ViewData["PageCSS"] = "fichaprimeirocontato";
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "_Layout";
}

<div class="forms-container">
    <h2 class="page-title">Ficha de Primeiro Contato</h2>

    <div class="filter-bar">
        <div class="main-select-wrapper">
            <select class="main-select" asp-items="ViewBag.Comunidades">
            </select>
        </div>

        <div class="bottom-filters">
            <div class="search-container">
                <div class="search-input-group">
                    <div class="search-wrapper">
                        <form asp-action="Index" method="get">
                            <input type="text" name="search" value="@ViewData["CurrentFilter"]"
                                placeholder="Procure por comunidades" />
                            <button type="submit" class="btn-search">
                                <i class="fa fa-search"></i>
                            </button>
                        </form>
                    </div>

                    <div class="select-wrapper secondary-select-wrapper">
                        <select class="secondary-select">
                            <option>Todos</option>
                            <option>Em progresso</option>
                            <option>Concluídas</option>
                            <option>Abandonadas</option>
                        </select>
                    </div>
                </div>

                <a class="btn-add" asp-action="Create" title="Adicionar Nova Ficha">
                    <i class="fa fa-plus"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="forms-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var form in Model)
            {
                <!-- Lógica para verificar se a ficha já foi finalizada -->
                <!-- Se NÃO for EmProgresso, considera-se finalizada (Concluída ou Abandonada) -->
                {
                    bool isFinalized = form.Status != StatusFicha.EmProgresso;
                }

                <div class="form-item">
                    <div class="form-info">
                        <p class="name">@form.Ator.Nome</p>
                        <p class="date">@form.DtContato.ToString("dd/MM/yyyy")</p>

                        <!-- Opcional: Mostrar um texto indicando o status atual para o usuário -->
                        @if (form.Status == StatusFicha.Concluida)
                        {
                            <span class="badge-status status-concluida">Concluída</span>
                        }
                        else if (form.Status == StatusFicha.Abandonada)
                        {
                            <span class="badge-status status-abandonada">Abandonada</span>
                        }
                    </div>

                    <div class="actions">

                        <!-- BOTÃO CONCLUIR -->
                        <!-- Adiciona classe 'gray' e atributo 'disabled' se já estiver finalizada -->
                        <button type="button" class="btn-action btn-concluir (isFinalized ? "gray" : "")"
                            data-id="@form.IdFicha" title="Concluir" (isFinalized ? "disabled" : "")>
                            <i class="fa fa-check"></i>
                        </button>

                        <!-- BOTÃO ABANDONAR -->
                        <!-- Adiciona classe 'gray' e atributo 'disabled' se já estiver finalizada -->
                        <button type="button" class="btn-action btn-abandonar (isFinalized ? "gray" : "")"
                            data-id="@form.IdFicha" title="Abandonar" (isFinalized ? "disabled" : "")>
                            <i class="fa fa-times"></i>
                        </button>

                        <!-- BOTÃO DETALHES (Sempre disponível) -->
                        <a asp-action="Details" asp-route-id="@form.IdFicha" class="btn-action btn-eye" title="Detalhes">
                            <i class="fa fa-eye"></i>
                        </a>

                    </div>
                </div>
            }
        }
        else
        {
            <p class="no-records">Nenhuma ficha encontrada.</p>
        }
    </div>

    <!-- ========================================== -->
    <!-- MODAIS (FORA DO LOOP - MANTENHA AQUI) -->
    <!-- ========================================== -->
    <div id="modalConcluir" class="custom-modal" style="display:none;">
        <div class="modal-content">
            <h3>Completar ficha</h3>
            <p>Você realmente deseja completar essa ficha?</p>
            <form id="formConcluir" method="post">
                <button type="radio-option" class="btn-cancel">Cancelar</button>
                <button type="submit" class="btn-confirm">Sim</button>
            </form>
        </div>
    </div>

    <div id="modalAbandonar" class="custom-modal" style="display:none;">
        <div class="modal-content">
            <h3>Abandonar ficha</h3>
            <p>Você realmente deseja abandonar esta ficha?</p>
            <form id="formAbandonar" method="post">
                <button type="button" class="btn-cancel">Cancelar</button>
                <button type="submit" class="btn-confirm">Sim</button>
            </form>
        </div>
    </div>

    <!-- SCRIPT ATUALIZADO -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Botão Concluir
            document.querySelectorAll(".btn-concluir").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    // Bloqueio extra via JS: Se tiver a classe gray ou atributo disabled, não faz nada
                    if (this.classList.contains("gray") || this.hasAttribute("disabled")) {
                        e.preventDefault();
                        return;
                    }

                    const id = this.getAttribute("data-id");
                    const form = document.getElementById("formConcluir");
                    form.action = "/FichaPrimeiroContato/Concluir/" + id;
                    document.getElementById("modalConcluir").style.display = "flex";
                });
            });

            // Botão Abandonar
            document.querySelectorAll(".btn-abandonar").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    if (this.classList.contains("gray") || this.hasAttribute("disabled")) {
                        e.preventDefault();
                        return;
                    }

                    const id = this.getAttribute("data-id");
                    const form = document.getElementById("formAbandonar");
                    form.action = "/FichaPrimeiroContato/Abandonar/" + id;
                    document.getElementById("modalAbandonar").style.display = "flex";
                });
            });

            // Botão Cancelar (fecha modais)
            document.querySelectorAll(".btn-cancel").forEach(btn => {
                btn.addEventListener("click", () => {
                    document.querySelectorAll(".custom-modal").forEach(m => m.style.display = "none");
                });
            });

            // Fechar ao clicar fora
            window.onclick = function (event) {
                if (event.target.classList.contains('custom-modal')) {
                    event.target.style.display = "none";
                }
            }
        });
    </script>
</div>