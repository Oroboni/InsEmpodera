@model List<Empodera.Models.ComunidadeDto>
@{
    ViewData["Title"] = "Comunidades";
    Layout = "_Layout";
    ViewData["PageCSS"] = "homepage";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css"/>
}

<div class="modern-container">
    <!-- Header -->
    <div class="header-section">
        <h2>
            <strong class="text-primary">Comunidades</strong>
        </h2>
    </div>

    <!-- Barra de Busca -->
    <div class="search-container">
        <div class="search-input-group">
            <div class="search-wrapper">
                <input type="search" id="searchInput" placeholder="Buscar por comunidades..."
                    aria-label="Buscar comunidades" value="@(ViewData["CurrentFilter"])" />
                <button type="button" class="btn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>

        <button type="button" class="btn-add" 
            onclick="window.location.href='@Url.Action("ComunidadesDetalhes", "Comunidade", new { id = 0 })'"
            title="Adicionar Nova Comunidade">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Estatísticas -->
        <div class="section-label">Resumo</div>
        <div class="actions-grid">
            <div class="action-card stats-card">
                <span class="card-title">@Model.Count()</span>
                <span class="card-subtitle">Total de Comunidades</span>
                <div class="card-icons">
                    <i class="fas fa-home"></i>
                </div>
            </div>

            @{
                var emProcesso = Model.Count(c => c.Status == "Diagnosticado");
            }
            <div class="action-card stats-card stats-card-green">
                <span class="card-title">@emProcesso</span>
                <span class="card-subtitle">Diagnosticado</span>
                <div class="card-icons">
                    <i class="fas fa-spinner"></i>
                </div>
            </div>

            @{
                var aguardando = Model.Count(c => c.Status != "Diagnosticado");
            }
            <div class="action-card stats-card stats-card-cyan">
                <span class="card-title">@aguardando</span>
                <span class="card-subtitle">Aguardando Início</span>
                <div class="card-icons">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>

        <!-- Lista de Comunidades -->
        <div class="purple-divider"></div>
        <div class="section-label">Todas as Comunidades</div>

        <div class="forms-list" id="comunidadesGrid">
            @foreach (var comunidade in Model)
            {
                var isEmProcesso = comunidade.Status == "Diagnosticado";
                
                <div class="form-item comunidade-item" data-nome="@comunidade.Nome?.ToLower()">
                    <div class="form-info">
                        <div class="item-header">
                            <div class="activity-icon activity-icon-purple">
                                <i class="fas fa-home"></i>
                            </div>
                            <div class="item-content">
                                <p class="name item-name">@comunidade.Nome</p>
                                
                                <div class="tag-list">
                                    @if (isEmProcesso)
                                    {
                                        <span class="tag-item tag-green">
                                            <i class="fas fa-spinner"></i>
                                            Diagnosticado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tag-item tag-yellow">
                                            <i class="fas fa-clock"></i>
                                            @comunidade.Status
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        @if (isEmProcesso)
                        {
                            <button class="btn-action btn-disabled" 
                                    disabled 
                                    title="Comunidade Diagnosticado">
                                <i class="fa-solid fa-play" style="color: var(--color-gray-500);"></i>
                            </button>
                        }
                        else
                        {
                            <a class="btn-action btn-action-green" 
                               asp-controller="Comunidade" 
                               asp-action="Processo" 
                               asp-route-id="@comunidade.Id"
                               title="Iniciar Processo">
                                <i class="fa-solid fa-play"></i>
                            </a>
                        }

                        <a class="btn-action" 
                           asp-controller="Comunidade" 
                           asp-action="ComunidadesDetalhes" 
                           asp-route-id="@comunidade.Id"
                           title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Nenhuma comunidade cadastrada -->
        <div class="no-records">
            <div class="no-records-icon">
                <i class="fas fa-home"></i>
            </div>
            <h3>Nenhuma comunidade cadastrada</h3>
            <p>Comece adicionando a primeira comunidade ao sistema.</p>
            <button type="button" class="btn-save" 
                onclick="window.location.href='@Url.Action("ComunidadesDetalhes", "Comunidade", new { id = 0 })'">
                <i class="fa-solid fa-plus"></i> Adicionar Primeira Comunidade
            </button>
        </div>
    }

    <!-- Mensagem quando nenhum resultado for encontrado -->
    <div class="no-records" id="noResultsMessage" style="display: none;">
        <div class="no-records-icon">
            <i class="fas fa-search"></i>
        </div>
        <h3>Nenhuma comunidade encontrada</h3>
        <p>Tente ajustar os termos de busca.</p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const comunidadesGrid = document.getElementById('comunidadesGrid');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const comunidadeItems = document.querySelectorAll('.comunidade-item');

            function filterComunidades() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                comunidadeItems.forEach(item => {
                    const nome = item.getAttribute('data-nome') || '';
                    const matchesSearch = nome.includes(searchTerm);

                    if (matchesSearch) {
                        item.style.display = 'flex';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if (visibleCount === 0 && comunidadeItems.length > 0) {
                    if (comunidadesGrid) comunidadesGrid.style.display = 'none';
                    if (noResultsMessage) noResultsMessage.style.display = 'block';
                } else {
                    if (comunidadesGrid) comunidadesGrid.style.display = 'flex';
                    if (noResultsMessage) noResultsMessage.style.display = 'none';
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', filterComunidades);

                searchInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        filterComunidades();
                    }
                });
            }
        });
    </script>
}