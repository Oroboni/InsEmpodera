@model List<Empodera.Models.ComunidadeDto>
@{
    ViewData["Title"] = "Comunidades";
    Layout = "_Layout";
    ViewData["PageCSS"] = "homepage";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/comunidadesDetalhes.css" />
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css"/>
}

<div class="modern-container">
    <!-- Header -->
    <div class="header-section">
        <h2>
            <strong class="text-primary">Comunidades</strong>
        </h2>
    </div>

    <!-- Barra de Busca -->
    <div class="search-container">
        <div class="search-input-group">
            <div class="search-wrapper">
                <input type="search" id="searchInput" placeholder="Buscar por comunidades..."
                    aria-label="Buscar comunidades" value="@(ViewData["CurrentFilter"])" />
                <button type="button" class="btn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>

        <button type="button" class="btn-add" 
            onclick="window.location.href='@Url.Action("ComunidadesDetalhes", "Comunidade", new { id = 0 })'"
            title="Adicionar Nova Comunidade">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Estatísticas -->
        <div class="section-label">Resumo</div>
        <div class="actions-grid">
            <div class="action-card stats-card">
                <span class="card-title" style="font-size: var(--font-size-4xl);">@Model.Count()</span>
                <span class="card-subtitle">Total de Comunidades</span>
                <div class="card-icons">
                    <i class="fas fa-home"></i>
                </div>
            </div>

            @{
                var emProcesso = Model.Count(c => c.Status == "Em Processo");
            }
            <div class="action-card stats-card" style="background: linear-gradient(135deg, #28a745 0%, #218838 100%);">
                <span class="card-title" style="font-size: var(--font-size-4xl);">@emProcesso</span>
                <span class="card-subtitle">Em Processo</span>
                <div class="card-icons">
                    <i class="fas fa-spinner"></i>
                </div>
            </div>

            @{
                var aguardando = Model.Count(c => c.Status != "Em Processo");
            }
            <div class="action-card stats-card" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);">
                <span class="card-title" style="font-size: var(--font-size-4xl);">@aguardando</span>
                <span class="card-subtitle">Aguardando Início</span>
                <div class="card-icons">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>

        <!-- Lista de Comunidades -->
        <div class="purple-divider"></div>
        <div class="section-label">Todas as Comunidades</div>

        <div class="forms-list" id="comunidadesGrid">
            @foreach (var comunidade in Model)
            {
                var isEmProcesso = comunidade.Status == "Em Processo";
                
                <div class="form-item comunidade-item" data-nome="@comunidade.Nome?.ToLower()">
                    <div class="form-info" style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
                            <div class="activity-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                <i class="fas fa-home"></i>
                            </div>
                            <div style="flex: 1;">
                                <p class="name" style="margin: 0;">@comunidade.Nome</p>
                                
                                <div class="tag-list" style="margin-top: 0.5rem;">
                                    @if (isEmProcesso)
                                    {
                                        <span class="tag-item tag-green">
                                            <i class="fas fa-spinner"></i>
                                            Em Processo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tag-item tag-yellow">
                                            <i class="fas fa-clock"></i>
                                            @comunidade.Status
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        @if (isEmProcesso)
                        {
                            <button class="btn-action" 
                                    disabled 
                                    title="Comunidade em Processo"
                                    style="opacity: 0.5; cursor: not-allowed;">
                                <i class="fa-solid fa-play" style="color: var(--color-gray-500);"></i>
                            </button>
                        }
                        else
                        {
                            <a class="btn-action" 
                               asp-controller="Comunidade" 
                               asp-action="Processo" 
                               asp-route-id="@comunidade.Id"
                               title="Iniciar Processo"
                               style="background-color: #28a745;">
                                <i class="fa-solid fa-play" style="color: white;"></i>
                            </a>
                        }

                        <a class="btn-action" 
                           asp-controller="Comunidade" 
                           asp-action="ComunidadesDetalhes" 
                           asp-route-id="@comunidade.Id"
                           title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Nenhuma comunidade cadastrada -->
        <div class="no-records" style="padding: 3rem; text-align: center;">
            <div style="margin-bottom: 1.5rem;">
                <i class="fas fa-home" style="font-size: 4rem; color: var(--color-gray-400);"></i>
            </div>
            <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Nenhuma comunidade cadastrada</h3>
            <p style="color: var(--color-gray-500); margin-bottom: 1.5rem;">
                Comece adicionando a primeira comunidade ao sistema.
            </p>
            <button type="button" class="btn-save" 
                onclick="window.location.href='@Url.Action("ComunidadesDetalhes", "Comunidade", new { id = 0 })'">
                <i class="fa-solid fa-plus"></i> Adicionar Primeira Comunidade
            </button>
        </div>
    }

    <!-- Mensagem quando nenhum resultado for encontrado -->
    <div class="no-records" id="noResultsMessage" style="display: none; padding: 3rem; text-align: center;">
        <div style="margin-bottom: 1.5rem;">
            <i class="fas fa-search" style="font-size: 4rem; color: var(--color-gray-400);"></i>
        </div>
        <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Nenhuma comunidade encontrada</h3>
        <p style="color: var(--color-gray-500);">
            Tente ajustar os termos de busca.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const comunidadesGrid = document.getElementById('comunidadesGrid');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const comunidadeItems = document.querySelectorAll('.comunidade-item');

            // Função para filtrar comunidades
            function filterComunidades() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                comunidadeItems.forEach(item => {
                    const nome = item.getAttribute('data-nome') || '';
                    const matchesSearch = nome.includes(searchTerm);

                    if (matchesSearch) {
                        item.style.display = 'flex';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                // Mostrar/ocultar mensagem de "nenhum resultado"
                if (visibleCount === 0 && comunidadeItems.length > 0) {
                    if (comunidadesGrid) comunidadesGrid.style.display = 'none';
                    if (noResultsMessage) noResultsMessage.style.display = 'block';
                } else {
                    if (comunidadesGrid) comunidadesGrid.style.display = 'flex';
                    if (noResultsMessage) noResultsMessage.style.display = 'none';
                }
            }

            // Event listener para busca
            if (searchInput) {
                searchInput.addEventListener('input', filterComunidades);

                // Limpar busca ao pressionar ESC
                searchInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        filterComunidades();
                    }
                });
            }
        });
    </script>
}