@model List<Empodera.Models.ComunidadeDto>
@{
    ViewData["Title"] = "Comunidades";
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
}
<div class="forms-container">

    <h2 class="page-title">Comunidades</h2>

    <div class="filter-bar">
        <div class="search-container">
            <div class="search-input-group">
                <div class="search-wrapper" method="get">
                    <input type="text" name="q" id="searchInput" value="@(ViewData["CurrentFilter"])"
                        placeholder="Pesquise por comunidades" class="search-input" />
                    <button class="btn-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>

            <a asp-controller="Comunidade" asp-action="ComunidadesDetalhes" asp-route-id="0" class="btn-add"
                title="Adicionar Nova Comunidade">
                <i class="fa-solid fa-plus"></i>
            </a>
        </div>
    </div>

    <div class="forms-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var comunidade in Model)
            {
                <div class="form-item" data-nome="@comunidade.Nome?.ToLower()">
                    <div class="form-info">
                        <p class="name">@comunidade.Nome</p>
                        <div class="form-status">
                            <p class="date">@comunidade.Status</p>
                        </div>
                    </div>
                    <div class="actions">
                        @if (comunidade.Status == "Em Processo")
                        {
                            <div class="btn-action" title="Comunidade em Processo"
                                style="background-color: var(--color-gray-500) !important;">
                                <i class="fa-solid fa-play" fill="currentColor"></i>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Comunidade" asp-action="Processo" asp-route-id="@comunidade.Id" class="btn-action"
                                title="Iniciar Processo">
                                <i class="fa-solid fa-play" fill="currentColor"></i>
                            </a>
                        }

                        <a asp-controller="Comunidade" asp-action="ComunidadesDetalhes" asp-route-id="@comunidade.Id"
                            class="btn-action" title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-records">
                Nenhuma comunidade cadastrada ainda.
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("searchInput");
        const formItems = document.querySelectorAll(".form-item");

        searchInput.addEventListener("input", function () {
            const query = this.value.toLowerCase().trim();

            if (formItems.length > 0) {
                formItems.forEach(item => {
                    const name = item.querySelector(".name").textContent.toLowerCase();
                    item.style.display = name.includes(query) ? "flex" : "none";
                });
            }
        });
    });
</script>