@model IEnumerable<Empodera.Models.RedeRecursos>
@{
    ViewData["Title"] = "Recursos";
    Layout = "_Layout";
    ViewData["DisableMainScroll"] = "true";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/indexAtores.css" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css" />
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/site.css" />
}

<div class="atores-content-area">

    <div class="atores-header">
        <h1>
            <span><a asp-controller="Comunidade" asp-action="Index">Comunidades</a></span>
            <i class="fas fa-chevron-right fa-icon"></i>
            <a asp-controller="Comunidade" asp-action="ComunidadesDetalhes" asp-route-id="@ViewBag.ComunidadeId">Detalhes da Comunidade</a>
            <i class="fas fa-chevron-right fa-icon"></i>
            <strong>Recursos</strong>
        </h1>
    </div>

    <div class="search-container">
        <form class="search-wrapper" method="get">
            <input type="search" class="search-input" placeholder="Buscar..." name="q" />
        </form>

        <button type="button" class="atores-export-button" disabled aria-disabled="true" title="Exportação ainda não disponível nesta tela">
            <i class="fa-solid fa-file-arrow-down"></i>
        </button>
        <a asp-controller="Comunidade" asp-action="Create_Recursos" asp-route-comunidadeId="@ViewBag.ComunidadeId" class="atores-add-button">+</a>
    </div>

    <div class="atores-list-container">

        @foreach (var item in Model)
        {
            <div class="ator-card">
                <div class="activity-card-info">
                    <span class="ator-name">@item.Tipo</span>
                    <span style="font-size: 0.8em; color: #666;">@item.Dispositivo</span>
                    
                    <div class="tag-list" style="margin-top: 8px;">
                        @if(item.RedeEixos != null)
                        {
                            @foreach (var redeEixo in item.RedeEixos)
                            {
                                var eixoNome = redeEixo.Eixo.Nome;
                                var tagClass = eixoNome.ToLower() switch
                                {
                                    "prevenção" => "tag-blue",
                                    "ocupação" => "tag-green",
                                    "lazer" => "tag-yellow",
                                    "segurança social" => "tag-purple",
                                    "educação" => "tag-lightgreen",
                                    "saúde" => "tag-red",
                                    "assistência básica" => "tag-lightblue",
                                    _ => "tag-default"
                                };
                                <span class="tag-item @tagClass">@eixoNome</span>
                            }
                        }
                    </div>
                </div>
                <a class="btn-action" asp-controller="Comunidade" asp-action="ComunidadeDetalhesRecursos" asp-route-id="@item.Id_Rede">
                    <i class="fa-solid fa-eye"></i>
                </a>
            </div>
        }
        
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.querySelector(".search-input");
        const cards = document.querySelectorAll(".ator-card");

        searchInput.addEventListener("input", function () {
            const query = this.value.toLowerCase().trim();
            cards.forEach(card => {
                const name = card.querySelector(".ator-name").textContent.toLowerCase();
                card.style.display = name.includes(query) ? "flex" : "none";
            });
        });
    });
</script>
