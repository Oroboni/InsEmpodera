@model Empodera.Models.RedeRecursos
@{
    ViewData["Title"] = "Detalhes do Recurso";
    Layout = "_Layout";
    var eixos = ViewBag.EixosList as List<Empodera.Models.Eixo>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/activity-form.css" />
}

<div class="container">
    <div class="breadcrumb">
        <h1>
            <a asp-controller="Comunidade" asp-action="ComunidadeRecursos" asp-route-comunidadeId="@Model.FkIdComunidade">Recursos</a>
            <strong>Detalhes do Recurso</strong>
        </h1>
    </div>
    
    <form method="post" asp-controller="Comunidade" asp-action="Edit_Recursos">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id_Rede" />
        <input type="hidden" asp-for="FkIdComunidade" />

        <div class="form-group">
            <label>Comunidade</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-city"></i>
                <input type="text" value="@Model.Comunidade?.Nome" readonly style="background-color: #f0f0f0; cursor: not-allowed;">
            </div>
        </div>

        <div class="form-group">
            <label for="Tipo">Tipo de Recurso</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-pencil"></i>
                <input asp-for="Tipo" type="text" required placeholder="Ex: Wifi, Ponto de Acesso...">
            </div>
        </div>

        <div class="form-group">
            <label for="Dispositivo">Dispositivo</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-laptop"></i>
                <input asp-for="Dispositivo" type="text" placeholder="Ex: Roteador, Switch...">
            </div>
        </div>

        <div class="form-group">
            <label>Ator Responsável</label>
            <div class="select-wrapper">
                <i class="fa-solid fa-user"></i>
                <select asp-for="FK_id_Atores" asp-items="ViewBag.Atores" required>
                    <option value="">Selecione um ator...</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
            </div>
        </div>

        <div class="form-group" data-axis-picker>
            <label>Eixos</label>
            <div class="eixos-tag-container" data-axis-tags></div>
            <details class="multiselect-wrapper">
                <summary>
                    <div class="select-wrapper">
                        <i class="fa-solid fa-tags"></i>
                        <span class="multiselect-placeholder">Selecione os eixos</span>
                        <i class="fa-solid fa-chevron-down select-arrow"></i>
                    </div>
                </summary>
                <div class="multiselect-panel">
                    <ul>
                        @if (eixos != null)
                        {
                            @foreach (var eixo in eixos)
                            {
                                <li>
                                    <input type="checkbox" name="EixosSelecionados" value="@eixo.IdEixo" id="eixo-@eixo.IdEixo"
                                        data-tag-class="tag-pink" data-tag-name="@eixo.Nome" 
                                        @(Model.RedeEixos != null && Model.RedeEixos.Any(re => re.FkIdEixo == eixo.IdEixo) ? "checked" : "")>
                                    <label for="eixo-@eixo.IdEixo">@eixo.Nome</label>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </details>
        </div>

        <div class="form-group">
            <label for="Servicos">Serviços Oferecidos</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-align-left"></i>
                <textarea asp-for="Servicos" rows="3">@Model.Servicos</textarea>
            </div>
        </div>

        <details class="form-footer" open>
            <div class="metadata-content">
                <div class="form-group">
                    <label>Criado por</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" value="@(ViewBag.UsuarioOriginal?.Nome ?? "-")" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label>Data de criação</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-calendar-day"></i>
                        <input type="text" value="@Model.DtCriacao.ToString("dd/MM/yyyy - HH:mm")" readonly>
                    </div>
                </div>
            </div>
        </details>

        <div class="form-buttons" style="margin-top: 40px;">
            <button type="submit" class="btn-full-width">SALVAR ALTERAÇÕES</button>
        </div>
    </form>
    <form method="post" asp-controller="Comunidade" asp-action="Delete_Recursos"
          asp-route-id="@Model.Id_Rede" class="form-buttons"
          onsubmit="return confirm('Deseja excluir este recurso?');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-full-width" data-testid="delete-community-resource">
            Excluir recurso
        </button>
    </form>
</div>

@section Scripts {
    <script src="~/js/axis-picker.js" asp-append-version="true"></script>
}
