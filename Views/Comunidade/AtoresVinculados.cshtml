@{
    ViewData["Title"] = "Atores";
    Layout = "_Layout";
    ViewData["DisableMainScroll"] = "true";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/indexAtores.css" />
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css" />
}
<div class="atores-content-area">

    <div class="atores-header">
        <h1>
            <span><a asp-controller="Comunidade" asp-action="Index">Comunidades</a></span>
            <i class="fas fa-chevron-right fa-icon"></i>
            <a asp-controller="Comunidade" asp-action="ComunidadesDetalhes" asp-route-id="@ViewBag.ComunidadeId">Detalhes da Comunidade</a>
            <i class="fas fa-chevron-right fa-icon"></i>
            <strong>Atores</strong>
        </h1>
    </div>

    <div class="search-container">
        <div class="search-input-group">
            <div class="search-wrapper" method="get">
                <input type="search" class="search-input" placeholder="Busque por atores..." name="q" value="@(ViewData["CurrentFilter"])" />
                <button type="button" class="btn-search" aria-label="Buscar atores">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>
        <button type="button" class="atores-export-button" disabled aria-disabled="true"
                title="Exportação indisponível nesta tela">
            <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
            <span class="visually-hidden">Exportação ainda não disponível</span>
        </button>
        <a asp-controller="Comunidade" asp-action="Create_Atores" asp-route-id="@ViewBag.ComunidadeId" class="atores-add-button">+</a>
    </div>

    <div class="forms-list" id="atoresVinculadosList">
        
        @foreach (var ator in Model)
        {
            <div class="form-item comunidade-item">
                <span class="name item-name">@ator.Ator.Nome</span>
                <a class="btn-action" asp-controller="Comunidade" asp-action="Edit_Atores" asp-route-id="@ator.Ator.IdAtores" asp-route-comunidadeId="@ator.FkIdComunidade">
                    <i class="fa-solid fa-eye"></i>
                </a>
            </div>
        
        }

    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.querySelector(".search-input");
        const searchButton = document.querySelector(".btn-search");
        const cards = document.querySelectorAll(".form-item");
        if (!searchInput || cards.length === 0) return;

        function filterActors() {
            const query = searchInput.value.toLocaleLowerCase('pt-BR').trim();
            cards.forEach(card => {
                const name = card.querySelector(".item-name")?.textContent?.toLocaleLowerCase('pt-BR') ?? '';
                card.style.display = name.includes(query) ? "flex" : "none";
            });
        }

        searchInput.addEventListener("input", filterActors);
        searchInput.addEventListener("keydown", function (event) {
            if (event.key === 'Escape') {
                searchInput.value = '';
                filterActors();
            }
        });
        searchButton?.addEventListener("click", function () {
            filterActors();
            searchInput.focus();
        });
    });
</script>
}
