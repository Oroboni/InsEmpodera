@model IEnumerable<Empodera.Models.Atividades>
@{
    ViewData["Title"] = "Atividades";
    Layout = "_Layout";
    ViewData["DisableMainScroll"] = "true";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/indexAtores.css" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css" />
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
}

<div class="atores-content-area">

    <div class="atores-header">
        <h1>
            <span><a asp-controller="Comunidade" asp-action="Index">Comunidades</a></span>
            <i class="fas fa-chevron-right fa-icon"></i>
            <a asp-controller="Comunidade" asp-action="ComunidadesDetalhes" asp-route-id="@ViewBag.ComunidadeId">Detalhes da Comunidade</a>
            <i class="fas fa-chevron-right fa-icon"></i>
            <strong>Atividades</strong>
        </h1>
    </div>

    <div class="search-container">
        <div class="search-wrapper" method="get">
            <input type="search" class="search-input" placeholder="Buscar..." name="q" value="@(ViewData["CurrentFilter"])" />
            <button type="button" class="btn-search">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>

        <a asp-controller="Comunidade" asp-action="Create_Atividades" asp-route-comunidadeId="@ViewBag.ComunidadeId" class="atores-add-button">+</a>
    </div>

    <div class="forms-list">

        @foreach (var atividade in Model)
        {
            <div class="form-item comunidade-item">
                <div class="form-info">
                    <span class="name item-name">@atividade.Nome</span>
                    <div class="tag-list" style="margin-top: 8px;">
                        @foreach (var eixo in atividade.AtividadesEixos)
                        {
                            var eixoNome = eixo.Eixo.Nome;
                            var tagClass = eixoNome.ToLower() switch
                            {
                                "prevenção" => "tag-blue",
                                "ocupação" => "tag-green",
                                "lazer" => "tag-yellow",
                                "segurança social" => "tag-purple",
                                "educação" => "tag-lightgreen",
                                "saúde" => "tag-red",
                                "assistência básica" => "tag-lightblue",
                                _ => "tag-default"
                            };
                            <span class="tag-item @tagClass">@eixoNome</span>
                        }
                    </div>
                </div>
                <a class="btn-action" asp-controller="Comunidade" asp-action="Edit_Atividades" asp-route-id="@atividade.IdAtividade" asp-route-comunidadeId="@ViewBag.ComunidadeId">
                    <i class="fa-solid fa-eye"></i>
                </a>
            </div>
        }
        
        </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.querySelector(".search-input");
        const cards = document.querySelectorAll(".ator-card");

        searchInput.addEventListener("input", function () {
            const query = this.value.toLowerCase().trim();
            cards.forEach(card => {
                const name = card.querySelector(".ator-name").textContent.toLowerCase();
                card.style.display = name.includes(query) ? "flex" : "none";
            });
        });
    });
</script>