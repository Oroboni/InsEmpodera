@model Empodera.Models.Atores
@{
    ViewData["Title"] = "Editar Ator";
    ViewData["PageCSS"] = "create-form";
}


@section Styles {
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css">
    <link rel="stylesheet" href="~/css/pages/atores.css">
    <link rel="stylesheet" href="~/css/pages/site.css">
}

<div class="container">
    <div class="container">
        <div class="breadcrumb">
            <h1>
                <a asp-controller="Actor" asp-action="Index">Atores</a>
                >
                <strong>Editar Ator</strong>
            </h1>
        </div>
    </div>

    <form asp-controller="Comunidade" asp-action="Edit_Atores" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="IdAtores" type="hidden" />
        <input type="hidden" name="id" value="@Model.IdAtores" />

        <div class="form-group">
            <label>Comunidade</label>
            <div class="select-wrapper">
                <i class="fa-solid fa-city"></i>

                <select id="ComunidadeId" name="ComunidadeId" asp-items="ViewBag.Comunidades" required></select>

                <i class="fa-solid fa-chevron-down select-arrow"></i>
            </div>
        </div>


        <div class="form-group create-field">
            <label for="nome">Nome</label>
            <div class="input-with-buttons">
                <div class="input-wrapper">
                    <i class="fa-solid fa-user"></i>
                    <input asp-for="Nome" type="text" placeholder="Nome do Ator" required/>
                </div>
                <button type="button" class="btn-icon" title="Adicionar Novo (na lista?)"><i
                        class="fa-solid fa-plus"></i></button>
                <button type="button" class="btn-icon" title="Importar (da lista?)"><i
                        class="fa-solid fa-arrow-right-to-bracket"></i></button>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="genero">Gênero</label>
                <div class="select-wrapper">
                    <i class="fa-solid fa-venus-mars"></i>
                    <select id="Genero" asp-for="Genero" class="form-select">
                        <option value="feminino">Feminino</option>
                        <option value="masculino">Masculino</option>
                        <option value="nao-declarado">Não declarado</option>
                        <option value="transgenero">Transgênero</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>
            
            <div class="form-group"></div>
            <div class="form-group-checkbox">
                <input asp-for="DaEquipe" id="daEquipeCheckbox" type="checkbox" />
                <label for="daEquipeCheckbox">Da Equipe</label>
            </div>

            <div class="form-group-checkbox">
                <input asp-for="Rope" id="ropeCheckbox" type="checkbox" />
                <label for="ropeCheckbox">Rede Operativa</label>
            </div>

            <div class="form-group-checkbox">
                <input asp-for="Lopiniao" id="liderOpiniaoCheckbox" type="checkbox" />
                <label for="liderOpiniaoCheckbox">Líder de Opinião</label>
            </div>

            <div class="form-group-checkbox">
                <input asp-for="Mcomunidade" id="moraNaComunidadeCheckbox" type="checkbox" />
                <label for="moraNaComunidadeCheckbox">Mora na comunidade</label>
            </div>

            <div class="form-group">
                <label for="dataNascimento">Data de Nascimento</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-calendar-day"></i>
                    <input asp-for="DtNascimento" type="date" value="@Model.DtNascimento.ToString("dd-MM-yyyy")" placeholder="dd/mm/aaaa"/>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="papelSocial1">Papel Social</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-briefcase"></i>
                <input id="papelSocial1" name="papelSocial1" asp-for="PapelSocial1" value="@Model.PapelSocial1"
                    type="text" placeholder="Digite o papel social"/>
            </div>
        </div>

        <div class="form-group">
            <label for="papelSocial2">Papel Social</
            >
                <div class="input-wrapper">
                    <i class="fa-solid fa-briefcase"></i>
                    <input id="papelSocial2" name="papelSocial2" asp-for="PapelSocial2" value="@Model.PapelSocial2"
                        type="text" placeholder="Digite outro papel social (opcional)" />
                </div>
        </div>

        <div class="form-group">
            <label for="telefone">Telefone</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-phone"></i>
                <input asp-for="Telefone" type="tel" value="@Model.Telefone"/>
            </div>
        </div>

        <details class="form-footer" open>
            <div class="metadata-content">
                <div class="form-group">
                    <label>Criado por</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" value="@ViewBag.UsuarioOriginal.Nome" readonly>
                    </div>
                </div>
                @if(ViewBag.UsuarioNovo != null)
                {
                <div class="form-group">
                    <label>Atualizado por</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user"></i>
                         <input type="text" value="@ViewBag.UsuarioNovo.Nome" readonly>
                    </div>
                </div>
                }
                <div class="form-group">
                    <label>Data de criação</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-calendar-day"></i>
                        <input type="text" value="@Model.DtCriacao.ToString("dd/MM/yyyy - HH:mm")" readonly>
                    </div>
                </div>
                @if(ViewBag.UsuarioNovo != null)
                {
                <div class="form-group">
                    <label>Última atualização</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-calendar-day"></i>
                        <input type="text" value="@Model.DtModificacao.ToString("dd/MM/yyyy - HH:mm")" readonly>
                    </div>
                </div>
                }
            </div>
        </details>

        <div class="form-buttons">
            <a asp-controller="Comunidade" asp-action="AtoresVinculados" asp-route-id="@ViewBag.ComunidadeId" class="btn btn-secondary">CANCELAR</a>
            <button type="submit" class="btn btn-primary">Atualizar ator</button>
        </div>
    </form>
    <form asp-controller="Comunidade" asp-action="Delete_Atores" method="post" asp-route-id="@Model.IdAtores">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-delete">DELETAR</button>
    </form>
</div>