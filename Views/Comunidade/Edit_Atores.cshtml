@model Empodera.Models.Atores
@{
    ViewData["Title"] = "Editar Ator";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css">
    <link rel="stylesheet" href="~/css/pages/atores.css">
    <link rel="stylesheet" href="~/css/pages/site.css">
}

<div class="modern-container">
    <div class="header-section">
        <h2>
            <a asp-controller="Comunidade" asp-action="AtoresVinculados" asp-route-id="@ViewBag.ComunidadeId" class="text-primary">Atores</a>
            <span class="separator">></span>
            <strong class="text-muted">Editar Ator</strong>
        </h2>
    </div>

    <form asp-controller="Comunidade" asp-action="Edit_Atores" method="post" class="main-form">
        @Html.AntiForgeryToken()
        <input asp-for="IdAtores" type="hidden" />
        <input type="hidden" name="id" value="@Model.IdAtores" />

        <div class="section-label">Informações Básicas</div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-city"></i></div>
            <div class="input-content">
                <label for="ComunidadeId">Comunidade <span class="text-danger">*</span></label>
                <select id="ComunidadeId" name="ComunidadeId" asp-items="ViewBag.Comunidades" class="clean-input"
                    required disabled>
                    <option value="">Selecione a comunidade</option>
                </select>
            </div>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-user"></i></div>
            <div class="input-content">
                <label for="Nome">Nome <span class="text-danger">*</span></label>
                <input asp-for="Nome" type="text" class="clean-input" placeholder="Nome do Ator" required disabled />
            </div>
            <button type="button" class="btn-eye" title="Adicionar Novo">
                <i class="fa-solid fa-plus"></i>
            </button>
            <button type="button" class="btn-eye" title="Importar">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
            </button>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-heart"></i></div>
            <div class="input-content">
                <label for="tipoRelacionamento">Tipo de relacionamento</label>
                <select id="tipoRelacionamento" name="tipoRelacionamento" class="clean-input" disabled>
                    <option value="">Selecione um tipo</option>
                    <option value="1">Amigo</option>
                    <option value="2">Colega de trabalho</option>
                    <option value="3">Conhecido</option>
                    <option value="4">Familiar</option>
                    <option value="5">Vizinho</option>
                </select>
            </div>
        </div>

        <div class="purple-divider"></div>
        <div class="section-label">Recursos e Vulnerabilidades</div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-star"></i></div>
            <div class="input-content">
                <label>Recursos agregados</label>
                <small class="text-muted">Selecione todos que se aplicam:</small>
                <div class="checkbox-group dense-grid">
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="RedePrimaria" disabled>
                        <span class="checkbox-label">Rede primária</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="SeguridadeSocial" disabled>
                        <span class="checkbox-label">Seguridade Social</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="Substancias" disabled>
                        <span class="checkbox-label">Substâncias</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="Moradia" disabled>
                        <span class="checkbox-label">Moradia</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="Prevencao" disabled>
                        <span class="checkbox-label">Prevenção</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="AssistenciaBasica" disabled>
                        <span class="checkbox-label">Assistência Básica</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="Educacao" disabled>
                        <span class="checkbox-label">Educação</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="Saude" disabled>
                        <span class="checkbox-label">Saúde</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="Ocupacao" disabled>
                        <span class="checkbox-label">Ocupação</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="recursos" value="Lazer" disabled>
                        <span class="checkbox-label">Lazer</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-shield-halved"></i></div>
            <div class="input-content">
                <label>Vulnerabilidades agregadas</label>
                <small class="text-muted">Selecione todos que se aplicam:</small>
                <div class="checkbox-group dense-grid">
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="RedePrimaria" disabled>
                        <span class="checkbox-label">Rede primária</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="SeguridadeSocial" disabled>
                        <span class="checkbox-label">Seguridade Social</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="Substancias" disabled>
                        <span class="checkbox-label">Substâncias</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="Moradia" disabled>
                        <span class="checkbox-label">Moradia</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="Prevencao" disabled>
                        <span class="checkbox-label">Prevenção</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="AssistenciaBasica" disabled>
                        <span class="checkbox-label">Assistência Básica</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="Educacao" disabled>
                        <span class="checkbox-label">Educação</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="Saude" disabled>
                        <span class="checkbox-label">Saúde</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="Ocupacao" disabled>
                        <span class="checkbox-label">Ocupação</span>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" name="vulnerabilidades" value="Lazer" disabled>
                        <span class="checkbox-label">Lazer</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="purple-divider"></div>
        <div class="section-label">Dados Pessoais</div>

        <div class="grid-row">
            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-venus-mars"></i></div>
                <div class="input-content">
                    <label for="Genero">Gênero</label>
                    <select id="Genero" asp-for="Genero" class="clean-input" disabled>
                        <option value="">Selecione</option>
                        <option value="feminino">Feminino</option>
                        <option value="masculino">Masculino</option>
                        <option value="nao-declarado">Não declarado</option>
                        <option value="transgenero">Transgênero</option>
                    </select>
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-calendar-day"></i></div>
                <div class="input-content">
                    <label for="DtNascimento">Data de Nascimento</label>
                    <input asp-for="DtNascimento" type="date" class="clean-input"
                        value="@Model.DtNascimento.ToString("yyyy-MM-dd")" disabled />
                </div>
            </div>
        </div>

        <div class="input-card full-width checkbox-card">
            <div class="input-content">
                <label for="daEquipeCheckbox" class="checkbox-inline-label">
                    <input asp-for="DaEquipe" id="daEquipeCheckbox" type="checkbox" disabled />
                    Da Equipe
                </label>
            </div>
        </div>

        <div class="input-card full-width checkbox-card">
            <div class="input-content">
                <label for="ropeCheckbox" class="checkbox-inline-label">
                    <input asp-for="Rope" id="ropeCheckbox" type="checkbox" disabled />
                    Rede Operativa
                </label>
            </div>
        </div>

        <div class="input-card full-width checkbox-card">
            <div class="input-content">
                <label for="liderOpiniaoCheckbox" class="checkbox-inline-label">
                    <input asp-for="Lopiniao" id="liderOpiniaoCheckbox" type="checkbox" disabled />
                    Líder de Opinião
                </label>
            </div>
        </div>

        <div class="input-card full-width checkbox-card">
            <div class="input-content">
                <label for="moraNaComunidadeCheckbox" class="checkbox-inline-label">
                    <input asp-for="Mcomunidade" id="moraNaComunidadeCheckbox" type="checkbox" disabled />
                    Mora na comunidade
                </label>
            </div>
        </div>

        <div class="grid-row">
            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-briefcase"></i></div>
                <div class="input-content">
                    <label for="PapelSocial1">Papel Social</label>
                    <input asp-for="PapelSocial1" type="text" class="clean-input"
                        placeholder="Digite o papel social" disabled />
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-briefcase"></i></div>
                <div class="input-content">
                    <label for="PapelSocial2">Papel Social (Adicional)</label>
                    <input asp-for="PapelSocial2" type="text" class="clean-input"
                        placeholder="Digite outro papel social (opcional)" disabled />
                </div>
            </div>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-phone"></i></div>
            <div class="input-content">
                <label for="Telefone">Telefone</label>
                <input asp-for="Telefone" type="tel" class="clean-input"
                    placeholder="(00) 00000-0000" disabled />
            </div>
        </div>

        <div class="purple-divider"></div>
        <div class="section-label">Informações do Sistema</div>

        @if (Model.DtCriacao > DateTime.MinValue && ViewBag.UsuarioOriginal != null)
        {
            <div class="input-card full-width">
                <div class="icon-box purple"><i class="fa-solid fa-calendar-plus"></i></div>
                <div class="input-content">
                    <label>Criação</label>
                    <div class="user-info-display">
                        <i class="fa-solid fa-user"></i>
                        <span class="user-name">@ViewBag.UsuarioOriginal.Nome</span>
                        <span class="user-date">@Model.DtCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
            </div>
        }

        @if (Model.DtModificacao > DateTime.MinValue && ViewBag.UsuarioNovo != null)
        {
            <div class="input-card full-width">
                <div class="icon-box purple"><i class="fa-solid fa-user-edit"></i></div>
                <div class="input-content">
                    <label>Última atualização</label>
                    <div class="user-info-display">
                        <i class="fa-solid fa-user"></i>
                        <span class="user-name">@ViewBag.UsuarioNovo.Nome</span>
                        <span class="user-date">@Model.DtModificacao.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
            </div>
        }

        <!-- Botões de Ação -->
        <div class="buttons-container">
            <a asp-controller="Comunidade" asp-action="AtoresVinculados" asp-route-id="@ViewBag.ComunidadeId" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

            <div class="action-buttons-group">
                <button type="button" class="wizard-btn btn-next" id="edit-save-btn">
                    <i class="fa-solid fa-edit"></i> Editar
                </button>

                <button type="button" class="wizard-btn btn-delete" id="openDeleteModalBtn">
                    <i class="fa-solid fa-trash"></i> Deletar
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal-overlay" id="deleteConfirmationModal">
    <div class="modal-content">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>

        <h3 class="modal-title">Confirmar Exclusão</h3>

        <p class="modal-text">
            Você tem certeza que deseja deletar o Ator <strong>@Model.Nome</strong>?<br>
            Essa ação não pode ser desfeita.
        </p>

        <div class="modal-actions">
            <button type="button" class="btn-modal-cancel wizard-btn btn-prev" id="cancelDeleteBtn">
                Cancelar
            </button>

            <form asp-controller="Comunidade" asp-action="Delete_Atores" method="post" asp-route-id="@Model.IdAtores">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-modal-confirm wizard-btn btn-next">
                    Sim, Deletar
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.querySelector('.main-form');
        const inputFields = form.querySelectorAll('.clean-input, select.clean-input, input[type="checkbox"]');
        const editSaveBtn = document.getElementById('edit-save-btn');

        // Variáveis de controle
        let isEditMode = false;
        let isSubmitting = false;

        // Configurar estado dos campos
        function setPageState() {
            if (isEditMode) {
                // Modo edição ativo
                inputFields.forEach(field => {
                    field.disabled = false;
                });
                editSaveBtn.innerHTML = '<i class="fa-solid fa-check"></i> Salvar Alterações';
                editSaveBtn.setAttribute('type', 'submit');
                editSaveBtn.classList.remove('btn-next');
                editSaveBtn.classList.add('btn-save-final');
            } else {
                // Modo visualização
                inputFields.forEach(field => field.disabled = true);
                editSaveBtn.innerHTML = '<i class="fa-solid fa-edit"></i> Editar';
                editSaveBtn.setAttribute('type', 'button');
                editSaveBtn.classList.remove('btn-save-final');
                editSaveBtn.classList.add('btn-next');
            }
        }

        // Inicializar estado (visualização)
        setPageState();

        // Handler do botão editar/salvar
        editSaveBtn.addEventListener('click', function (e) {
            if (editSaveBtn.getAttribute('type') === 'submit') {
                // Se for submit, o navegador faz a validação HTML5 automática
                if (!isSubmitting && form.checkValidity()) {
                    isSubmitting = true;
                    editSaveBtn.disabled = true;
                    editSaveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processando...';
                    form.submit();
                }
            } else {
                // Alternar para modo edição
                e.preventDefault();
                isEditMode = true;
                setPageState();
                // Focar no primeiro campo editável
                const firstInput = form.querySelector('input:not([disabled]):not([type="hidden"])');
                if (firstInput) firstInput.focus();
            }
        });

        // Lógica do modal de exclusão
        const deleteModal = document.getElementById('deleteConfirmationModal');
        const openDeleteBtn = document.getElementById('openDeleteModalBtn');
        const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');

        if (openDeleteBtn) {
            openDeleteBtn.addEventListener('click', function (e) {
                e.preventDefault();
                deleteModal.style.display = 'flex';
                setTimeout(() => {
                    deleteModal.classList.add('active');
                }, 10);
            });
        }

        if (cancelDeleteBtn) {
            cancelDeleteBtn.addEventListener('click', function () {
                closeDeleteModal();
            });
        }

        // Fechar modal ao clicar fora
        window.addEventListener('click', function (e) {
            if (e.target === deleteModal) {
                closeDeleteModal();
            }
        });

        // Fechar modal com ESC
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && deleteModal.classList.contains('active')) {
                closeDeleteModal();
            }
        });

        function closeDeleteModal() {
            deleteModal.classList.remove('active');
            setTimeout(() => {
                deleteModal.style.display = 'none';
            }, 300);
        }

        // Validação em tempo real para campos obrigatórios
        const requiredFields = form.querySelectorAll('[required]');
        requiredFields.forEach(field => {
            field.addEventListener('blur', function () {
                if (!this.value || (typeof this.value === 'string' && !this.value.trim())) {
                    this.classList.add('invalid');
                } else {
                    this.classList.remove('invalid');
                }
            });
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/fichaprimeirocon" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
}