@model Empodera.Models.Comunidade
@{
  ViewData["Title"] = "Comunidades";
  ViewData["PageCSS"] = "homepage";
  Layout = "_Layout";
}

@section Styles {

  <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
  <link rel="stylesheet" href="~/css/pages/site.css" />
}

<form asp-controller="Comunidade" asp-action="ComunidadesDetalhes" method="post" class="main-form">
  @Html.AntiForgeryToken()
  <input type="hidden" name="id" value="@(Model.Id_Comunidade)" />

  <div class="modern-container">
    <div class="header-section">
      <h2>
        <a asp-controller="Comunidade" asp-action="Index" class="text-primary">Comunidades</a>
        <span class="separator">></span>
        <strong class="text-muted">@(Model.Id_Comunidade > 0 ? "Detalhes da Comunidade" : "Nova Comunidade")</strong>
      </h2>
    </div>

    <input type="hidden" asp-for="Id_Comunidade" />

    <!-- Nome -->
    <div class="input-card full-width address-input-card">
      <div class="icon-box"><i class="fa-solid fa-book"></i></div>
      <div class="input-content">
        <label asp-for="Nome">Nome <span class="text-danger">*</span></label>
        <input type="text" asp-for="Nome" class="clean-input"
               value="@(Model.Id_Comunidade > 0 ? Model.Nome : string.Empty)" required
               placeholder="Digite o nome da comunidade" />
        <span asp-validation-for="Nome" class="text-danger"></span>
      </div>
    </div>

    <!-- Mapa e Localização -->
    <div class="section-label">Localização</div>
    <div id="mapa-principal" class="default-map-container"></div>

    <div class="input-card full-width">
      <div class="icon-box purple"><i class="fa-solid fa-map-pin"></i></div>
      <div class="input-content">
        <label asp-for="Local">Endereço original <span class="text-danger">*</span></label>
        <textarea asp-for="Local" class="clean-input address-input" id="input-endereco"
                  rows="2"
                  placeholder="Digite o endereço ou use a lupa no mapa..." required></textarea>
        <span asp-validation-for="Local" class="text-danger"></span>
      </div>
    </div>
    <input type="hidden" asp-for="LocalMapa" id="input-endereco-mapa"
           value="@(Model.Id_Comunidade > 0 ? (Model.LocalMapa ?? Model.Local) : string.Empty)" />

    <!-- Complemento -->
    <div class="input-card full-width">
      <div class="icon-box purple"><i class="fa-solid fa-diamond-turn-right"></i></div>
      <div class="input-content">
        <label asp-for="Complemento">Complemento/Referência</label>
        <input asp-for="Complemento" class="clean-input"
               value="@(Model.Id_Comunidade > 0 ? Model.Complemento : string.Empty)"
               placeholder="Ex: Ponto de referência, detalhes adicionais..." />
      </div>
    </div>

    <!-- Descrição -->
    <div class="input-card full-width">
      <div class="icon-box"><i class="fa-solid fa-align-left"></i></div>
      <div class="input-content">
        <label asp-for="Descricao">Descrição</label>
        <textarea asp-for="Descricao" class="clean-input" rows="4"
                  placeholder="Adicione uma descrição sobre a comunidade...">@(Model.Id_Comunidade > 0 ? Model.Descricao : string.Empty)</textarea>
      </div>
    </div>

    <!-- Status -->
    <div class="input-card">
      <div class="input-content no-icon">
        <label asp-for="Status">Status <span class="text-danger">*</span></label>
        @{
          var currentStatus = Model.Id_Comunidade > 0 && !string.IsNullOrWhiteSpace(Model.Status) ? Model.Status : "Em processo";
        }
        <select asp-for="Status" class="clean-input" required>
          <option value="Em processo" selected="@(currentStatus == "Em processo")">Em processo</option>
          <option value="Em diagnóstico" selected="@(currentStatus == "Em diagnóstico")">Em diagnóstico</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
      </div>
    </div>

    <!-- Descrição de Acessibilidade -->
    <div class="input-card full-width">
      <div class="icon-box"><i class="fa-solid fa-universal-access"></i></div>
      <div class="input-content">
        <label asp-for="Descricao_Acessibilidade">Descrição de Acessibilidade</label>
        <textarea asp-for="Descricao_Acessibilidade" class="clean-input" rows="4"
                  placeholder="Adicione informações sobre acessibilidade...">@(Model.Id_Comunidade > 0 ? Model.Descricao_Acessibilidade : string.Empty)</textarea>
      </div>
    </div>

    @if (Model.Id_Comunidade > 0)
    {
      <div class="purple-divider"></div>
      <div class="section-label">Estatísticas da Comunidade</div>

      <div class="actions-grid">
        <a asp-controller="Comunidade" asp-action="AtoresVinculados" asp-route-id="@Model.Id_Comunidade"
           class="action-card">
          <span class="card-title" style="font-size: var(--font-size-4xl);">@ViewBag.qAtores</span>
          <span class="card-subtitle">Atores vinculados</span>
          <div class="card-icons">
            <i class="fas fa-eye"></i>
          </div>
        </a>

        <a asp-controller="Comunidade" asp-action="AtividadesVinculadas" asp-route-comunidadeId="@Model.Id_Comunidade"
           class="action-card">
          <span class="card-title" style="font-size: var(--font-size-4xl);">@ViewBag.qAtividades</span>
          <span class="card-subtitle">Atividades</span>
          <div class="card-icons">
            <i class="fas fa-eye"></i>
          </div>
        </a>

        <a asp-controller="Comunidade" asp-action="ComunidadeRecursos" asp-route-comunidadeId="@Model.Id_Comunidade"
           class="action-card">
          <span class="card-title" style="font-size: var(--font-size-4xl);">@ViewBag.qRecursos</span>
          <span class="card-subtitle">Recursos</span>
          <div class="card-icons">
            <i class="fas fa-eye"></i>
          </div>
        </a>
      </div>
    }

    <!-- Informações de Criação e Atualização -->
    @if (Model.Id_Comunidade > 0)
    {
      <div class="purple-divider"></div>
      <div class="section-label">Informações do Sistema</div>

      @if (Model.Dt_Criacao > DateTime.MinValue && ViewBag.UsuarioOriginal != null)
      {
        <div class="input-card full-width">
          <div class="icon-box"><i class="fa-solid fa-calendar-plus"></i></div>
          <div class="input-content">
            <label>Criação</label>
            <div class="user-info-display">
              <i class="fa-solid fa-user"></i>
              <span class="user-name">@ViewBag.UsuarioOriginal.Nome</span>
              <span class="user-date">@Model.Dt_Criacao.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
          </div>
        </div>
      }

      @if (Model.Dt_Modificacao > DateTime.MinValue && ViewBag.UsuarioNovo != null)
      {
        <div class="input-card full-width">
          <div class="icon-box"><i class="fa-solid fa-user-edit"></i></div>
          <div class="input-content">
            <label>Atualizado por</label>
            <div class="user-info-display">
              <i class="fa-solid fa-user"></i>
              <span class="user-name">@ViewBag.UsuarioNovo.Nome</span>
              <span class="user-date">@Model.Dt_Modificacao.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
          </div>
        </div>
      }
    }

    <!-- Botões de Ação -->
    <div class="buttons-container">
      <a href="@Url.Action("Index", "Comunidade")" class="wizard-btn btn-prev">
        <i class="fa-solid fa-arrow-left"></i> Voltar
      </a>

      <div class="action-buttons-group">
        @if (Model.Id_Comunidade > 0)
        {
          <a href="@Url.Action("ExportComunidade", "Services", new { id = Model.Id_Comunidade })"
             class="atores-export-button" title="Exportar dados">
            <i class="fa-solid fa-file-arrow-down"></i>
          </a>
        }
        <button type="button" class="wizard-btn" id="edit-save-btn">
          @if (Model.Id_Comunidade == 0)
          {
            <text><i class="fa-solid fa-plus"></i> Criar Comunidade</text>
          }
          else
          {
            <text><i class="fa-solid fa-edit"></i> Editar</text>
          }
        </button>

        @if (Model.Id_Comunidade > 0)
        {
          <button type="button" class="wizard-btn btn-delete" id="openDeleteModalBtn">
            <i class="fa-solid fa-trash"></i> Deletar
          </button>
        }
      </div>
    </div>
  </div>
</form>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal-overlay" id="deleteConfirmationModal">
  <div class="modal-content">
    <div class="modal-icon">
      <i class="fas fa-exclamation-triangle"></i>
    </div>
    <h3 class="modal-title">Confirmar Exclusão</h3>
    <p class="modal-text">
      Você tem certeza que deseja deletar a comunidade <strong>@Model.Nome</strong>?
      <br>Essa ação não pode ser desfeita.
    </p>

    <div class="button-container">

      <div class="modal-actions">
        <button type="button" class="btn-modal-cancel wizard-btn btn-prev" id="cancelDeleteBtn">Cancelar</button>

        <form asp-controller="Comunidade" asp-action="Delete" method="post" asp-route-id="@Model.Id_Comunidade">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn-modal-confirm wizard-btn btn-next">Sim, Deletar</button>
        </form>

      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('.main-form');
    const inputFields = form.querySelectorAll('.clean-input, textarea.clean-input');
    const editSaveBtn = document.getElementById('edit-save-btn');

    // Inicializar mapa
    if (typeof initMapSelector === 'function') {
      initMapSelector('mapa-principal', 'input-endereco-mapa', {
        sourceInputId: 'input-endereco-mapa',
        mirrorInputId: 'input-endereco',
        manualInputId: 'input-endereco'
      });
    } else {
      console.error("ERRO: A função initMapSelector não foi encontrada. Verifique se importou o app-maps.js");
    }

    // Configurar modo da página
    const isCreateMode = @(Model.Id_Comunidade == 0 ? "true" : "false");
    let isEditMode = isCreateMode;
    let isSubmitting = false;

    // Configurar estado dos campos
    function setPageState() {
      if (isCreateMode) {
        // Modo criação: sempre editável
        inputFields.forEach(field => field.disabled = false);
        editSaveBtn.innerHTML = '<i class="fa-solid fa-plus"></i> Criar Comunidade';
        editSaveBtn.setAttribute('type', 'submit');
        editSaveBtn.classList.add('btn-next');
        editSaveBtn.classList.remove('btn-prev');
      } else {
        if (isEditMode) {
          // Modo edição ativo
          inputFields.forEach(field => { if (field.tagName !== 'SELECT') { field.disabled = false; } });
          editSaveBtn.innerHTML = '<i class="fa-solid fa-check"></i> Salvar Alterações';
          editSaveBtn.setAttribute('type', 'submit');
          editSaveBtn.classList.add('btn-save-final');
          editSaveBtn.classList.remove('btn-next');
        } else {
          // Modo visualização
          inputFields.forEach(field => field.disabled = true);
          editSaveBtn.innerHTML = '<i class="fa-solid fa-edit"></i> Editar';
          editSaveBtn.setAttribute('type', 'button');
          editSaveBtn.classList.add('btn-next');
          editSaveBtn.classList.remove('btn-save-final');
        }
      }
    }

    // Inicializar estado
    setPageState();

    // Handler do botão editar/salvar
    editSaveBtn.addEventListener('click', function (e) {
      if (editSaveBtn.getAttribute('type') === 'submit') {
        // Se for submit, o navegador faz a validação HTML5 automática
        if (!isSubmitting && form.checkValidity()) {
          isSubmitting = true;
          editSaveBtn.disabled = true;
          editSaveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processando...';
          form.submit();
        }
      } else {
        // Alternar para modo edição
        e.preventDefault();
        isEditMode = true;
        setPageState();
        // Focar no primeiro campo editável
        const firstInput = form.querySelector('input:not([disabled]), textarea:not([disabled]), select:not([disabled])');
        if (firstInput) firstInput.focus();
      }
    });

    // Lógica do modal de exclusão
    const deleteModal = document.getElementById('deleteConfirmationModal');
    const openDeleteBtn = document.getElementById('openDeleteModalBtn');
    const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
    const confirmationText = document.getElementById('confirmationText');
    const confirmationError = document.getElementById('confirmationError');
    const deleteForm = document.getElementById('deleteForm');
    const deleteBtn = deleteForm?.querySelector('.btn-modal-delete');
    const communityName = document.querySelector('.community-name');

    // Variáveis de controle
    const REQUIRED_TEXT = "EXCLUIR";
    let isDeleteProcessing = false;

    function validateConfirmation() {
      const input = confirmationText.value.trim();
      const isValid = input === REQUIRED_TEXT;

      if (confirmationText && deleteBtn) {
        confirmationText.classList.toggle('valid', isValid);
        confirmationText.classList.toggle('invalid', input && !isValid);
        deleteBtn.disabled = !isValid || isDeleteProcessing;

        if (input && !isValid) {
          confirmationError.textContent = `Digite exatamente "${REQUIRED_TEXT}" para confirmar`;
        } else {
          confirmationError.textContent = '';
        }
      }

      return isValid;
    }

    if (openDeleteBtn) {
      openDeleteBtn.addEventListener('click', function (e) {
        e.preventDefault();

        // Resetar o modal
        if (confirmationText) confirmationText.value = '';
        if (confirmationError) confirmationError.textContent = '';
        if (deleteBtn) deleteBtn.disabled = true;

        deleteModal.style.display = 'flex';
        setTimeout(() => {
          deleteModal.classList.add('active');
          if (confirmationText) confirmationText.focus();
        }, 10);
      });
    }

    if (cancelDeleteBtn) {
      cancelDeleteBtn.addEventListener('click', function () {
        closeDeleteModal();
      });
    }

    if (confirmationText) {
      confirmationText.addEventListener('input', validateConfirmation);
      confirmationText.addEventListener('keyup', function (e) {
        if (e.key === 'Enter' && validateConfirmation()) {
          deleteForm.submit();
        }
      });
    }

    if (deleteForm) {
      deleteForm.addEventListener('submit', function (e) {
        e.preventDefault();

        if (!validateConfirmation() || isDeleteProcessing) {
          return;
        }

        // Confirmar novamente para maior segurança
        const finalConfirmation = confirm(`Tem certeza absoluta que deseja excluir a comunidade "${communityName?.textContent}"? Esta ação é irreversível.`);

        if (!finalConfirmation) {
          return;
        }

        // Desabilitar botão e mostrar loading
        isDeleteProcessing = true;
        if (deleteBtn) {
          deleteBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Excluindo...';
          deleteBtn.disabled = true;
        }

        // Adicionar atraso para feedback visual
        setTimeout(() => {
          // Enviar o formulário
          this.submit();
        }, 800);
      });
    }

    // Fechar modal ao clicar fora
    window.addEventListener('click', function (e) {
      if (e.target === deleteModal) {
        closeDeleteModal();
      }
    });

    // Fechar modal com ESC
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && deleteModal.classList.contains('active')) {
        closeDeleteModal();
      }
    });

    function closeDeleteModal() {
      deleteModal.classList.remove('active');
      setTimeout(() => {
        deleteModal.style.display = 'none';
        isDeleteProcessing = false;
      }, 300);
    }


    window.addEventListener('click', function (e) {
      if (e.target === deleteModal) {
        deleteModal.classList.remove('active');
        setTimeout(() => deleteModal.style.display = 'none', 300);
      }
    });

    // Validação em tempo real para campos obrigatórios
    const requiredFields = form.querySelectorAll('[required]');
    requiredFields.forEach(field => {
      field.addEventListener('blur', function () {
        if (!this.value.trim()) {
          this.classList.add('invalid');
        } else {
          this.classList.remove('invalid');
        }
      });
    });
  });
</script>
