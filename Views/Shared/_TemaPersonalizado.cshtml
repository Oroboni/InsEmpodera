@inject Empodera.Services.TemaPersonalizadoService TemaPersonalizado
@* Cores escolhidas pelo usuário logado em Configurações > Cores da plataforma (sobrepõem o tema base de tema.css). *@
@{
    var cssPersonalizado = int.TryParse(Context.Session.GetString("ID"), out var usuarioTemaId)
        ? TemaPersonalizado.GerarCss(usuarioTemaId)
        : null;
}
@if (cssPersonalizado is not null)
{
    <style id="tema-personalizado">@Html.Raw(cssPersonalizado)</style>
}
