﻿<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Laços - Instituto Empodera</title>
    <link rel="icon" href="~/icons/Logo-empodera.ico" type="image/x-icon">

    <!-- CSS Base -->
    <link rel="stylesheet" href="~/css/_variaveis.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/sidebar/sidebar.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- CSS do global do Mapa (LEAFLET) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
    <style>
        .default-map-container {
            height: 400px;
            width: 100%;
            border-radius: 12px;
            border: 2px solid #eee;
            z-index: 1;
        }
    </style>

    @{
        var cssName = ViewData["PageCSS"] as string;
        if (string.IsNullOrEmpty(cssName))
        {
            cssName = ViewContext.RouteData.Values["controller"]?.ToString().ToLower();
        }
    }

    @if (!string.IsNullOrEmpty(cssName))
    {
        <link rel="stylesheet" href="~/css/pages/@(cssName).css" asp-append-version="true" />
    }

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="body-page">
        <div class="main-content-wrapper">
            <div class="section-1">
                <h2>Olá @(ViewContext.HttpContext?.Session?.GetString("Nome"))</h2>
                <ul>
                    <p>Principais</p>
                    <!-- Seu menu continua igual... -->
                    <li data-page="home" class="@IsActive("Home")">
                        <a asp-controller="Home" asp-action="Index">
                            <p><i class="fas fa-home"></i> Home</p>
                        </a>
                    </li>
                    <li data-page="comunidade" class="@IsActive("Comunidade")">
                        <a asp-controller="Comunidade" asp-action="Index">
                            <p><i class="fas fa-city"></i> Comunidades</p>
                        </a>
                    </li>
                    <li data-page="atores" class="@IsActive("Atores")">
                        <a asp-controller="Atores" asp-action="Index">
                            <p><i class="fas fa-users"></i> Atores</p>
                        </a>
                    </li>
                    <li data-page="fichaprimeirocontato" class="@IsActive("FichaPrimeiroContato")">
                        <a asp-controller="FichaPrimeiroContato" asp-action="Index">
                            <p><i class="fas fa-clipboard-list"></i> Ficha 1º Contato</p>
                        </a>
                    </li>
                    <li data-page="diariosdecampo" class="@IsActive("DiariosDeCampo")">
                        <a asp-controller="DiariosDeCampo" asp-action="Index">
                            <p><i class="fas fa-book"></i> Diários de Campo</p>
                        </a>
                    </li>
                    <li data-page="PersonalAssessment" class="@IsActive("PersonalAssessment")">
                        <a asp-controller="PersonalAssessment" asp-action="Index">
                            <p><i class="fas fa-book-open"></i> Diário Pessoal</p>
                        </a>
                    </li>
                    <li data-page="Report" class="@IsActive("Report")">
                        <a asp-controller="Report" asp-action="Index">
                            <p><i class="fas fa-chart-bar"></i> Relatórios</p>
                        </a>
                    </li>
                    <li data-page="dashboard" class="@IsActive("Dashboard")">
                        <a asp-controller="Dashboard" asp-action="Index">
                            <p><i class="fas fa-chart-line"></i> Dashboard</p>
                        </a>
                    </li>
                    <li data-page="atividades" class="@IsActive("Atividades")">
                        <a asp-controller="Atividades" asp-action="Index">
                            <p><i class="fas fa-bolt"></i> Atividades</p>
                        </a>
                    </li>
                    <li data-page="Users" class="@IsActive("Users")">
                        <a asp-controller="Users" asp-action="Index">
                            <p><i class="fas fa-user"></i> Usuários</p>
                        </a>
                    </li>
                    <li data-page="AccessProfile" class="@IsActive("AccessProfile")">
                        <a asp-controller="AccessProfile" asp-action="Index">
                            <p><i class="fas fa-user-shield"></i> Perfis de Acesso</p>
                        </a>
                    </li>
                </ul>

                <ul>
                    <p>Conta</p>
                    <li data-page="ajuda" class="@IsActive("Ajuda")">
                        <a asp-controller="Ajuda" asp-action="Index">
                            <p><i class="fas fa-question-circle"></i> Ajuda</p>
                        </a>
                    </li>
                    <li data-page="configuracoes" class="@IsActive("Configuracoes")">
                        <a asp-controller="Configuracoes" asp-action="Index">
                            <p><i class="fas fa-cog"></i> Configurações</p>
                        </a>
                    </li>
                    <li data-page="logout">
                        <a asp-controller="Account" asp-action="Logout">
                            <p><i class="fas fa-sign-out-alt"></i> Logout</p>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="section-2" id="content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/js/sidebar.js"></script>

    <!-- Scripts do mapa. devem vir antes da chamada do app-maps.js -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

    <!-- Agora sim carregamos o seu script customizado -->
    <script src="~/js/app-maps.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

@functions {
    public string IsActive(string controllerName)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}