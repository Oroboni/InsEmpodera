@inject Microsoft.Extensions.Configuration.IConfiguration AppConfig
@{
    var temaConfigurado = (AppConfig["Tema"] ?? "verde").Trim().ToLowerInvariant();
    var temaAtivo = System.Text.RegularExpressions.Regex.IsMatch(temaConfigurado, "^[a-z-]{1,30}$") ? temaConfigurado : "verde";
}
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var codigoAtual = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "en"
        : currentCulture.StartsWith("es", StringComparison.OrdinalIgnoreCase) ? "es" : "pt-BR";
    var currentLanguage = Empodera.Services.IdiomasInterface.Nome(codigoAtual, currentCulture);
    var automaticLanguage = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase)
        ? "Automatic (browser)"
        : "Automático (navegador)";
    var selectLanguageLabel = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase)
        ? "Select language"
        : currentCulture.StartsWith("es", StringComparison.OrdinalIgnoreCase)
            ? "Seleccionar idioma"
            : "Selecionar idioma";
    var languageReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var languageMode = Context.Request.Cookies[Empodera.Services.UserCultureService.PreferenceModeCookieName];
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-tema="@temaAtivo">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoRedes</title>
    <link rel="icon" href="~/images/Logo-empodera.svg" type="image/x-icon">
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <partial name="_TemaPersonalizado" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/js/localization.js" asp-append-version="true" defer></script>
</head>
<body class="login-body">
    @{
        var eIngles = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);
        var eEspanhol = currentCulture.StartsWith("es", StringComparison.OrdinalIgnoreCase);
        var siglaAtual = eIngles ? "EN" : eEspanhol ? "ES" : "PT";
        var tituloIdioma = eIngles ? "Language" : "Idioma";
        var descricaoAutomatico = eIngles ? "Use browser language" : eEspanhol ? "Usar el idioma del navegador" : "Usar o idioma do navegador";
        var usaIdiomaExplicito = string.Equals(languageMode, "explicit", StringComparison.Ordinal);
    }
    <details class="login-language-switcher" data-current-culture="@currentCulture">
        <summary aria-label="@selectLanguageLabel">
            <svg class="login-language-globe" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
            </svg>
            <span class="login-language-code" aria-hidden="true">@siglaAtual</span>
            <span class="login-language-name">@currentLanguage</span>
            <svg class="login-language-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="login-language-menu" role="group" aria-label="@selectLanguageLabel">
            <p class="login-language-title">@tituloIdioma</p>
            @foreach (var language in new[]
            {
                (Code: "auto", Sigla: "A", Label: automaticLanguage.Replace(" (navegador)", "").Replace(" (browser)", ""), Descricao: descricaoAutomatico)
            }.Concat(Empodera.Services.IdiomasInterface.Codigos.Select(codigo => (
                Code: codigo,
                Sigla: Empodera.Services.IdiomasInterface.Sigla(codigo),
                Label: Empodera.Services.IdiomasInterface.Nome(codigo, currentCulture),
                Descricao: Empodera.Services.IdiomasInterface.NomeNativo(codigo)))))
            {
                var isActive = language.Code == "auto"
                    ? !usaIdiomaExplicito
                    : usaIdiomaExplicito && string.Equals(language.Code, currentCulture, StringComparison.OrdinalIgnoreCase);
                <form asp-for="IdiomaPreferido" asp-controller="Language" asp-action="Set" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="@language.Code" />
                    <input type="hidden" name="returnUrl" value="@languageReturnUrl" />
                    <button type="submit"
                            class="@(isActive ? "is-active" : null)"
                            aria-current="@(isActive ? "true" : null)"
                            lang="@(language.Code == "auto" ? currentCulture : language.Code)">
                        <span class="login-language-option-code" aria-hidden="true">@language.Sigla</span>
                        <span class="login-language-option-text">
                            <strong>@language.Label</strong>
                            <small>@language.Descricao</small>
                        </span>
                        <span class="language-selected-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false"><path d="m5 12 5 5 9-10" /></svg>
                        </span>
                    </button>
                </form>
            }
        </div>
    </details>
    <script>
        // Fecha o seletor de idioma ao clicar fora ou com Esc.
        (() => {
            const seletor = document.querySelector('.login-language-switcher');
            if (!seletor) return;
            document.addEventListener('click', e => { if (seletor.open && !seletor.contains(e.target)) seletor.open = false; });
            document.addEventListener('keydown', e => {
                if (e.key === 'Escape' && seletor.open) { seletor.open = false; seletor.querySelector('summary').focus(); }
            });
        })();
    </script>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
