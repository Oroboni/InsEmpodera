@inject Empodera.Services.FotoUsuarioService FotosLista
@model IEnumerable<Empodera.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
    Layout = "_Layout";
    ViewData["PageCSS"] = "homepage";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css" asp-append-version="true" />
}

<div class="modern-container">
    <!-- Header -->
    <div class="header-section">
        <h2>
            <strong class="text-primary">Usuários</strong>
        </h2>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="crud-feedback is-success" role="status">@successMessage</div>
    }

    <!-- Estatísticas -->
    <button type="button" class="section-label indicadores-toggle" data-indicadores
            aria-expanded="true" title="Recolher ou mostrar os indicadores">
        <span>Indicadores</span>
        <i class="fa-solid fa-chevron-up indicadores-chevron" aria-hidden="true"></i>
    </button>
    <div class="actions-grid">
        <div class="action-card stats-card">
            <span class="card-title" id="totalUsers">@Model.Count()</span>
            <span class="card-subtitle">Total de Usuários</span>
            <div class="card-icons">
                <i class="fas fa-users"></i>
            </div>
        </div>

        @{
            var ativos = Model.Count(u => u.Ativo == "S");
        }
        <div class="action-card stats-card stats-card-active">
            <span class="card-title" id="activeUsers">@ativos</span>
            <span class="card-subtitle">Usuários Ativos</span>
            <div class="card-icons">
                <i class="fas fa-check-circle"></i>
            </div>
        </div>

        @{
            var inativos = Model.Count(u => u.Ativo == "N");
        }
        <div class="action-card stats-card stats-card-red">
            <span class="card-title" id="inactiveUsers">@inativos</span>
            <span class="card-subtitle">Usuários Inativos</span>
            <div class="card-icons">
                <i class="fas fa-times-circle"></i>
            </div>
        </div>
    </div>

    <!-- Busca, filtro por status e novo -->
    <div class="search-container">
        <div class="search-input-group">
            <div class="search-wrapper">
                <input type="search" id="searchUsersInput" placeholder="Busque por nome ou email..."
                    aria-label="Buscar usuários" />
                <button type="button" class="btn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>

        <div class="list-filter">
            <i class="fa-solid fa-filter list-filter-icon" aria-hidden="true"></i>
            <select id="filtroStatus" aria-label="Filtrar por status">
                <option value="todos">Todos os status (@Model.Count())</option>
                <option value="ativos">Ativos (@ativos)</option>
                <option value="inativos">Inativos (@inativos)</option>
            </select>
            <i class="fa-solid fa-chevron-down list-filter-arrow" aria-hidden="true"></i>
        </div>

        @if ((ViewBag.CanCreateUsers as bool?) == true)
        {
            <button type="button" class="btn-add" onclick="window.location.href='@Url.Action("Create", "Users")'"
                title="Adicionar Novo Usuário" data-testid="user-create">
                <i class="fa-solid fa-plus"></i>
            </button>
        }
    </div>

    <!-- Lista de Usuários -->
    <div class="purple-divider"></div>
    <div class="section-label">Todos os Usuários</div>

    <div class="forms-list" id="usersGrid">
        @if (Model != null && Model.Any())
        {
            @foreach (var user in Model)
            {
                var isAtivo = user.Ativo == "S";

                <div class="form-item user-item" 
                     data-ativo="@isAtivo.ToString().ToLower()" 
                     data-nome="@user.Nome?.ToLower()"
                     data-email="@user.Email?.ToLower()">

                    <div class="item-header">
                        @{ var urlFotoUsuario = FotosLista.Url(user.IdUsuario); }
                        <div class="avatar avatar-md" aria-hidden="true">
                            @if (urlFotoUsuario is not null)
                            {
                                <img src="@urlFotoUsuario" alt="" loading="lazy" />
                            }
                            else
                            {
                                @Empodera.Services.FotoUsuarioService.Iniciais(user.Nome)
                            }
                        </div>
                        <div class="item-content">
                            <p class="item-name">@user.Nome</p>
                            <p class="item-subtitle">
                                <i class="fas fa-envelope"></i>
                                @user.Email
                            </p>
                            
                            <div class="tag-list">
                                <span class="tag-item">
                                    <i class="fas fa-id-badge"></i>
                                    @(user.Perfil?.Nome ?? "Sem perfil")
                                </span>
                                @if (isAtivo)
                                {
                                    <span class="tag-item tag-green">
                                        <i class="fas fa-check-circle"></i>
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="tag-item tag-red">
                                        <i class="fas fa-times-circle"></i>
                                        Inativo
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        @if ((ViewBag.CanViewUsers as bool?) == true)
                        {
                            <a class="btn-eye" asp-controller="Users" asp-action="Details" asp-route-id="@user.IdUsuario"
                                title="Ver detalhes" data-testid="user-details-@user.IdUsuario">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        }
                        @if ((ViewBag.CanUpdateUsers as bool?) == true)
                        {
                            <a class="btn-eye" asp-controller="Users" asp-action="Edit" asp-route-id="@user.IdUsuario"
                                title="Editar usuário" data-testid="user-edit-@user.IdUsuario">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-records">
                <div class="no-records-icon">
                    <i class="fas fa-users"></i>
                </div>
                <h3>Nenhum usuário cadastrado</h3>
                <p>Comece adicionando seu primeiro usuário ao sistema.</p>
                <button type="button" class="btn-save" onclick="window.location.href='@Url.Action("Create", "Users")'">
                    <i class="fa-solid fa-plus"></i> Adicionar Primeiro Usuário
                </button>
            </div>
        }
    </div>

    <!-- Mensagem quando nenhum resultado for encontrado -->
    <div class="no-records" id="noResultsMessage" style="display: none;">
        <div class="no-records-icon">
            <i class="fas fa-search"></i>
        </div>
        <h3>Nenhum usuário encontrado</h3>
        <p>Tente ajustar os filtros ou termos de busca.</p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchUsersInput');
            const usersGrid = document.getElementById('usersGrid');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const userItems = document.querySelectorAll('.user-item');
            const filtroStatus = document.getElementById('filtroStatus');

            if (!searchInput || !usersGrid || !noResultsMessage) return;

            let currentStatusFilter = 'todos';

            // Função para filtrar usuários
            function filterUsers() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                userItems.forEach(item => {
                    const nome = item.getAttribute('data-nome') || '';
                    const email = item.getAttribute('data-email') || '';
                    const ativo = item.getAttribute('data-ativo') === 'true';

                    // Verificar se corresponde à busca
                    const matchesSearch = nome.includes(searchTerm) || email.includes(searchTerm);

                    // Verificar se corresponde ao filtro de status
                    let matchesStatus = true;
                    if (currentStatusFilter === 'ativos') {
                        matchesStatus = ativo;
                    } else if (currentStatusFilter === 'inativos') {
                        matchesStatus = !ativo;
                    }

                    const shouldShow = matchesSearch && matchesStatus;

                    if (shouldShow) {
                        item.style.display = 'flex';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                // Mostrar/ocultar mensagem de "nenhum resultado"
                if (visibleCount === 0 && userItems.length > 0) {
                    usersGrid.style.display = 'none';
                    noResultsMessage.style.display = 'block';
                } else {
                    usersGrid.style.display = 'flex';
                    noResultsMessage.style.display = 'none';
                }
            }

            // Event listener para busca
            searchInput.addEventListener('input', filterUsers);

            // Filtro por status
            filtroStatus?.addEventListener('change', function () {
                currentStatusFilter = this.value;
                this.closest('.list-filter')?.classList.toggle('is-active', currentStatusFilter !== 'todos');
                filterUsers();
            });

            // Limpar busca ao pressionar ESC
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    searchInput.value = '';
                    filterUsers();
                }
            });
        });
    </script>
}
