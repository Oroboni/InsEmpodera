@model Empodera.Models.Usuario
@{
    ViewData["Title"] = "Usuários";
    ViewData["PageCSS"] = "usuarios-edit";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/usuarios-edit.css" />
}

<div class="modern-container">
    <form asp-action="Create" method="post" class="main-form" data-testid="user-create-form">
        @Html.AntiForgeryToken()


        <!-- Cabeçalho -->
        <div class="header-section">
            <h2>
                <a asp-controller="Users" asp-action="Index" class="text-primary">Usuários</a>
                <span class="separator">></span>
                <strong class="text-muted">Novo Usuário</strong>
            </h2>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <!-- Nome -->
        <div class="input-card full-width">
            <div class="icon-box">
                <i class="fa-solid fa-user"></i>
            </div>
            <div class="input-content">
                <label asp-for="Nome">Nome <span class="text-danger">*</span></label>
                <input asp-for="Nome" class="clean-input" placeholder="Digite o nome do usuário" required maxlength="255" autocomplete="name" />
            </div>
        </div>


        <!-- Email -->
        <div class="grid-row">
            <div class="input-card">
                <div class="icon-box purple">
                    <i class="fa-solid fa-envelope"></i>
                </div>
                <div class="input-content">
                    <label asp-for="Email">E-mail <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="clean-input" placeholder="Digite o e-mail" required maxlength="256" autocomplete="email" />
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box purple">
                    <i class="fa-solid fa-id-badge"></i>
                </div>
                <div class="input-content">
                    <label asp-for="FkIdPerfil">Perfil <span class="text-danger">*</span></label>
                    <select asp-for="FkIdPerfil" asp-items="ViewBag.PerfilLista" class="clean-input" required>
                        <option value="">Selecione</option>
                    </select>
                </div>
            </div>
        </div>


        <!-- Senha -->
        <div class="input-card full-width">
                <div class="icon-box">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <div class="input-content">
                    <label asp-for="Senha">Senha <span class="text-danger">*</span></label>
                    <input asp-for="Senha" type="password" class="clean-input" placeholder="Digite a senha" required minlength="8" maxlength="100" autocomplete="new-password" />
                    <small class="text-muted">Use pelo menos 8 caracteres, com maiúscula, minúscula, número e símbolo.</small>
                </div>
        </div>


        <!-- Gênero -->
        <div class="grid-row">
            <div class="input-card">
                <div class="icon-box purple">
                    <i class="fa-solid fa-venus-mars"></i>
                </div>
                <div class="input-content">
                    <label asp-for="Genero">Gênero</label>
                    <select asp-for="Genero" class="clean-input">
                        <option value="">Selecione</option>
                        <option value="2">Feminino</option>
                        <option value="1">Masculino</option>
                        <option value="">Não declarado</option>
                        <option value="3">Transgênero</option>
                    </select>
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <div class="input-content">
                    <label asp-for="Ocupacao">Ocupação <span class="text-danger">*</span></label>
                    <input asp-for="Ocupacao" class="clean-input" placeholder="Ex: Assistente social" required maxlength="255" />
                </div>
            </div>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple">
                <i class="fa-solid fa-cake-candles"></i>
            </div>
            <div class="input-content">
                <label asp-for="DtNascimento">Data de nascimento <span class="text-danger">*</span></label>
                <input asp-for="DtNascimento" type="date" class="clean-input" required min="1900-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <!-- Botões -->
        <div class="buttons-container">
            <a asp-controller="Users" asp-action="Index" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

            <button type="submit" class="wizard-btn btn-next" data-testid="user-create-submit">
                <i class="fa-solid fa-check"></i> Salvar Usuário
            </button>
        </div>
    </form>
</div>
