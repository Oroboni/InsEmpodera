@model Empodera.Models.Usuario
@{
    ViewData["Title"] = "Editar Usuário";
    ViewData["PageCSS"] = "usuarios-edit";
    Layout = "_Layout";
    var canManageIdentity = (ViewBag.CanManageIdentity as bool?) == true;
    var canDelete = (ViewBag.CanDeleteUsers as bool?) == true;
    var isCurrentUser = (ViewBag.IsCurrentUser as bool?) == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/usuarios-edit.css" />
}

<div class="modern-container">
    <form asp-action="Edit" method="post" class="main-form" data-testid="user-edit-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdUsuario" />


        <!-- Cabeçalho -->
        <div class="header-section">
            <h2>
                <a asp-controller="Users" asp-action="Index" class="text-primary">Usuários</a>
                <span class="separator">></span>
                <strong class="text-muted">Editar Usuário</strong>
            </h2>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <!-- Nome -->
        <div class="input-card full-width">
            <div class="icon-box">
                <i class="fa-solid fa-user"></i>
            </div>
            <div class="input-content">
                <label asp-for="Nome">Nome <span class="text-danger">*</span></label>
                <input asp-for="Nome" class="clean-input" placeholder="Nome completo" required disabled>
            </div>
        </div>

        <!-- Email e Perfil -->
        <div class="grid-row">
            <div class="input-card">
                <div class="icon-box purple">
                    <i class="fa-solid fa-envelope"></i>
                </div>
                <div class="input-content">
                    <label asp-for="Email">E-mail <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="clean-input" placeholder="exemplo@email.com"
                        required maxlength="256" autocomplete="email" disabled>
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box purple">
                    <i class="fa-solid fa-id-badge"></i>
                </div>
                <div class="input-content">
                    <label asp-for="FkIdPerfil">Perfil de Acesso <span class="text-danger">*</span></label>
                    <select asp-for="FkIdPerfil" asp-items="ViewBag.PerfilLista" class="clean-input simple-select"
                        required disabled data-locked="@((!canManageIdentity || isCurrentUser).ToString().ToLowerInvariant())">
                        <option value="">Selecione</option>
                    </select>
                    @if (!canManageIdentity || isCurrentUser)
                    {
                        <input type="hidden" name="FkIdPerfil" value="@Model.FkIdPerfil" />
                    }
                    <i class="fa-solid fa-chevron-down dropdown-icon"></i>
                </div>
            </div>
        </div>

        <!-- Senha -->
        <div class="input-card full-width">
            <div class="icon-box">
                <i class="fa-solid fa-lock"></i>
            </div>
            <div class="input-content">
                <label asp-for="Senha">Nova senha <span class="text-muted">(opcional)</span></label>
                <input asp-for="Senha" type="password" class="clean-input" placeholder="Deixe vazio para manter a atual"
                    minlength="8" maxlength="100" autocomplete="new-password" disabled
                    data-locked="@((!canManageIdentity).ToString().ToLowerInvariant())">
                <small class="text-muted" style="margin-top: 4px; display: block;">Preencha somente quando quiser trocar a senha.</small>
            </div>
        </div>

        <!-- Gênero e Ocupação -->
        <div class="grid-row">
            <div class="input-card">
                <div class="icon-box purple">
                    <i class="fa-solid fa-venus-mars"></i>
                </div>
                <div class="input-content">
                    <label asp-for="Genero">Gênero</label>
                    <select asp-for="Genero" class="clean-input simple-select" disabled>
                        <option value="">Selecione</option>
                        <option value="2">Feminino</option>
                        <option value="1">Masculino</option>
                        <option value="">Não declarado</option>
                        <option value="3">Transgênero</option>
                    </select>
                    <i class="fa-solid fa-chevron-down dropdown-icon"></i>
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <div class="input-content">
                    <label asp-for="Ocupacao">Ocupação <span class="text-danger">*</span></label>
                    <input asp-for="Ocupacao" class="clean-input" placeholder="Ex: Assistente social" required maxlength="255" disabled>
                </div>
            </div>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple">
                <i class="fa-solid fa-cake-candles"></i>
            </div>
            <div class="input-content">
                <label asp-for="DtNascimento">Data de nascimento <span class="text-danger">*</span></label>
                <input asp-for="DtNascimento" asp-format="{0:yyyy-MM-dd}" type="date" class="clean-input" required min="1900-01-01"
                    max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled>
            </div>
        </div>

        <!-- Status Ativo -->
        <div class="input-card full-width">
                <div class="icon-box">
                    <i class="fa-solid fa-toggle-on"></i>
                </div>
                <div class="input-content">
                    <label asp-for="Ativo">Status</label>
                    <select asp-for="Ativo" class="clean-input simple-select" disabled
                        data-locked="@((!canManageIdentity || isCurrentUser).ToString().ToLowerInvariant())">
                        <option value="S">Ativo</option>
                        <option value="N">Inativo</option>
                    </select>
                    @if (!canManageIdentity || isCurrentUser)
                    {
                        <input type="hidden" name="Ativo" value="@Model.Ativo" />
                    }
                    <i class="fa-solid fa-chevron-down dropdown-icon"></i>
                </div>
        </div>

        <!-- Botões -->
        <div class="buttons-container">
            <a asp-controller="Users" asp-action="Index" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

            <div class="action-buttons-group">
                <button type="button" class="wizard-btn btn-next" id="edit-save-btn" data-testid="user-edit-submit" data-i18n-text>
                    <i class="fa-solid fa-edit"></i> Editar
                </button>

                @if (canDelete && !isCurrentUser && Model.Ativo == "S")
                {
                    <button type="button" class="wizard-btn btn-delete" id="openDeleteModalBtn">
                        <i class="fa-solid fa-user-slash"></i> Desativar
                    </button>
                }
            </div>
        </div>
    </form>
</div>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal-overlay" id="deleteConfirmationModal">
    <div class="modal-content">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>

        <h3 class="modal-title">Confirmar desativação</h3>

        <p class="modal-text">
            Deseja desativar o usuário <strong>@Model.Nome</strong>?<br>
            A conta perderá o acesso, mas os históricos serão preservados e ela poderá ser reativada.
        </p>

        <div class="button-container">
            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel wizard-btn btn-prev" id="cancelDeleteBtn">
                    Cancelar
                </button>

                <form asp-controller="Users" asp-action="Delete" method="post" asp-route-id="@Model.IdUsuario">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-modal-confirm wizard-btn btn-next">
                        Sim, desativar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.main-form');
            const inputFields = form.querySelectorAll('.clean-input, select.clean-input, input[type="checkbox"]');
            const editSaveBtn = document.getElementById('edit-save-btn');

            // Variáveis de controle
            let isEditMode = false;
            let isSubmitting = false;

            // Configurar estado dos campos
            function setPageState() {
                if (isEditMode) {
                    // Modo edição ativo
                    inputFields.forEach(field => {
                        // Perfil, status e senha podem permanecer bloqueados conforme a permissão.
                        if (field.dataset.locked !== 'true') {
                            field.disabled = false;
                        }
                    });
                    editSaveBtn.innerHTML = '<i class="fa-solid fa-check"></i> Salvar Alterações';
                    editSaveBtn.setAttribute('type', 'submit');
                    editSaveBtn.classList.remove('btn-next');
                    editSaveBtn.classList.add('btn-save-final');
                } else {
                    // Modo visualização
                    inputFields.forEach(field => field.disabled = true);
                    editSaveBtn.innerHTML = '<i class="fa-solid fa-edit"></i> Editar';
                    editSaveBtn.setAttribute('type', 'button');
                    editSaveBtn.classList.remove('btn-save-final');
                    editSaveBtn.classList.add('btn-next');
                }
            }

            // Preencher os selects com os valores atuais do modelo
            function populateSelects() {
                // Preencher gênero
                const generoSelect = document.querySelector('select[name="Genero"]');
                if (generoSelect && '@Model.Genero') {
                    generoSelect.value = '@Model.Genero';
                }

                // Preencher status
                const ativoSelect = document.querySelector('select[name="Ativo"]');
                if (ativoSelect && '@Model.Ativo') {
                    ativoSelect.value = '@Model.Ativo';
                }
            }

            // Inicializar estado (visualização)
            setPageState();
            populateSelects();

            // Handler do botão editar/salvar
            editSaveBtn.addEventListener('click', function (e) {
                if (editSaveBtn.getAttribute('type') === 'submit') {
                    // Se for submit, validar antes de enviar
                    e.preventDefault();

                    if (!isSubmitting && form.checkValidity()) {
                        // Confirmar alteração de senha
                        const senhaInput = document.querySelector('input[name="Senha"]');
                        if (senhaInput.value && senhaInput.value === '@Model.Senha') {
                            if (!confirm('A senha não foi alterada. Deseja continuar?')) {
                                return;
                            }
                        }

                        isSubmitting = true;
                        editSaveBtn.disabled = true;
                        editSaveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processando...';
                        form.submit();
                    } else {
                        // Mostrar validações
                        form.reportValidity();
                    }
                } else {
                    // Alternar para modo edição
                    e.preventDefault();
                    isEditMode = true;
                    setPageState();
                    // Focar no primeiro campo editável
                    const firstInput = form.querySelector('input:not([disabled]):not([type="hidden"]):not([readonly])');
                    if (firstInput) firstInput.focus();
                }
            });

            // Lógica do modal de exclusão
            const deleteModal = document.getElementById('deleteConfirmationModal');
            const openDeleteBtn = document.getElementById('openDeleteModalBtn');
            const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');

            if (openDeleteBtn) {
                openDeleteBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    deleteModal.style.display = 'flex';
                    setTimeout(() => {
                        deleteModal.classList.add('active');
                    }, 10);
                });
            }

            if (cancelDeleteBtn) {
                cancelDeleteBtn.addEventListener('click', function () {
                    closeDeleteModal();
                });
            }

            // Fechar modal ao clicar fora
            window.addEventListener('click', function (e) {
                if (e.target === deleteModal) {
                    closeDeleteModal();
                }
            });

            // Fechar modal com ESC
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && deleteModal.classList.contains('active')) {
                    closeDeleteModal();
                }
            });

            function closeDeleteModal() {
                deleteModal.classList.remove('active');
                setTimeout(() => {
                    deleteModal.style.display = 'none';
                }, 300);
            }

            // Validação em tempo real para campos obrigatórios
            const requiredFields = form.querySelectorAll('[required]');
            requiredFields.forEach(field => {
                field.addEventListener('blur', function () {
                    if (!this.value || (typeof this.value === 'string' && !this.value.trim())) {
                        this.classList.add('invalid');
                        this.closest('.input-card').classList.add('invalid');
                    } else {
                        this.classList.remove('invalid');
                        this.closest('.input-card').classList.remove('invalid');
                    }
                });
            });
        });
    </script>
}
