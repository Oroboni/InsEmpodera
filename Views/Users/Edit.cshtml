@model Empodera.Models.Usuario
@{
    ViewData["Title"] = "Detalhes de Usuário";
    ViewData["PageCSS"] = "usuarios-edit"; 
    Layout = null; // IMPORTANTE: Define Layout como null para que esta View não use o _Layout.cshtml
}
<head>
    <link rel="stylesheet" href="~/css/pages/usuarios-edit.css">
</head>

<div class="modal-dialog-content">
    
    <div class="modal-header">
        <h3 class="modal-title">Editar Usuario</h3>
        <button type="button" class="close-button" onclick="window.location.href='/Users/Index'">
            &times;
        </button>
    </div>

    <div class="modal-body">  
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }      
        <form asp-action="Edit" method="post">

            <div class="form-group">
                <label class="control-label">Nome</label>
                <input class="form-control" asp-for="Nome" value="@Model.Nome" required/>
            </div>
            
            <div class="form-group">
                <label  class="control-label">E-mail</label>
                <input class="form-control" asp-for="Email" value="@Model.Email" readonly/>
            </div>

            <div class="form-group">
                <label  class="control-label">Senha</label>
                <input class="form-control" asp-for="Senha" value="@Model.Senha" required/>
            </div>

            <div class="form-group">
                <label for="genero">Gênero</label>
                <div class="select-wrapper">
                    <i class="fa-solid fa-venus-mars"></i>
                    <select class="form-control" id="Genero" asp-for="Genero" name="Genero">
                        <option value="feminino">Feminino</option>
                        <option value="masculino">Masculino</option>
                        <option value="nao-declarado">Não declarado</option>
                        <option value="transgenero">Transgênero</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>
            
             <div class="form-group">
                <label class="control-label">Ocupação</label>
                <input class="form-control" asp-for="Ocupacao" value="@Model.Ocupacao" />
            </div>
           
            <div class="form-group">
                <label class="control-label">Perfil de acesso *</label>
                <select class="form-control" asp-for="FkIdPerfil" asp-items="ViewBag.PerfilLista" required></select>
            </div>

            <div class="form-group">
                <label class="control-label">Ativo</label>
                <select class="form-control" asp-for="Ativo">
                    <option value="S">Sim</option>
                    <option value="N">Não</option>
                </select>
            </div>

            <div class="form-actions">
                <button class="btn-save" type="submit">Salvar</button>
            </div>
        </form>
    </div>
</div>