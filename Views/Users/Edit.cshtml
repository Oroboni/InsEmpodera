@{
    ViewData["Title"] = "Detalhes de Usuário";
    Layout = null; // IMPORTANTE: Define Layout como null para que esta View não use o _Layout.cshtml
}
<head>
    <style>
        /* Container que cobre a tela toda */
        body {
            background-color: #f7f7f7; /* Cor de fundo da sua tela principal */
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        /* O "Modal" em si */
        .modal-dialog-content {
            position: fixed; /* Fixa o modal */
            top: 0;
            left: 0;         /* <-- MUDAR: Garante que comece do canto superior esquerdo */
            right: 0;        /* <-- MUDAR: Estica a largura total (ou use width: 100%) */
            width: 100%;     /* <-- MUDAR: Garante a largura total */
            height: 100vh;   /* Altura total da tela */
            background-color: white; /* Cor de fundo */
            box-shadow: none; /* <-- Opcional: Remova a sombra de painel lateral */
            overflow-y: auto; /* Adiciona scroll se o conteúdo for grande */
            z-index: 1050;
        }

        /* Cabeçalho do Modal */
        .modal-header {
            background-color: #343a40; /* Cor escura do cabeçalho */
            color: white;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #7A3288;
        }

        .modal-title {
            margin: 0;
            font-size: 18px;
        }

        .close-button {
            background: none;
            border: none;
            color: white;
            font-size: 30px;
            cursor: pointer;
            line-height: 1;
        }

        /* Corpo do Modal */
        .modal-body {
            padding: 30px 20px;
            justify-self: center;
            width: 80%;
        }

        /* Estilo para a foto de perfil circular */
        .profile-photo-container {
            text-align: center;
            margin-bottom: 30px;
        }

        .profile-photo {
            width: 150px;
            height: 150px;
            border-radius: 50%; /* Torna a imagem circular */
            object-fit: cover;
            background-color: #e0e0e0; /* Placeholder cinza */
            border: 1px solid #ccc;
            padding: 5px;
        }

        /* Estilo dos campos de formulário */
        .form-group {
            margin-bottom: 20px;
        }

        .control-label {
            display: block;
            font-size: 12px;
            color: #555;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border: none;
            border-bottom: 1px solid #ccc; /* Linha inferior como na imagem */
            font-size: 16px;
            outline: none;

            /* === PROPRIEDADES CHAVE PARA O RISCO AO REDOR === */
            border: 1px solid #ccc; /* Borda cinza clara de 1px em todos os 4 lados */
            border-radius: 4px; /* Opcional: Adiciona cantos levemente arredondados */
            background-color: white; /* Garante que o fundo seja branco */
            /* ============================================== */

            transition: border-color 0.3s;
            background-color: transparent;
        }

        /* Estilo para campos somente leitura (readonly) */
        .form-control[readonly] {
            background-color: #f9f9f9; 
            cursor: default;
        }

        /* Estilo para o Select (Perfil de acesso) */
        .form-control:not([readonly]) {
            cursor: pointer;
        }
    </style>
</head>

<div class="modal-dialog-content">
    
    <div class="modal-header">
        <h3 class="modal-title">Detalhes de Usuário (Placeholder)</h3>
        <button type="button" class="close-button" onclick="window.location.href='/Users/Index'">
            &times;
        </button>
    </div>

    <div class="modal-body">
        
        <div class="profile-photo-container">
            <img src="~/img/placeholder-profile.png" alt="Foto do Usuário" class="profile-photo" /> 
        </div>
        
        <form asp-action="Edit">
            <input type="hidden" value="999" /> @* ID Fixo, sem asp-for *@
            
            <div class="form-group">
                <label class="control-label">Nome</label>
                <input class="form-control" readonly value="Usuário Fixo de Teste" />
            </div>
            
            <div class="form-group">
                <label  class="control-label">E-mail</label>
                <input class="form-control" readonly value="placeholder.teste@empodera.com" />
            </div>
            
             <div class="form-group">
                <label class="control-label">Ocupação</label>
                <input class="form-control" readonly value="Analista de Placeholder" />
            </div>
            
             <div class="form-group">
                <label class="control-label">Dt. Criação</label>
                <input class="form-control" readonly value="15/05/2025" />
            </div>
           
            <div class="form-group">
                <label class="control-label">Perfil de acesso *</label>
                <select class="form-control" disabled>
                    <option value="Operador">Operador</option>
                    <option value="Admin" selected>Admin (Fixo)</option>
                </select>
            </div>

            <div class="form-actions">
                @* <button type="submit" class="btn-save">Salvar</button> *@
            </div>
        </form>
    </div>
</div>