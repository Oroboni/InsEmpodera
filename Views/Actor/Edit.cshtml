@model Empodera.Models.Ator
@{
    ViewData["Title"] = "Detalhes do Ator";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/atores.css">
}

<div class="container">
    <div class="breadcrumb">
        <h1>Atores > <strong>Detalhes</strong></h1>
    </div>
    
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="IdAtores" />

        <div class="form-group">
             <label for="comunidadeId">Comunidade</label>
            <div class="select-wrapper">
                <i class="fa-solid fa-city"></i>
                <select id="comunidadeId" name="comunidadeId" asp-items="ViewBag.Comunidades" required>
                    <option value="">Selecione a comunidade</option>
                </select>
                 <i class="fa-solid fa-chevron-down select-arrow"></i>
            </div>
        </div>
                
        <div class="form-group">
            <label for="nome">Nome</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-user"></i>
                <input asp-for="Nome" type="text" placeholder="Adicione o nome da comunidade aqui...">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
            <label for="dataNascimento">Data de Nascimento</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-calendar-days"></i>
                @* <input asp-for="DtNascimento" type="date"> *@
                <input type="date" id="dataNascimento" name="dataNascimento">
            </div>
        </div>
            <div class="form-group">
                <label for="genero">Gênero</label>
                <div class="input-wrapper select-wrapper">
                    <i class="fa-solid fa-venus-mars"></i>
                    <select asp-for="Genero">
                        <option value="" disabled selected>Selecione</option>
                        <option value="Feminino">Feminino</option>
                        <option value="Masculino">Masculino</option>
                        <option value="NaoDeclarado">Não declarado</option>
                        <option value="Transgenero">Transgênero</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>
        </div>

        <div class="form-group-checkbox">
            <input type="checkbox" id="da-equipe" name="da-equipe">
            <label for="da-equipe">Da Equipe</label>
        </div>

        <div class="form-group">
            <label for="papel-social">Papel Social</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-people-group"></i>
                <input asp-for="PapelSocial1" type="text" placeholder="Adicione o papel social aqui...">
            </div>
        </div>

        <div class="form-group">
            <label for="interesses">Interesses</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-heart"></i>
                <input asp-for="PapelSocial2" type="text" placeholder="Adicione os interesses aqui...">
            </div>
        </div>
        
        <div class="form-group">
            <label for="telefone">Telefone</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-phone"></i>
                <input asp-for="Telefone" type="tel" placeholder="Adicione o telefone aqui...">
            </div>
        </div>

        <div class="actions-grid">
            <button type="button" class="action-card">
                <span class="card-title">Rede Primária</span>
                <span class="card-subtitle">Adicionar Ator</span>
                <div class="card-icons">
                    <i class="fa-solid fa-plus"></i>
                    <i class="fa-solid fa-eye"></i>
                </div>
            </button>
            <button type="button" class="action-card">
                <span class="card-title">Adjacência</span>
                <span class="card-subtitle">da RPP</span>
                <div class="card-icons">
                    <i class="fa-solid fa-eye"></i>
                </div>
            </button>
            <button type="button" class="action-card">
                <span class="card-title">Avaliações</span>
                <span class="card-subtitle">Pessoais</span>
                <div class="card-icons">
                    <i class="fa-solid fa-pen"></i>
                </div>
            </button>
            <button type="button" class="action-card">
                <span class="card-title">Diário de</span>
                <span class="card-subtitle">Processos Pessoal</span>
                <div class="card-icons">
                    <i class="fa-solid fa-book"></i>
                </div>
            </button>
        </div>

        <details class="form-footer" open>
            <summary>
                <div class="footer-text">
                    <span>Última atualização em <strong>@Model.DtModificacao.ToString("dd/MM/yyyy")</strong> por <strong>@Context.Session.GetString("Nome")</strong></span>
                </div>
                <i class="fa-solid fa-chevron-down"></i>
            </summary>
            <div class="metadata-content">
                <div class="form-group">
                    <label>Criado por</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" value="[Nome do Criador]" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label>Atualizado por</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" value="@Context.Session.GetString("Nome")" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label>Data de criação</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-calendar-day"></i>
                        <input type="text" value="@Model.DtCriacao.ToString("dd/MM/yyyy - HH:mm")" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label>Última atualização</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-calendar-day"></i>
                        <input type="text" value="@Model.DtModificacao.ToString("dd/MM/yyyy - HH:mm")" readonly>
                    </div>
                </div>
            </div>
        </details>
        <div class="form-buttons">
            <button type="button" class="btn btn-delete">DELETAR</button>
            <a asp-controller="Actor" asp-action="Index" class="btn btn-secondary">VOLTAR</a>
            <button type="submit" class="btn btn-primary">SALVAR MUDANÇAS</button>
        </div>
    </form>
</div>