@model Empodera.Models.Atores
@{
    ViewData["Title"] = "Editar Ator";
    ViewData["PageCSS"] = "create-form";
}

<div class="container">
    <div class="container">
        <div class="breadcrumb">
            <h1>
                <a asp-controller="Actor" asp-action="Index">Atores</a>
                >
                <strong>Editar Ator</strong>
            </h1>
        </div>
    </div>

    <form asp-controller="Actor" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="IdAtores" type="hidden" />
        <input type="hidden" name="id" value="@Model.IdAtores" />

        <div class="form-group">
            <label>Comunidade</label>
            <div class="select-wrapper">
                <i class="fa-solid fa-city"></i>

                <select id="ComunidadeId" name="ComunidadeId" asp-items="ViewBag.Comunidades" required>
                    <option value="">Selecione a comunidade</option>
                </select>

                <i class="fa-solid fa-chevron-down select-arrow"></i>
            </div>
        </div>


        <div class="form-group create-field">
            <label for="nome">Nome</label>
            <div class="input-with-buttons">
                <div class="input-wrapper">
                    <i class="fa-solid fa-user"></i>
                    <input asp-for="Nome" type="text" placeholder="Nome do Ator" />
                </div>
                <button type="button" class="btn-icon" title="Adicionar Novo (na lista?)"><i
                        class="fa-solid fa-plus"></i></button>
                <button type="button" class="btn-icon" title="Importar (da lista?)"><i
                        class="fa-solid fa-arrow-right-to-bracket"></i></button>
            </div>
        </div>

        <div class="form-group">
            <label for="tipoRelacionamento">Tipo de relacionamento</label>
            <div class="select-wrapper">
                <i class="fa-solid fa-heart"></i> <select id="tipoRelacionamento" name="tipoRelacionamento">
                    <option value="">Selecione um tipo</option>
                    <option value="1">Amigo</option>
                    <option value="2">Colega de trabalho</option>
                    <option value="3">Conhecido</option>
                    <option value="4">Familiar</option>
                    <option value="5">Vizinho</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
            </div>
        </div>

        <details class="form-group multiselect-wrapper">
            <summary>
                <div class="select-wrapper">
                    <i class="fa-solid fa-star"></i> <span class="multiselect-placeholder">Recursos agregados</span>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </summary>
            <div class="multiselect-panel">
                <ul>
                    <li><input type="checkbox" id="r1"><label for="r1">Rede primária</label></li>
                    <li><input type="checkbox" id="r2"><label for="r2">Seguridade Social</label></li>
                    <li><input type="checkbox" id="r3"><label for="r3">Substâncias</label></li>
                    <li><input type="checkbox" id="r4"><label for="r4">Moradia</label></li>
                    <li><input type="checkbox" id="r5"><label for="r5">Prevenção</label></li>
                    <li><input type="checkbox" id="r6"><label for="r6">Assistência Básica</label></li>
                    <li><input type="checkbox" id="r7"><label for="r7">Educação</label></li>
                    <li><input type="checkbox" id="r8"><label for="r8">Saúde</label></li>
                    <li><input type="checkbox" id="r9"><label for="r9">Ocupação</label></li>
                    <li><input type="checkbox" id="r10"><label for="r10">Lazer</label></li>
                </ul>
            </div>
        </details>

        <details class="form-group multiselect-wrapper">
            <summary>
                <div class="select-wrapper">
                    <i class="fa-solid fa-shield-halved"></i> <span class="multiselect-placeholder">Vulnerabilidades
                        agregadas</span>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </summary>
            <div class="multiselect-panel">
                <ul>
                    <li><input type="checkbox" id="v1"><label for="v1">Rede primária</label></li>
                    <li><input type="checkbox" id="v2"><label for="v2">Seguridade Social</label></li>
                    <li><input type="checkbox" id="v3"><label for="v3">Substâncias</label></li>
                    <li><input type="checkbox" id="v4"><label for="v4">Moradia</label></li>
                    <li><input type="checkbox" id="v5"><label for="v5">Prevenção</label></li>
                    <li><input type="checkbox" id="v6"><label for="v6">Assistência Básica</label></li>
                    <li><input type="checkbox" id="v7"><label for="v7">Educação</label></li>
                    <li><input type="checkbox" id="v8"><label for="v8">Saúde</label></li>
                    <li><input type="checkbox" id="v9"><label for="v9">Ocupação</label></li>
                    <li><input type="checkbox" id="v10"><label for="v10">Lazer</label></li>
                </ul>
            </div>
        </details>

        <div class="form-row">
            <div class="form-group">
                <label for="genero">Gênero</label>
                <div class="select-wrapper">
                    <i class="fa-solid fa-venus-mars"></i>
                    <select id="Genero" asp-for="Genero" class="form-select">
                        <option value="feminino">Feminino</option>
                        <option value="masculino">Masculino</option>
                        <option value="nao-declarado">Não declarado</option>
                        <option value="transgenero">Transgênero</option>
                    </select>
                    <i class="fa-solid fa-chevron-down select-arrow"></i>
                </div>
            </div>

            <div class="form-group">
                <label for="dataNascimento">Data de Nascimento</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-calendar-day"></i>
                    <input asp-for="DtNascimento" type="date" placeholder="dd/mm/aaaa" />

                </div>
            </div>
        </div>

        <div class="form-group-checkbox">
            <input id="daEquipeCheckbox" name="daEquipe" type="checkbox" />
            <label for="daEquipeCheckbox">Da Equipe</label>
        </div>

        <div class="form-group">
            <label for="papelSocial1">Papel Social</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-briefcase"></i>
                <input id="papelSocial1" name="papelSocial1" asp-for="PapelSocial1" value="@Model.PapelSocial1"
                    type="text" placeholder="Digite o papel social" />
            </div>
        </div>

        <div class="form-group">
            <label for="papelSocial2">Papel Social</f>
                <div class="input-wrapper">
                    <i class="fa-solid fa-briefcase"></i>
                    <input id="papelSocial2" name="papelSocial2" asp-for="PapelSocial2" value="@Model.PapelSocial2"
                        type="text" placeholder="Digite outro papel social (opcional)" />
                </div>
        </div>

        <div class="form-group">
            <label for="telefone">Telefone</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-phone"></i>
                <input asp-for="Telefone" type="tel" value="@Model.Telefone" />
            </div>
        </div>

        <div class="form-buttons">
            <a asp-controller="Actor" asp-action="Index" class="btn btn-secondary">CANCELAR</a>
            <button type="submit" class="btn btn-primary">ATUALIZAR ATOR</button>
        </div>
    </form>
    <form asp-controller="Actor" asp-action="Delete" method="post" asp-route-id="@Model.IdAtores">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-delete">DELETAR</button>
    </form>
</div>