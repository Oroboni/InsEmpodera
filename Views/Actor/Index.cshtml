@* Isso dirá ao seu _Layout para carregar o CSS específico desta página *@
@{
    ViewData["Title"] = "Atores";
    ViewData["PageCSS"] = "atores-index";
}

<header class="main-header">
    <h1>Atores</h1>
    <div class="header-actions">
        <div class="search-bar">
            <input type="search" placeholder="Pesquise por atores...">
            <i class="fa-solid fa-search"></i>
        </div>
        <a asp-controller="Actor" asp-action="create" class="btn-add" title="Adicionar Novo Ator"> <i class="fa-solid fa-plus"></i> </a>
    </div>
</header>

<div class="actors-list-container">
    <ul class="actors-list">
        
        <li class="actor-item">
            <div class="actor-info">
                <p class="actor-name">Adaiane Zamonier - Dai</p>
                <span class="tag tag-processo">Em processo</span>
            </div>
            <div class="actor-actions">
                <a href="#" class="btn-action" title="Ação 1">
                    <i class="fa-solid fa-play"></i>
                </a>
                <a href="#" class="btn-action" title="Ver detalhes">
                    <i class="fa-solid fa-eye"></i>
                </a>
            </div>
        </li>

        <li class="actor-item">
            <div class="actor-info">
                <p class="actor-name">Adriana de Souza Santos</p>
                <span class="tag tag-diagnostico">Em diagnóstico</span>
            </div>
            <div class="actor-actions">
                <a href="#" class="btn-action" title="Ação 1">
                    <i class="fa-solid fa-play"></i>
                </a>
                <a href="#" class="btn-action" title="Ver detalhes">
                    <i class="fa-solid fa-eye"></i>
                </a>
            </div>
        </li>

        </ul>
</div>