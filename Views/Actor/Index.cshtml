@{
    ViewData["Title"] = "Atores";
    Layout = "_Layout";
    ViewData["DisableMainScroll"] = "true"; // <-- ADICIONE ESTA LINHA
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
