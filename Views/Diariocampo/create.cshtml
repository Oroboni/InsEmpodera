@model Empodera.Models.DiarioCampo

@{
    ViewData["Title"] = "Novo Diário de Campo";
    Layout = "_Layout";
    
    // Configuração dos Eixos
    var listaEixosCorretos = new List<dynamic> {
        new { IdEixo = 1, Nome = "Prevenção" },
        new { IdEixo = 2, Nome = "Ocupação" },
        new { IdEixo = 3, Nome = "Lazer" },
        new { IdEixo = 4, Nome = "Segurança Social" },
        new { IdEixo = 5, Nome = "Educação" },
        new { IdEixo = 6, Nome = "Saúde" },
        new { IdEixo = 7, Nome = "Assistência Básica" }
    };

    // Configuração dos Atores (JSON para o JS)
    string jsonAtores = "[]";
    if (ViewBag.Atores != null) {
        try { 
            var options = new System.Text.Json.JsonSerializerOptions {
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                WriteIndented = false
            };
            jsonAtores = System.Text.Json.JsonSerializer.Serialize(ViewBag.Atores, options);
        } catch { 
            jsonAtores = "[]";
        }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/diarioCampo.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        /* Estilos específicos para a listagem estilo Teia */
        .action-group-container { margin-bottom: 25px; }
        .action-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #eee; }
        .action-header label { font-weight: 700; color: #444; font-size: 0.95rem; display: flex; align-items: center; gap: 8px; }
        .btn-add-circle { background: var(--color-primary); color: white; border: none; border-radius: 50%; cursor: pointer; align-items: center; justify-content: center; transition: transform 0.2s; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .btn-add-circle:hover { background: var(--color-primary-dark); transform: scale(1.1); }
        .action-list-container { background: #fafafa; border-radius: 12px; padding: 15px; border: 1px dashed #ccc; min-height: 60px; }
        
        /* Grid de Checkboxes no Modal */
        .eixos-grid-modal { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
    </style>
}

<div class="modern-container">
    <div class="header-section">
        <h2>
            <a asp-action="Index" class="text-primary">Diários de Campo</a>
            <span class="separator">></span>
            <strong class="text-muted">Novo Registro</strong>
        </h2>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="main-form">
        @Html.AntiForgeryToken()

        <div class="section-label">Informações Básicas</div>

        <div class="input-card full-width">
            <div class="icon-box purple">
                <i class="fa-solid fa-city"></i>
            </div>
            <div class="input-content">
                <label for="FkIdComunidade">Comunidade <span class="text-danger">*</span></label>
                <select asp-for="FkIdComunidade" class="clean-input" required>
                    <option value="">Selecione uma comunidade...</option>
                    @if (ViewBag.Comunidades != null) {
                        foreach (dynamic item in ViewBag.Comunidades) {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple">
                <i class="fa-solid fa-calendar-day"></i>
            </div>
            <div class="input-content">
                <label asp-for="Data">Data <span class="text-danger">*</span></label>
                <input asp-for="Data" type="date" class="clean-input" required />
            </div>
        </div>

        <div class="input-card full-width" style="display: block;">
            <div class="icon-box purple" style="float: left; margin-right: 15px;">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div class="input-content">
                <label>Eixos Selecionados</label>
                <div class="eixos-options-grid">
                    @foreach (dynamic eixo in listaEixosCorretos) {
                        <label class="checkbox-card-label">
                            <input type="checkbox" name="EixosSelecionados" value="@eixo.IdEixo" id="eixo-@eixo.IdEixo">
                            <span data-i18n-text>@eixo.Nome</span>
                        </label>
                    }
                </div>
            </div>
            <div style="clear: both;"></div>
        </div>

        <div class="purple-divider"></div>
    
        <div class="section-label">Detalhamento</div>

        <div class="input-card full-width" style="position: relative; overflow: visible;">
            <div class="icon-box purple">
                <i class="fa-solid fa-align-left"></i>
            </div>
            <div class="input-content">
                <label asp-for="Descricao">Relato / Descrição</label>
                <textarea asp-for="Descricao" id="descricaoInput" class="clean-input" rows="6" placeholder="Digite aqui... Use para mencionar atores"></textarea>
                <ul id="mention-list"></ul>
            </div>
        </div>

        <div class="purple-divider"></div>

        <div class="section-label">Ações Realizadas</div>


        <div class="action-group-container">
            <div class="action-header">
                <label>
                    <i class="fa-solid fa-building" style="color: var(--color-primary);"></i>
                    Ações Institucionais (<span id="count-institucional">0</span> itens)
                </label>
                <button type="button" class="btn-add-circle" onclick="abrirModalAcao('institucional')" title="Adicionar Ação Institucional">
                    <i class="fa-solid fa-plus" style="font-size: 12px;"></i>
                </button>
            </div>

            <div id="container-institucional" class="action-list-container">
                <div class="empty-state-acoes" id="empty-institucional" style="text-align: center; color: #777; padding: 10px;">
                    <i class="fa-solid fa-building" style="font-size: 1.5rem; margin-bottom: 5px; color: #ccc;"></i>
                    <p style="font-size: 0.85rem; margin: 0;">Nenhum item encontrado</p>
                </div>
                </div>
        </div>

        <div class="purple-divider"></div>

        <div class="section-label">Localização</div>

        <div id="mapa-diario" style="height: 400px; width: 100%; border-radius: 12px; margin-bottom: 20px; background: #eee;"></div>

        <div class="input-card full-width">
            <div class="icon-box purple">
                <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="input-content">
                <label>Endereço Completo</label>
                <input asp-for="Localizacao" id="rua" class="clean-input" autocomplete="street-address" placeholder="Digite o endereço completo..." />
            </div>
        </div>

        <div class="grid-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-map-pin"></i></div>
                <div class="input-content">
                    <label>CEP</label>
                    <input type="text" id="cep" class="clean-input" placeholder="00000-000">
                </div>
            </div>
            
            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-hashtag"></i></div>
                <div class="input-content">
                    <label>Número</label>
                    <input type="text" id="numero" class="clean-input" placeholder="Nº">
                </div>
            </div>
        </div>

        <div class="purple-divider"></div>

        <div class="buttons-container">
            <a asp-action="Index" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="wizard-btn btn-next">
                <i class="fa-solid fa-check"></i> Salvar Diário
            </button>
        </div>
    </form>
</div>

<div id="modalAcao" class="modal-overlay action-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modalAcaoTitulo">
    <div class="modal-content action-modal-content">
        
        <div class="modal-header action-modal-header">
            <div>
                <h3 id="modalAcaoTitulo" class="modal-title">Detalhes de ação</h3>
                <p>Informe os dados da ação realizada.</p>
            </div>
            <button type="button" class="btn-close-modal" onclick="fecharModal('modalAcao')" aria-label="Fechar modal">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form id="formAdicionarAcao" class="action-modal-form">
            <input type="hidden" id="tipoAcaoInput" />

            <div class="input-card action-modal-field action-modal-field-wide action-modal-name">
                <div class="input-content no-icon">
                    <label>Nome <span class="text-danger">*</span></label>
                    <input type="text" id="nomeAcao" class="clean-input" required placeholder="Nome da ação..." />
                </div>
            </div>

            <div class="input-card action-modal-field action-modal-field-wide action-modal-axes">
                <div class="input-content no-icon">
                    <label>Eixos (Selecione um ou mais)</label>
                    
                    <div class="eixos-grid-modal">
                        @foreach (dynamic eixo in listaEixosCorretos) {
                            <label class="checkbox-card-label">
                                <input type="checkbox" 
                                       name="modalEixos" 
                                       value="@eixo.IdEixo" 
                                       data-nome="@eixo.Nome">
                                <span data-i18n-text>@eixo.Nome</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="input-card action-modal-field action-modal-field-wide action-modal-provider">
                <div class="input-content no-icon">
                    <label>Provedor externo <span class="text-danger">*</span></label>
                    <input type="text" id="provedorAcao" class="clean-input" required placeholder="Ex: UBS, Escola, Associação..." />
                </div>
            </div>

            <div class="input-card action-modal-field action-modal-actors">
                <div class="input-content no-icon">
                    <label>Atores</label>
                    <select id="atorAcao" class="clean-input">
                        <option value="">Selecione os atores</option>
                        @if (ViewBag.Atores != null) {
                             foreach (dynamic ator in ViewBag.Atores) {
                                 <option value="@ator.Id">@ator.Nome</option>
                             }
                        }
                    </select>
                </div>
            </div>

            <div class="input-card action-modal-field action-modal-quantity">
                <div class="input-content no-icon">
                    <label>Quantidade</label>
                    <input type="number" id="quantidadeAcao" class="clean-input" min="1" value="1" />
                </div>
            </div>

            <div class="modal-actions action-modal-actions">
                <button type="button" onclick="fecharModal('modalAcao')" class="wizard-btn action-modal-cancel">
                    Cancelar
                </button>
                <button type="button" onclick="salvarAcaoNoGrid()" class="wizard-btn btn-save-final btn-confirm">
                    <i class="fa-solid fa-plus"></i> ADICIONAR AÇÃO
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>
    <script src="~/js/app-maps.js"></script>
    <script src="~/js/diariocampo.js"></script>

    <script>
        // 1. Variáveis Globais
        var atoresDisponiveis = @Html.Raw(jsonAtores);
        var countEquipe = 0;
        var countInst = 0;

        document.addEventListener("DOMContentLoaded", function() {
            // Inicializa mapa com delay e segurança
            setTimeout(function() {
                if (typeof initMapSelector === 'function') {
                    var mapaDiv = document.getElementById('mapa-diario');
                    if(mapaDiv) {
                        initMapSelector('mapa-diario', 'rua', {
                            sourceInputId: 'rua',
                            manualInputId: 'rua',
                            showSearchControl: false
                        });
                    }
                }
            }, 200);
        });

        // 2. Funções Globais para o Modal
        function abrirModalAcao(tipo) {
            var inputTipo = document.getElementById('tipoAcaoInput');
            if(!inputTipo) {
                console.error("Erro: Input 'tipoAcaoInput' não encontrado no HTML do Modal.");
                return;
            }
            inputTipo.value = tipo;
            
            // Limpa campos
            if(document.getElementById('nomeAcao')) document.getElementById('nomeAcao').value = '';
            if(document.getElementById('provedorAcao')) document.getElementById('provedorAcao').value = '';
            if(document.getElementById('atorAcao')) document.getElementById('atorAcao').value = '';
            if(document.getElementById('quantidadeAcao')) document.getElementById('quantidadeAcao').value = '1';

            // Desmarca checkboxes
            const checkboxes = document.querySelectorAll('input[name="modalEixos"]');
            checkboxes.forEach(cb => cb.checked = false);

            var modal = document.getElementById('modalAcao');
            if(modal) {
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
                window.setTimeout(() => document.getElementById('nomeAcao')?.focus(), 0);
            }
        }

        function fecharModal(modalId) {
            var modal = document.getElementById(modalId);
            if (modal) {
                modal.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        }

        // Fecha ao clicar fora
        var modalEl = document.getElementById('modalAcao');
        if(modalEl) {
            modalEl.addEventListener('click', function(e) {
                if (e.target === this) fecharModal('modalAcao');
            });
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modalEl?.style.display === 'flex') fecharModal('modalAcao');
        });

        function salvarAcaoNoGrid() {
            // Captura com segurança
            const tipoEl = document.getElementById('tipoAcaoInput');
            const nomeEl = document.getElementById('nomeAcao');
            const provedorEl = document.getElementById('provedorAcao');
            const qtdEl = document.getElementById('quantidadeAcao');

            if(!tipoEl || !nomeEl || !provedorEl) {
                alert("Erro interno: Campos do modal não encontrados.");
                return;
            }

            const tipo = tipoEl.value;
            const nome = nomeEl.value;
            const provedor = provedorEl.value;
            const qtd = qtdEl ? qtdEl.value : '1';

            // Captura Checkboxes (Múltiplos)
            const checkboxesMarcados = document.querySelectorAll('input[name="modalEixos"]:checked');
            const eixosIds = Array.from(checkboxesMarcados).map(cb => cb.value);
            const eixosNomes = Array.from(checkboxesMarcados).map(cb => cb.getAttribute('data-nome')).join(', ');

            // Validações
            if (!nome) { alert("O campo Nome é obrigatório."); return; }
            if (eixosIds.length === 0) { alert("Selecione pelo menos um Eixo."); return; }
            if (!provedor) { alert("O campo Provedor Externo é obrigatório."); return; }

            // Define destino
            let containerID, emptyID, counterSpanID, badgeClass;
            
            if (tipo === 'equipe') {
                containerID = 'container-equipe';
                emptyID = 'empty-equipe';
                counterSpanID = 'count-equipe';
                badgeClass = 'tag-blue';
                
                countEquipe++;
                const counter = document.getElementById(counterSpanID);
                if(counter) counter.innerText = countEquipe;
            } else {
                containerID = 'container-institucional';
                emptyID = 'empty-institucional';
                counterSpanID = 'count-institucional';
                badgeClass = 'tag-purple';
                
                countInst++;
                const counter = document.getElementById(counterSpanID);
                if(counter) counter.innerText = countInst;
            }

            // Esconde msg vazia
            const emptyState = document.getElementById(emptyID);
            if(emptyState) emptyState.style.display = 'none';

            // Cria o item visual
            const container = document.getElementById(containerID);
            const itemDiv = document.createElement('div');
            itemDiv.className = 'action-list-item';
            
            itemDiv.style.background = '#fff';
            itemDiv.style.padding = '10px 15px';
            itemDiv.style.borderRadius = '8px';
            itemDiv.style.marginBottom = '8px';
            itemDiv.style.border = '1px solid #e0e0e0';
            itemDiv.style.display = 'flex';
            itemDiv.style.justifyContent = 'space-between';
            itemDiv.style.alignItems = 'center';

            const eixoDisplay = eixosNomes ? `<span style="font-size:0.75rem; color:#888;">• ${eixosNomes}</span>` : '';
            const timestamp = Date.now();

            // Gera inputs hidden para CADA eixo selecionado
            let inputsEixos = '';
            eixosIds.forEach((id) => {
                inputsEixos += `<input type="hidden" name="TempAcoes[${timestamp}].FkIdEixo" value="${id}" />`;
            });

            itemDiv.innerHTML = `
                <div style="flex: 1;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                        <strong style="color: #333;">${nome}</strong>
                        <span class="tag-item ${badgeClass}" style="font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; background: ${tipo==='equipe'?'#e3f2fd':'#f3e5f5'}; color: ${tipo==='equipe'?'#1565c0':'#7b1fa2'}; border: 1px solid ${tipo==='equipe'?'#90caf9':'#ce93d8'};">
                            ${tipo === 'equipe' ? 'Equipe' : 'Institucional'}
                        </span>
                    </div>
                    <div style="font-size: 0.8rem; color: #666;">
                        <i class="fa-solid fa-building"></i> ${provedor} 
                        ${eixoDisplay}
                        ${qtd > 1 ? ` &bull; <strong>${qtd}x</strong>` : ''}
                    </div>
                </div>
                <button type="button" onclick="removerItemGrid(this, '${tipo}')" style="background: none; border: none; color: #ef5350; cursor: pointer; padding: 5px;" title="Remover">
                    <i class="fa-solid fa-trash"></i>
                </button>
                
                <input type="hidden" name="TempAcoes.Index" value="${timestamp}" />
                <input type="hidden" name="TempAcoes[${timestamp}].Nome" value="${nome}" />
                <input type="hidden" name="TempAcoes[${timestamp}].Provedor" value="${provedor}" />
                <input type="hidden" name="TempAcoes[${timestamp}].Tipo" value="${tipo}" />
                <input type="hidden" name="TempAcoes[${timestamp}].Quantidade" value="${qtd}" />
                ${inputsEixos}
            `;

            if(container) container.appendChild(itemDiv);
            fecharModal('modalAcao');
        }

        function removerItemGrid(btn, tipo) {
            btn.closest('.action-list-item').remove();

            if (tipo === 'equipe') {
                countEquipe--;
                const counter = document.getElementById('count-equipe');
                if(counter) counter.innerText = countEquipe;
                if (countEquipe === 0) document.getElementById('empty-equipe').style.display = 'block';
            } else {
                countInst--;
                const counter = document.getElementById('count-institucional');
                if(counter) counter.innerText = countInst;
                if (countInst === 0) document.getElementById('empty-institucional').style.display = 'block';
            }
        }
    </script>
}
