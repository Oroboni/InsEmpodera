@model Empodera.Models.DiarioCampo

@{
    ViewData["Title"] = "Novo Diário de Campo";
    ViewData["PageCSS"] = "homepage";
    Layout = "_Layout";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/diarioCampoForm.css" />
}

<form asp-action="Create" method="post" enctype="multipart/form-data" class="main-form">
    @Html.AntiForgeryToken()

    <div class="modern-container">
        <!-- Header -->
        <div class="header-section">
            <h2>
                <a asp-controller="DiarioCampo" asp-action="Index" class="text-primary">Diário de Campo</a>
                <span class="separator">></span>
                <strong class="text-muted">Novo Registro</strong>
            </h2>
        </div>

        <!-- Comunidade -->
        <div class="input-card full-width">
            <div class="icon-box"><i class="fa-solid fa-users"></i></div>
            <div class="input-content">
                <label for="ComunidadeId">Comunidade <span class="text-danger">*</span></label>
                <select id="ComunidadeId" name="ComunidadeId" class="clean-input" required>
                    <option value="">Selecione uma comunidade</option>
                    <option value="1">Comunidade Exemplo A</option>
                    <option value="2">Comunidade Exemplo B</option>
                </select>
            </div>
        </div>

        <!-- Data -->
        <div class="input-card">
            <div class="icon-box purple"><i class="fa-solid fa-calendar"></i></div>
            <div class="input-content">
                <label for="DataDiario">Data <span class="text-danger">*</span></label>
                <input type="date" id="DataDiario" name="DataDiario" class="clean-input" required />
            </div>
        </div>

        <!-- Eixos múltiplos -->
        <div class="input-card full-width">
            <div class="icon-box"><i class="fa-solid fa-layer-group"></i></div>
            <div class="input-content">
                <label for="EixosMulti">Eixos <span class="text-danger">*</span></label>
                <select id="EixosMulti" name="EixosSelecionados" multiple class="clean-input" size="5" required>
                    <option value="1">Eixo 1</option>
                    <option value="2">Eixo 2</option>
                    <option value="3">Eixo 3</option>
                    <option value="4">Eixo 4</option>
                    <option value="5">Eixo 5</option>
                    <option value="6">Eixo 6</option>
                    <option value="7">Eixo 7</option>
                    <option value="8">Eixo 8</option>
                </select>
                <small class="text-muted">Mantenha Ctrl pressionado para selecionar múltiplos</small>
            </div>
        </div>

        <!-- Ações da Equipe -->
        <div class="purple-divider"></div>
        <div class="section-label">Ações da Equipe</div>

        <div id="atividadesContainer" class="actions-list-container">
            <!-- Itens serão adicionados aqui dinamicamente -->
        </div>

        <button type="button" class="wizard-btn btn-next" onclick="abrirModal('modalAtividade')">
            <i class="fa-solid fa-plus"></i> Adicionar Ação da Equipe
        </button>

        <!-- Ações Institucionais -->
        <div class="purple-divider"></div>
        <div class="section-label">Ações Institucionais</div>

        <div id="acoesInstitucionaisContainer" class="actions-list-container">
            <!-- Itens serão adicionados aqui dinamicamente -->
        </div>

        <button type="button" class="wizard-btn btn-next" onclick="abrirModal('modalInstitucional')">
            <i class="fa-solid fa-plus"></i> Adicionar Ação Institucional
        </button>

        <!-- Localização -->
        <div class="purple-divider"></div>
        <div class="section-label">Localização</div>

        <div class="two-columns">
            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-location-dot"></i></div>
                <div class="input-content">
                    <label for="cep">CEP</label>
                    <input type="text" id="cep" class="clean-input" onblur="buscarCEP()" maxlength="9"
                        placeholder="00000-000" />
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-hashtag"></i></div>
                <div class="input-content">
                    <label for="numero">Número</label>
                    <input type="text" id="numero" class="clean-input" placeholder="Nº" />
                </div>
            </div>
        </div>

        <div class="input-card full-width">
            <div class="icon-box purple"><i class="fa-solid fa-road"></i></div>
            <div class="input-content">
                <label for="rua">Rua</label>
                <input type="text" id="rua" class="clean-input" readonly
                    placeholder="Será preenchido automaticamente" />
            </div>
        </div>

        <div class="two-columns">
            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-map-marked"></i></div>
                <div class="input-content">
                    <label for="bairro">Bairro</label>
                    <input type="text" id="bairro" class="clean-input" readonly />
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-city"></i></div>
                <div class="input-content">
                    <label for="cidade">Cidade</label>
                    <input type="text" id="cidade" class="clean-input" readonly />
                </div>
            </div>
        </div>

        <div class="two-columns">
            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-flag"></i></div>
                <div class="input-content">
                    <label for="estado">Estado</label>
                    <input type="text" id="estado" class="clean-input" readonly />
                </div>
            </div>

            <div class="input-card">
                <div class="icon-box purple"><i class="fa-solid fa-diamond-turn-right"></i></div>
                <div class="input-content">
                    <label for="complemento">Complemento</label>
                    <input type="text" id="complemento" class="clean-input" placeholder="Apto, bloco, etc..." />
                </div>
            </div>
        </div>

        <!-- Mapa -->
        <div id="mapa-diario" class="default-map-container"></div>

        <!-- Anexos -->
        <div class="purple-divider"></div>
        <div class="section-label">Anexos e Descrição</div>

        <div class="input-card full-width">
            <div class="icon-box"><i class="fa-solid fa-paperclip"></i></div>
            <div class="input-content">
                <label for="Anexos">Anexos</label>
                <input type="file" name="Anexos" id="Anexos" class="clean-input" multiple />
                <small class="text-muted">Você pode selecionar múltiplos arquivos</small>
            </div>
        </div>

        <!-- Descrição -->
        <div class="input-card full-width">
            <div class="icon-box"><i class="fa-solid fa-align-left"></i></div>
            <div class="input-content">
                <label for="Descricao">Descrição</label>
                <textarea id="Descricao" name="Descricao" class="clean-input" rows="6"
                    placeholder="Digite @@ para mencionar atividade, ator ou comunidade"></textarea>
                <div id="mentionBox" class="mention-box"></div>
            </div>
        </div>

        <!-- Botões de Ação -->
        <div class="buttons-container">
            <a asp-action="Index" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

            <button type="submit" class="wizard-btn btn-next">
                <i class="fa-solid fa-save"></i> Salvar Diário
            </button>
        </div>
    </div>
</form>

<!-- MODAL: ADICIONAR AÇÃO DA EQUIPE -->
<div class="modal-overlay" id="modalAtividade">
    <div class="modal-content">
        <div class="modal-icon">
            <i class="fas fa-tasks"></i>
        </div>
        <h3 class="modal-title">Adicionar Ação da Equipe</h3>

        <div class="modal-form-group">
            <label>Selecione a atividade</label>
            <select id="atividadeLista" class="clean-input">
                <option value="">Escolha uma atividade</option>
                <option value="Escuta ativa">Escuta ativa</option>
                <option value="Dia das crianças">Dia das crianças</option>
                <option value="Acompanhamento do Projeto Semear">Acompanhamento do Projeto Semear</option>
            </select>
        </div>

        <div class="modal-form-group">
            <label>Atores</label>
            <select id="modalAtorAtividade" class="clean-input" multiple size="4">
                <option value="Educador">Educador</option>
                <option value="Coordenador">Coordenador</option>
                <option value="Apoio">Apoio</option>
            </select>
            <small class="text-muted">Mantenha Ctrl para selecionar múltiplos</small>
        </div>

        <div class="modal-form-group">
            <label>Quantidade</label>
            <input type="number" id="modalQtdAtividade" class="clean-input" min="1" value="1" />
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-modal-cancel wizard-btn btn-prev" onclick="fecharModal('modalAtividade')">
                Cancelar
            </button>
            <button type="button" class="btn-modal-confirm wizard-btn btn-next" onclick="confirmarAtividade()">
                Adicionar
            </button>
        </div>
    </div>
</div>

<!-- MODAL: AÇÃO INSTITUCIONAL -->
<div class="modal-overlay" id="modalInstitucional">
    <div class="modal-content">
        <div class="modal-icon">
            <i class="fas fa-building"></i>
        </div>
        <h3 class="modal-title">Adicionar Ação Institucional</h3>

        <div class="modal-form-group">
            <label>Nome</label>
            <input type="text" id="instNome" class="clean-input" placeholder="Nome da ação" />
        </div>

        <div class="modal-form-group">
            <label>Eixos</label>
            <select id="instEixo" class="clean-input" multiple size="4">
                <option value="1">Eixo 1</option>
                <option value="2">Eixo 2</option>
                <option value="3">Eixo 3</option>
            </select>
        </div>

        <div class="modal-form-group">
            <label>Provedor Externo</label>
            <input type="text" id="instProvedor" class="clean-input" placeholder="Nome do provedor" />
        </div>

        <div class="modal-form-group">
            <label>Atores</label>
            <select id="instAtores" class="clean-input" multiple size="4">
                <option value="Educador">Educador</option>
                <option value="Coordenador">Coordenador</option>
                <option value="Apoio">Apoio</option>
            </select>
        </div>

        <div class="modal-form-group">
            <label>Quantidade</label>
            <input type="number" id="instQtd" class="clean-input" min="1" value="1" />
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-modal-cancel wizard-btn btn-prev"
                onclick="fecharModal('modalInstitucional')">
                Cancelar
            </button>
            <button type="button" class="btn-modal-confirm wizard-btn btn-next" onclick="confirmarInstitucional()">
                Adicionar
            </button>
        </div>
    </div>
</div>

<script>
    const EIXOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object)ViewBag.Eixos));
    const ATIVIDADES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object)ViewBag.Atividades));
    const ATORES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object)ViewBag.Atores));
    const ACOES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object)ViewBag.Acoes));
</script>

@section Scripts {
    <script src="~/js/diariocampo.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Inicializar mapa
            if (typeof initMapSelector === 'function') {
                initMapSelector('mapa-diario', 'rua');
            }

            // Lógica dos modais
            window.abrirModal = function (modalId) {
                const modal = document.getElementById(modalId);
                modal.style.display = 'flex';
                setTimeout(() => modal.classList.add('active'), 10);
            };

            window.fecharModal = function (modalId) {
                const modal = document.getElementById(modalId);
                modal.classList.remove('active');
                setTimeout(() => modal.style.display = 'none', 300);
            };

            // Fechar ao clicar fora
            document.querySelectorAll('.modal-overlay').forEach(modal => {
                modal.addEventListener('click', function (e) {
                    if (e.target === this) {
                        fecharModal(this.id);
                    }
                });
            });

            // Fechar com ESC
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.modal-overlay.active').forEach(modal => {
                        fecharModal(modal.id);
                    });
                }
            });
        });
    </script>
}