@model Empodera.Models.DiarioCampo

@{
    ViewData["Title"] = "Detalhes do Diário de Campo";
    ViewData["PageCSS"] = "diariocampoform";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/DiarioCampoForm.css"/> 
    <link rel="stylesheet" href="~/css/pages/diarioCampo.css"/>
}

<h2 class="page-title">Detalhes do Diário de Campo</h2>

<div class="formulario">

    <!-- Comunidade -->
    <div class="form-group">
        <label>Comunidade</label>
        <div class="input readonly-box">Comunidade Exemplo A</div>
    </div>

    <!-- Data -->
    <div class="form-group">
        <label>Data</label>
        <div class="input readonly-box">25/11/2025</div>
    </div>

    <!-- Eixos múltiplos -->
    <div class="form-group">
        <label>Eixos Selecionados</label>
        <ul class="readonly-list">
            <li>Eixo 1</li>
            <li>Eixo 2</li>
        </ul>
    </div>

    <!-- Ações da Equipe -->
    <div class="form-group">
        <label>Ações da Equipe</label>
        <div class="itens-lista">
            <div class="item">
                <strong>Escuta ativa</strong><br />
                Atores: Educador, Apoio<br />
                Quantidade: 3
            </div>

            <div class="item">
                <strong>Acompanhamento do Projeto Semear</strong><br />
                Atores: Coordenador<br />
                Quantidade: 1
            </div>
        </div>
    </div>

    <!-- Ações Institucionais -->
    <div class="form-group">
        <label>Ações Institucionais</label>
        <div class="itens-lista">
            <div class="item">
                <strong>Roda de Conversa</strong><br />
                Eixos: 1, 2<br />
                Provedor: ONG XPTO<br />
                Atores: Educador<br />
                Quantidade: 3
            </div>

            <div class="item">
                <strong>Oficina Criativa</strong><br />
                Eixo: 3<br />
                Provedor: Parceiro ABC<br />
                Atores: Coordenador<br />
                Quantidade: 2
            </div>
        </div>
    </div>

    <!-- Localização -->
    <div class="form-group localizacao-wrapper">
        <label style="font-weight: 600; font-size: 16px;">Localização</label>

        <div class="localizacao-group">
            <div class="col">
                <label>CEP</label>
                <div class="input readonly-box">12345-678</div>
            </div>

            <div class="col">
                <label>Número</label>
                <div class="input readonly-box">100</div>
            </div>

            <div class="col local-rua">
                <label>Rua</label>
                <div class="input readonly-box">Rua Exemplo</div>
            </div>

            <div class="col">
                <label>Bairro</label>
                <div class="input readonly-box">Bairro Exemplo</div>
            </div>

            <div class="col">
                <label>Cidade</label>
                <div class="input readonly-box">São Paulo</div>
            </div>

            <div class="col local-estado">
                <label>Estado</label>
                <div class="input readonly-box">SP</div>
            </div>

            <div class="col local-complemento">
                <label>Complemento</label>
                <div class="input readonly-box">Bloco A</div>
            </div>
        </div>
    </div>

    <!-- Mapa -->
    <div class="form-group mapa-wrapper">
        <div id="mapaContainer">
            <iframe
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                allowfullscreen
                src="https://www.google.com/maps?q=Rua+Exemplo+100+São+Paulo+SP&output=embed">
            </iframe>
        </div>
    </div>

    <!-- Anexos -->
    <div class="form-group full-width">
        <label>Anexos</label>
        <ul class="readonly-list">
            <li><a href="#">foto1.jpg</a></li>
            <li><a href="#">documento.pdf</a></li>
        </ul>
    </div>

    <!-- Descrição -->
    <div class="form-group full-width">
        <label>Descrição</label>
        <div class="input readonly-box">
            Exemplo de descrição do diário de campo.
        </div>
    </div>

    <!-- Metadados -->
    <div class="form-group full-width">
        <label>Criado em</label>
        <div class="input readonly-box">25/11/2025 14:30 — João Silva</div>

        <label>Modificado em</label>
        <div class="input readonly-box">25/11/2025 15:00 — Maria Oliveira</div>
    </div>

    <!-- Botões -->
    <div class="buttons full-width">
        <a asp-action="Edit" class="btn-primary">Editar</a>
        <a asp-action="Index" class="btn-secondary">Voltar</a>
    </div>

</div>

