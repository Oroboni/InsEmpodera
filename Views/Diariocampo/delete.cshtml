@model Empodera.Models.DiarioCampo

@{
    ViewData["Title"] = "Excluir Diário";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <style>
        .delete-container {
            max-width: 600px;
            margin: 40px auto;
            background: #fff;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            text-align: center;
        }
        .warning-icon {
            font-size: 4rem;
            color: var(--color-danger);
            margin-bottom: 20px;
        }
        .info-summary {
            background: #fdf2f2;
            border: 1px solid #fecaca;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            text-align: left;
        }
    </style>
}

<div class="delete-container">
    <div class="warning-icon">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    
    <h2 style="color: var(--color-gray-800); margin-bottom: 10px;">Tem certeza?</h2>
    <p style="color: var(--color-gray-600);">Você está prestes a excluir este Diário de Campo. Esta ação é irreversível.</p>

    @if (Model != null)
    {
        <div class="info-summary">
            <p><strong>Data:</strong> @Model.Data.ToString("dd/MM/yyyy")</p>
            <p><strong>Comunidade:</strong> @(Model.Comunidade?.Nome ?? "-")</p>
            <p><strong>Descrição:</strong> @(Model.Descricao?.Length > 50 ? Model.Descricao.Substring(0,50) + "..." : Model.Descricao)</p>
        </div>
    }

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdDCampo" />
        
        <div class="buttons-container" style="justify-content: center; gap: 15px;">
            <a asp-action="Index" class="wizard-btn btn-prev">
                Cancelar
            </a>
            <button type="submit" class="wizard-btn btn-delete">
                <i class="fa-solid fa-trash"></i> Sim, Excluir
            </button>
        </div>
    </form>
</div>