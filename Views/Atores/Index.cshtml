@model IEnumerable<Empodera.Models.Atores>
@{
    ViewData["Title"] = "Lista de Atores";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css">
}

<div class="forms-container">

    <h2 class="page-title">Atores</h2>

    <div class="filter-bar">
        <div class="search-container">
            <div class="search-input-group">
                <div class="search-wrapper" asp-action="Index" method="get">
                    <input type="text" name="search" id="searchInput" value="@(ViewData["CurrentFilter"])"
                        placeholder="Procure pelo nome do ator" class="search-input" />
                    <button class="btn-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>

            <a asp-controller="Atores" asp-action="Create" class="btn-add" title="Adicionar Novo Ator">
                <i class="fa-solid fa-plus"></i>
            </a>
        </div>
    </div>



    <div class="forms-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var ator in Model)
            {
                <div class="form-item" data-nome="@ator.Nome?.ToLower()">
                    <div class="form-info">
                        <p class="name">@ator.Nome</p>
                        <div class="form-status">
                            @if (!string.IsNullOrEmpty(ator.PapelSocial1))
                            {
                                <p class="date">Papel: @ator.PapelSocial1</p>
                            }
                            @if (!string.IsNullOrEmpty(ator.Genero))
                            {
                                <span class="tag-item">@ator.Genero</span>
                            }
                        </div>
                    </div>
                    <div class="actions">
                        <a asp-controller="Atores" asp-action="Edit" asp-route-id="@ator.IdAtores" class="btn-action"
                            title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-records">
                Nenhum ator cadastrado ainda.
            </div>
        }
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.querySelector("#searchInput");
        const formItems = document.querySelectorAll(".form-item");
        const noRecords = document.querySelector(".no-records");

        searchInput.addEventListener("input", function () {
            const query = this.value.toLowerCase().trim();
            let hasVisibleItems = false;

            if (formItems.length > 0) {
                formItems.forEach(item => {
                    const name = item.querySelector(".name").textContent.toLowerCase();
                    const isVisible = name.includes(query);
                    item.style.display = isVisible ? "flex" : "none";

                    if (isVisible) {
                        hasVisibleItems = true;
                    }
                });
            }

            // Mostra mensagem se não encontrar resultados
            if (noRecords) {
                if (!hasVisibleItems && query !== "") {
                    noRecords.style.display = "block";
                    noRecords.innerHTML = `<p>Nenhum ator encontrado para: "${query}"</p>`;
                } else if (!hasVisibleItems) {
                    noRecords.style.display = "block";
                    noRecords.innerHTML = "<p>Nenhum ator cadastrado ainda.</p>";
                } else {
                    noRecords.style.display = "none";
                }
            }
        });

        // Limpar busca com a tecla ESC
        searchInput.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                this.value = "";
                this.dispatchEvent(new Event("input"));
            }
        });
    });
</script>