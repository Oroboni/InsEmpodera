@model IEnumerable<Empodera.Models.Atores>
@{
    ViewData["Title"] = "Atores";
    Layout = "_Layout";
    ViewData["PageCSS"] = "homepage";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css" asp-append-version="true" />
}

<div class="modern-container">
    <!-- Header -->
    <div class="header-section">
        <h2>
            <strong class="text-primary">Atores</strong>
        </h2>
    </div>


    @if (Model != null && Model.Any())
    {
        <!-- Estatísticas -->
        <button type="button" class="section-label indicadores-toggle" data-indicadores
                aria-expanded="true" title="Recolher ou mostrar os indicadores">
            <span>Indicadores</span>
            <i class="fa-solid fa-chevron-up indicadores-chevron" aria-hidden="true"></i>
        </button>
        <div class="actions-grid">
            <div class="action-card stats-card">
                <span class="card-title">@Model.Count()</span>
                <span class="card-subtitle">Total de Atores</span>
                <div class="card-icons">
                    <i class="fas fa-users"></i>
                </div>
            </div>

            @{
                var papeisUnicos = Model.Where(a => !string.IsNullOrEmpty(a.PapelSocial1))
                    .Select(a => a.PapelSocial1).Distinct().Count();
            }
            <div class="action-card stats-card stats-card-purple">
                <span class="card-title">@papeisUnicos</span>
                <span class="card-subtitle">Papéis Sociais</span>
                <div class="card-icons">
                    <i class="fas fa-briefcase"></i>
                </div>
            </div>

            @{
                var generos = Model.Where(a => a.Genero != 0)
                    .Select(a => a.Genero)
                    .Distinct()
                    .Select(g => g switch {
                        1 => "Masculino",
                        2 => "Feminino",
                        3 => "Transgênero",
                        _ => "Outro"
                    });
            }
            <div class="action-card stats-card stats-card-cyan">
                <span class="card-title">@ViewBag.qgenero.Count</span>
                <span class="card-subtitle">Gêneros</span>
                <div class="card-icons">
                    <i class="fas fa-venus-mars"></i>
                </div>
            </div>
        </div>
    }

    <!-- Barra de Busca -->
    <div class="search-container">
        <div class="search-input-group">
            <div class="search-wrapper">
                <input type="search" id="searchInput" placeholder="Busque pelo nome do ator..."
                    aria-label="Buscar atores" value="@(ViewData["CurrentFilter"])" />
                <button type="button" class="btn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>

        <a asp-controller="Services" asp-action="ExportAtores" class="btn-export"
           data-testid="exportar-atores"
           aria-label="Exportar atores para Excel" title="Exportar atores para Excel">
            <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
        </a>

        <button type="button" class="btn-add" 
            onclick="window.location.href='@Url.Action("Create", "Atores")'"
            title="Adicionar Novo Ator">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    @if (Model != null && Model.Any())
    {

        <!-- Lista de Atores -->
        <div class="purple-divider"></div>
        <div class="section-label">Todos os Atores</div>

        <div class="forms-list" id="atoresGrid">
            @foreach (var ator in Model)
            {
                <div class="form-item ator-item" data-nome="@ator.Nome?.ToLower()">
                    <div class="form-info">
                        <div class="item-header">
                            <div class="activity-icon activity-icon-purple">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="item-content">
                                <p class="name item-name">@ator.Nome</p>
                                
                                @if (!string.IsNullOrEmpty(ator.PapelSocial1))
                                {
                                    <p class="item-subtitle">
                                        <i class="fas fa-briefcase"></i>
                                        Papel: @ator.PapelSocial1
                                    </p>
                                }
                                
                                <div class="tag-list">
                                    @if (ator.Genero != 0)
                                    {
                                        var generoClass = ator.Genero switch {
                                            1 => "tag-blue",
                                            2 => "tag-purple",
                                            3 => "tag-trans",
                                            _ => "tag-default"
                                        };
                                        <span class="tag-item @generoClass">
                                            <i class="fas fa-venus-mars"></i>
                                            @(ator.Genero switch {
                                                1 => "Masculino",
                                                2 => "Feminino",
                                                3 => "Transgênero",
                                                _ => "Outro"
                                            })
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        <a class="btn-action" asp-controller="Atores" asp-action="Edit" 
                           asp-route-id="@ator.IdAtores" title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Nenhum ator cadastrado -->
        <div class="no-records">
            <div class="no-records-icon">
                <i class="fas fa-users"></i>
            </div>
            <h3>Nenhum ator cadastrado</h3>
            <p>Comece adicionando o primeiro ator ao sistema.</p>
            <button type="button" class="btn-save" 
                onclick="window.location.href='@Url.Action("Create", "Atores")'">
                <i class="fa-solid fa-plus"></i> Adicionar Primeiro Ator
            </button>
        </div>
    }

    <!-- Mensagem quando nenhum resultado for encontrado -->
    @if (Model != null && Model.Count() > 0)
    {
        <div class="lista-paginacao" id="atoresPaginacao">
            <span class="lista-paginacao-contador" aria-live="polite">
                Mostrando <strong id="atoresMostrando">0</strong> / <strong id="atoresTotal">0</strong>
            </span>
            <button type="button" class="wizard-btn btn-prev lista-paginacao-mais" id="atoresMostrarMais">
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i> Mostrar mais
            </button>
        </div>
    }

    <div class="no-records" id="noResultsMessage" style="display: none;">
        <div class="no-records-icon">
            <i class="fas fa-search"></i>
        </div>
        <h3>Nenhum ator encontrado</h3>
        <p>Tente ajustar os termos de busca.</p>
    </div>
</div>

@section Scripts {
    <script>
        // Busca sem acento e lista em páginas de 20 (antes todos os atores vinham de uma vez).
        document.addEventListener('DOMContentLoaded', function () {
            const POR_PAGINA = 20;
            const searchInput = document.getElementById('searchInput');
            const atoresGrid = document.getElementById('atoresGrid');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const atorItems = Array.from(document.querySelectorAll('.ator-item'));
            const btnMais = document.getElementById('atoresMostrarMais');
            const mostrando = document.getElementById('atoresMostrando');
            const total = document.getElementById('atoresTotal');
            const paginacao = document.getElementById('atoresPaginacao');
            const semAcento = texto => (texto || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
            let limite = POR_PAGINA;

            function filterAtores() {
                const searchTerm = semAcento(searchInput?.value);
                const encontrados = atorItems.filter(item => semAcento(item.getAttribute('data-nome')).includes(searchTerm));

                atorItems.forEach(item => { item.style.display = 'none'; });
                encontrados.slice(0, limite).forEach(item => { item.style.display = 'flex'; });

                const nada = encontrados.length === 0 && atorItems.length > 0;
                if (atoresGrid) atoresGrid.style.display = nada ? 'none' : 'flex';
                if (noResultsMessage) noResultsMessage.style.display = nada ? 'block' : 'none';
                if (paginacao) paginacao.hidden = nada;
                if (mostrando) mostrando.textContent = Math.min(limite, encontrados.length);
                if (total) total.textContent = encontrados.length;
                if (btnMais) btnMais.hidden = encontrados.length <= limite;
            }

            btnMais?.addEventListener('click', () => { limite += POR_PAGINA; filterAtores(); });

            if (searchInput) {
                searchInput.addEventListener('input', () => { limite = POR_PAGINA; filterAtores(); });
                searchInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        limite = POR_PAGINA;
                        filterAtores();
                    }
                });
            }
            filterAtores();
        });
    </script>
}
