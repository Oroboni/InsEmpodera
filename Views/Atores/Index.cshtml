@model IEnumerable<Empodera.Models.Atores>
@{
    ViewData["Title"] = "Atores";
    Layout = "_Layout";
    ViewData["PageCSS"] = "homepage";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/comunidadesDetalhes.css" />
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css"/>
}

<div class="modern-container">
    <!-- Header -->
    <div class="header-section">
        <h2>
            <strong class="text-primary">Atores</strong>
        </h2>
    </div>

    <!-- Barra de Busca -->
    <div class="search-container">
        <div class="search-input-group">
            <div class="search-wrapper">
                <input type="search" id="searchInput" placeholder="Busque pelo nome do ator..."
                    aria-label="Buscar atores" value="@(ViewData["CurrentFilter"])" />
                <button type="button" class="btn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>

        <button type="button" class="btn-add" 
            onclick="window.location.href='@Url.Action("Create", "Atores")'"
            title="Adicionar Novo Ator">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Estatísticas -->
        <div class="section-label">Resumo</div>
        <div class="actions-grid">
            <div class="action-card stats-card">
                <span class="card-title" style="font-size: var(--font-size-4xl);">@Model.Count()</span>
                <span class="card-subtitle">Total de Atores</span>
                <div class="card-icons">
                    <i class="fas fa-users"></i>
                </div>
            </div>

            @{
                var papeisUnicos = Model.Where(a => !string.IsNullOrEmpty(a.PapelSocial1))
                    .Select(a => a.PapelSocial1).Distinct().Count();
            }
            <div class="action-card stats-card" style="background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%);">
                <span class="card-title" style="font-size: var(--font-size-4xl);">@papeisUnicos</span>
                <span class="card-subtitle">Papéis Sociais</span>
                <div class="card-icons">
                    <i class="fas fa-briefcase"></i>
                </div>
            </div>

            @{
                var generosUnicos = Model.Where(a => !string.IsNullOrEmpty(a.Genero))
                    .Select(a => a.Genero).Distinct().Count();
            }
            <div class="action-card stats-card" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);">
                <span class="card-title" style="font-size: var(--font-size-4xl);">@generosUnicos</span>
                <span class="card-subtitle">Gêneros</span>
                <div class="card-icons">
                    <i class="fas fa-venus-mars"></i>
                </div>
            </div>
        </div>

        <!-- Lista de Atores -->
        <div class="purple-divider"></div>
        <div class="section-label">Todos os Atores</div>

        <div class="forms-list" id="atoresGrid">
            @foreach (var ator in Model)
            {
                <div class="form-item ator-item" data-nome="@ator.Nome?.ToLower()">
                    <div class="form-info" style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
                            <div class="activity-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                <i class="fas fa-user"></i>
                            </div>
                            <div style="flex: 1;">
                                <p class="name" style="margin: 0;">@ator.Nome</p>
                                
                                @if (!string.IsNullOrEmpty(ator.PapelSocial1))
                                {
                                    <p style="color: var(--color-gray-500); font-size: 0.875rem; margin: 0.25rem 0 0 0;">
                                        <i class="fas fa-briefcase" style="margin-right: 0.25rem;"></i>
                                        Papel: @ator.PapelSocial1
                                    </p>
                                }
                                
                                <div class="tag-list" style="margin-top: 0.5rem;">
                                    @if (!string.IsNullOrEmpty(ator.Genero))
                                    {
                                        var generoClass = ator.Genero.ToLower() switch {
                                            "masculino" => "tag-blue",
                                            "feminino" => "tag-purple",
                                            _ => "tag-default"
                                        };
                                        <span class="tag-item @generoClass">
                                            <i class="fas fa-venus-mars"></i>
                                            @ator.Genero
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        <a class="btn-action" asp-controller="Atores" asp-action="Edit" 
                           asp-route-id="@ator.IdAtores" title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Nenhum ator cadastrado -->
        <div class="no-records" style="padding: 3rem; text-align: center;">
            <div style="margin-bottom: 1.5rem;">
                <i class="fas fa-users" style="font-size: 4rem; color: var(--color-gray-400);"></i>
            </div>
            <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Nenhum ator cadastrado</h3>
            <p style="color: var(--color-gray-500); margin-bottom: 1.5rem;">
                Comece adicionando o primeiro ator ao sistema.
            </p>
            <button type="button" class="btn-save" 
                onclick="window.location.href='@Url.Action("Create", "Atores")'">
                <i class="fa-solid fa-plus"></i> Adicionar Primeiro Ator
            </button>
        </div>
    }

    <!-- Mensagem quando nenhum resultado for encontrado -->
    <div class="no-records" id="noResultsMessage" style="display: none; padding: 3rem; text-align: center;">
        <div style="margin-bottom: 1.5rem;">
            <i class="fas fa-search" style="font-size: 4rem; color: var(--color-gray-400);"></i>
        </div>
        <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Nenhum ator encontrado</h3>
        <p style="color: var(--color-gray-500);">
            Tente ajustar os termos de busca.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const atoresGrid = document.getElementById('atoresGrid');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const atorItems = document.querySelectorAll('.ator-item');

            // Função para filtrar atores
            function filterAtores() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                atorItems.forEach(item => {
                    const nome = item.getAttribute('data-nome') || '';
                    const matchesSearch = nome.includes(searchTerm);

                    if (matchesSearch) {
                        item.style.display = 'flex';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                // Mostrar/ocultar mensagem de "nenhum resultado"
                if (visibleCount === 0 && atorItems.length > 0) {
                    if (atoresGrid) atoresGrid.style.display = 'none';
                    if (noResultsMessage) noResultsMessage.style.display = 'block';
                } else {
                    if (atoresGrid) atoresGrid.style.display = 'flex';
                    if (noResultsMessage) noResultsMessage.style.display = 'none';
                }
            }

            // Event listener para busca
            if (searchInput) {
                searchInput.addEventListener('input', filterAtores);

                // Limpar busca ao pressionar ESC
                searchInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        filterAtores();
                    }
                });
            }
        });
    </script>
}