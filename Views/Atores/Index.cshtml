@model IEnumerable<Empodera.Models.Atores>
@{
    ViewData["Title"] = "Lista de Atores";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css">
}

<div class="forms-container">
    
    <h2 class="page-title">Atores</h2>

    <div class="filter-bar">
        <div class="search-container">
            <div class="search-input-group">
                <div class="search-wrapper">
                    <input type="text" id="searchInput" placeholder="Buscar por nome do ator...">
                    <button class="btn-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>

            <a asp-controller="Atores" asp-action="Create" class="btn-add" title="Adicionar Novo Ator">
                <i class="fa-solid fa-plus"></i>
            </a>
        </div>
    </div>

    <div class="forms-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var ator in Model)
            {
                <div class="form-item" data-nome="@ator.Nome?.ToLower()">
                    <div class="form-info">
                        <p class="name">@ator.Nome</p>
                        <div class="form-status">
                            @if (!string.IsNullOrEmpty(ator.PapelSocial1))
                            {
                                <p class="date">Papel: @ator.PapelSocial1</p>
                            }
                            @if (!string.IsNullOrEmpty(ator.Genero))
                            {
                                <span class="tag-item">@ator.Genero</span>
                            }
                        </div>
                    </div>
                    <div class="actions">
                        <a asp-controller="Atores" asp-action="Edit" asp-route-id="@ator.IdAtores" class="btn-action"
                            title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-records">
                Nenhum ator cadastrado ainda.
            </div>
        }
    </div>
</div>