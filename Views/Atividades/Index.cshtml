@model IEnumerable<Empodera.Models.Atividades>

@{
    ViewData["Title"] = "Atividades";
    Layout = "_Layout";
    ViewData["PageCSS"] = "homepage";
}

@section Styles {
    
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/activity-index.css" asp-append-version="true" />
}

<div class="modern-container">
    <!-- Header -->
    <div class="header-section">
        <h2>
            <strong class="text-primary">Atividades</strong>
        </h2>
    </div>

    <!-- Estatísticas -->
    <button type="button" class="section-label indicadores-toggle" data-indicadores
            aria-expanded="true" title="Recolher ou mostrar os indicadores">
        <span>Indicadores</span>
        <i class="fa-solid fa-chevron-up indicadores-chevron" aria-hidden="true"></i>
    </button>
    <div class="actions-grid">
        <div class="action-card stats-card">
            <span class="card-title" id="totalActivities">@Model.Count()</span>
            <span class="card-subtitle">Total de Atividades</span>
            <div class="card-icons">
                <i class="fas fa-tasks"></i>
            </div>
        </div>

        @{
            var eixosUnicos = Model.SelectMany(a => a.AtividadesEixos.Select(ae => ae.Eixo.Nome)).Distinct().Count();
        }
        <div class="action-card stats-card stats-card-purple">
            <span class="card-title">@eixosUnicos</span>
            <span class="card-subtitle">Eixos Diferentes</span>
            <div class="card-icons">
                <i class="fas fa-layer-group"></i>
            </div>
        </div>

        @{
            var atividadesComMultiplosEixos = Model.Count(a => a.AtividadesEixos.Count > 1);
        }
        <div class="action-card stats-card stats-card-cyan">
            <span class="card-title">@atividadesComMultiplosEixos</span>
            <span class="card-subtitle">Multidisciplinares</span>
            <div class="card-icons">
                <i class="fas fa-sitemap"></i>
            </div>
        </div>
    </div>

    <!-- Busca, filtro por eixo e novo -->
    @{
        var eixosFiltro = Model.SelectMany(a => a.AtividadesEixos.Select(ae => ae.Eixo))
            .DistinctBy(e => e.IdEixo)
            .OrderBy(e => e.Nome)
            .Select(e => new { e.Nome, Total = Model.Count(a => a.AtividadesEixos.Any(ae => ae.FkIdEixo == e.IdEixo)) })
            .ToList();
    }
    <div class="search-container">
        <div class="search-input-group">
            <div class="search-wrapper">
                <input type="search" id="searchActivitiesInput" placeholder="Busque por atividades..."
                    aria-label="Buscar atividades" />
                <button type="button" class="btn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>

        @if (eixosFiltro.Count > 0)
        {
            <div class="list-filter">
                <i class="fa-solid fa-filter list-filter-icon" aria-hidden="true"></i>
                <select id="filtroEixo" aria-label="Filtrar por eixo">
                    <option value="todos">Todos os eixos</option>
                    @foreach (var eixo in eixosFiltro)
                    {
                        <option value="@eixo.Nome.ToLower()">@eixo.Nome (@eixo.Total)</option>
                    }
                </select>
                <i class="fa-solid fa-chevron-down list-filter-arrow" aria-hidden="true"></i>
            </div>
        }

        <button type="button" class="btn-add" onclick="window.location.href='@Url.Action("Create", "Atividades")'"
            title="Adicionar Nova Atividade">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    <!-- Lista de Atividades -->
    <div class="purple-divider"></div>
    <div class="section-label">Todas as Atividades</div>

    <div class="forms-list" id="activitiesGrid">
        @if (Model != null && Model.Any())
        {
            @foreach (var atividade in Model)
            {

                var eixosString = string.Join("|", atividade.AtividadesEixos.Select(ae => ae.Eixo.Nome.ToLower()));

                <div class="form-item activity-item" data-nome="@atividade.Nome?.ToLower()" data-eixos="@eixosString">

                    <div class="form-info" style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
                            <div class="activity-icon">
                                <i class="fas fa-tasks"></i>
                            </div>
                            <div style="flex: 1;">
                                <p class="name" style="margin: 0;">@atividade.Nome</p>

                                @if (atividade.AtividadesEixos.Any())
                                {
                                    <div class="tag-list" style="margin-top: 0.5rem;">
                                        @foreach (var eixo in atividade.AtividadesEixos)
                                        {
                                            var eixoNome = eixo.Eixo.Nome;
                                            var tagClass = eixoNome.ToLower() switch
                                            {
                                                "prevenção" => "tag-blue",
                                                "ocupação" => "tag-green",
                                                "lazer" => "tag-yellow",
                                                "segurança social" => "tag-purple",
                                                "educação" => "tag-lightgreen",
                                                "saúde" => "tag-red",
                                                "assistência básica" => "tag-lightblue",
                                                _ => "tag-default"
                                            };
                                            <span class="tag-item @tagClass">@eixoNome</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        <a class="btn-eye" asp-controller="Atividades" asp-action="Edit" asp-route-id="@atividade.IdAtividade"
                            title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-records" style="padding: 3rem; text-align: center;">
                <div style="margin-bottom: 1.5rem;">
                    <i class="fas fa-tasks" style="font-size: 4rem; color: var(--color-gray-400);"></i>
                </div>
                <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Nenhuma atividade cadastrada</h3>
                <p style="color: var(--color-gray-500); margin-bottom: 1.5rem;">
                    Comece adicionando sua primeira atividade ao sistema.
                </p>
                <button type="button" class="btn-save" onclick="window.location.href='@Url.Action("Create", "Atividades")'">
                    <i class="fa-solid fa-plus"></i> Adicionar Primeira Atividade
                </button>
            </div>
        }
    </div>

    <!-- Mensagem quando nenhum resultado for encontrado -->
    <div class="no-records" id="noResultsMessage" style="display: none; padding: 3rem; text-align: center;">
        <div style="margin-bottom: 1.5rem;">
            <i class="fas fa-search" style="font-size: 4rem; color: var(--color-gray-400);"></i>
        </div>
        <h3 style="color: var(--color-gray-600); margin-bottom: 0.5rem;">Nenhuma atividade encontrada</h3>
        <p style="color: var(--color-gray-500);">
            Tente ajustar os filtros ou termos de busca.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchActivitiesInput');
            const activitiesGrid = document.getElementById('activitiesGrid');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const activityItems = document.querySelectorAll('.activity-item');
            const filtroEixo = document.getElementById('filtroEixo');

            let currentEixoFilter = 'todos';

            // Função para filtrar atividades
            function filterActivities() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                activityItems.forEach(item => {
                    const nome = item.getAttribute('data-nome') || '';
                    const eixos = item.getAttribute('data-eixos') || '';

                    // Verificar se corresponde à busca
                    const matchesSearch = nome.includes(searchTerm);

                    // Verificar se corresponde ao filtro de eixo
                    const matchesEixo = currentEixoFilter === 'todos' ||
                        eixos.split('|').includes(currentEixoFilter);

                    const shouldShow = matchesSearch && matchesEixo;

                    if (shouldShow) {
                        item.style.display = 'flex';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                // Mostrar/ocultar mensagem de "nenhum resultado"
                if (visibleCount === 0 && activityItems.length > 0) {
                    activitiesGrid.style.display = 'none';
                    noResultsMessage.style.display = 'block';
                } else {
                    activitiesGrid.style.display = 'flex';
                    noResultsMessage.style.display = 'none';
                }
            }

            // Event listener para busca
            searchInput.addEventListener('input', filterActivities);

            // Filtro por eixo (um único seletor)
            filtroEixo?.addEventListener('change', function () {
                currentEixoFilter = this.value;
                this.closest('.list-filter')?.classList.toggle('is-active', currentEixoFilter !== 'todos');
                filterActivities();
            });

            // Limpar busca ao pressionar ESC
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    searchInput.value = '';
                    filterActivities();
                }
            });
        });
    </script>
}