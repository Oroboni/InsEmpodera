@model Empodera.Models.Perfil

@{
    ViewData["Title"] = "Perfil de Acesso - Criar";
    ViewData["PageCSS"] = "access-profile-form";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/comunidadesDetalhes.css" />
    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/access-profile-form.css" />
}

<form asp-controller="AccessProfile" asp-action="Create" method="post" class="main-form">
    @Html.AntiForgeryToken()

    <div class="modern-container">
        <!-- Header -->
        <div class="header-section">
            <h2>
                <a asp-controller="AccessProfile" asp-action="Index" class="text-primary">Perfis de Acesso</a>
                <span class="separator">></span>
                <strong class="text-muted">Novo Perfil</strong>
            </h2>
        </div>

        <!-- Nome do Perfil -->
        <div class="input-card full-width">
            <div class="icon-box"><i class="fa-solid fa-shield-halved"></i></div>
            <div class="input-content">
                <label asp-for="Nome">Nome do Perfil <span class="text-danger">*</span></label>
                <input type="text" asp-for="Nome" class="clean-input" required
                       placeholder="Digite o nome do perfil de acesso" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
        </div>

        <!-- Tabela de Permissões -->
        <div class="purple-divider"></div>
        <div class="section-label">Permissões de Acesso</div>

        <div class="permissions-table-container">
            <table class="permissions-table">
                <thead>
                    <tr>
                        <th class="permission-name">Módulo</th>
                        <th class="permission-action">
                            <i class="fas fa-list"></i>
                            <span>Listar</span>
                        </th>
                        <th class="permission-action">
                            <i class="fas fa-eye"></i>
                            <span>Detalhar</span>
                        </th>
                        <th class="permission-action">
                            <i class="fas fa-plus"></i>
                            <span>Criar</span>
                        </th>
                        <th class="permission-action">
                            <i class="fas fa-edit"></i>
                            <span>Atualizar</span>
                        </th>
                        <th class="permission-action">
                            <i class="fas fa-trash"></i>
                            <span>Deletar</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var modulos = new[] {
                            new { Nome = "Usuários", Icone = "fa-users", Key = "Usuarios" },
                            new { Nome = "Perfis de Acesso", Icone = "fa-user-shield", Key = "Perfis" },
                            new { Nome = "Atividades", Icone = "fa-tasks", Key = "Atividades" },
                            new { Nome = "Comunidades", Icone = "fa-home", Key = "Comunidades" },
                            new { Nome = "Vulnerabilidades", Icone = "fa-exclamation-triangle", Key = "Vulnerabilidades" },
                            new { Nome = "Recursos", Icone = "fa-box", Key = "Recursos" },
                            new { Nome = "Diários de Campo", Icone = "fa-book", Key = "DiariosCampo" },
                            new { Nome = "Atores", Icone = "fa-user-friends", Key = "Atores" },
                            new { Nome = "Ficha de 1º Contato", Icone = "fa-file-alt", Key = "FichaContato" },
                            new { Nome = "Diários de Processo Pessoal", Icone = "fa-journal-whills", Key = "DiarioPessoal" },
                            new { Nome = "Avaliações Pessoais", Icone = "fa-star", Key = "Avaliacoes" },
                            new { Nome = "SER", Icone = "fa-chart-line", Key = "SER" }
                        };

                        var acoes = new[] { "Listar", "Detalhar", "Criar", "Atualizar", "Deletar" };

                        foreach (var modulo in modulos)
                        {
                            <tr>
                                <td class="module-name">
                                    <i class="fas @modulo.Icone"></i>
                                    <span>@modulo.Nome</span>
                                </td>
                                @foreach (var acao in acoes)
                                {
                                    <td>
                                        <label class="permission-switch">
                                            <input type="checkbox" name="Permissoes[@modulo.Key][@acao]">
                                            <span class="switch-slider"></span>
                                        </label>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Ações Rápidas -->
        <div class="quick-actions">
            <button type="button" class="wizard-btn btn-next" onclick="toggleAllPermissions(true)">
                <i class="fas fa-check-double"></i> Marcar Todas
            </button>
            <button type="button" class="wizard-btn btn-prev" onclick="toggleAllPermissions(false)">
                <i class="fas fa-times"></i> Desmarcar Todas
            </button>
        </div>

        <!-- Botões de Ação -->
        <div class="buttons-container">
            <a asp-controller="AccessProfile" asp-action="Index" class="wizard-btn btn-prev">
                <i class="fa-solid fa-arrow-left"></i> Voltar
            </a>

            <div class="action-buttons-group">
                <button type="submit" class="wizard-btn btn-next" id="create-btn">
                    <i class="fa-solid fa-plus"></i> Criar Perfil
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.main-form');
            const createBtn = document.getElementById('create-btn');
            let isSubmitting = false;

            // Handler do botão criar
            form.addEventListener('submit', function (e) {
                if (!isSubmitting && form.checkValidity()) {
                    isSubmitting = true;
                    createBtn.disabled = true;
                    createBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Criando...';
                } else if (!form.checkValidity()) {
                    e.preventDefault();
                }
            });
        });

        // Função para marcar/desmarcar todas as permissões
        function toggleAllPermissions(checked) {
            const checkboxes = document.querySelectorAll('.permissions-table input[type="checkbox"]');
            checkboxes.forEach(checkbox => {
                checkbox.checked = checked;
            });
        }
    </script>
}