@model Empodera.Models.Perfil
@{
    ViewData["Title"] = "Editar Perfil de Acesso";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/access-profile-form.css" />
    <link rel="stylesheet" href="~/css/pages/create-form.css" />
}

<div class="container">
    <div class="breadcrumb">
        <h1>Perfis de acesso > <strong>@Model.Nome</strong></h1>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="IdPerfil" />

        <div class="form-group">
            <label>Nome</label>
            <div class="input-wrapper">
                <i class="fa-solid fa-shield-halved"></i>
                <input asp-for="Nome" type="text" required />
            </div>
        </div>

        <table class="permission-table">
            <thead>
                <tr>
                    <th>Módulo</th>
                    <th>Listar</th>
                    <th>Detalhar</th>
                    <th>Criar</th>
                    <th>Atualizar</th>
                    <th>Deletar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Permissoes != null && Model.Permissoes.Any())
                {
                    for (int i = 0; i < Model.Permissoes.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Permissoes[i].Modulo
                                <input type="hidden" asp-for="Permissoes[@i].IdPermissoes" />
                                <input type="hidden" asp-for="Permissoes[@i].Modulo" />
                            </td>

                            @foreach (var prop in new[] { "PodeListar", "PodeDetalhar", "PodeCriar", "PodeAtualizar",
                                        "PodeDeletar" })
                            {
                                <td>
                                    <label class="switch">
                                        <input type="checkbox" name="Permissoes[@i].@(prop)" value="S"
                                            @(Model.Permissoes[i].GetType().GetProperty(prop)?.GetValue(Model.Permissoes[i])?.ToString()
                                                                            == "S" ? "checked" : "") />
                                        <span class="slider"></span>
                                    </label>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">Nenhuma permissão associada a este perfil.</td>
                    </tr>
                }
            </tbody>

        </table>

        <div class="form-buttons">
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
    </form>
</div>