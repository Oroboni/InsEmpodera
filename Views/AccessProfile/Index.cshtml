@model IEnumerable<Empodera.Models.Perfil>

@{
    ViewData["Title"] = "Perfis de Acesso";
    Layout = "_Layout";
    ViewData["PageCSS"] = "homepage";
}

@section Styles {

    <link rel="stylesheet" href="~/css/pages/fichaprimeirocontato.css" />
    <link rel="stylesheet" href="~/css/pages/site.css" />
    <link rel="stylesheet" href="~/css/pages/perfisacesso.css" />
}

<div class="modern-container">
    <!-- Header -->
    <div class="header-section">
        <h2>
            <strong class="text-primary">Perfis de Acesso</strong>
        </h2>
    </div>

    <!-- Barra de Busca -->
    <div class="search-container">
        <div class="search-input-group">
            <div class="search-wrapper">
                <input type="search" id="searchProfilesInput" placeholder="Busque por perfis de acesso..."
                    aria-label="Buscar perfis" />
                <button type="button" class="btn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>

        <button type="button" class="btn-add" onclick="window.location.href='@Url.Action("Create", "AccessProfile")'"
            title="Adicionar Novo Perfil">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    <!-- Estatísticas -->
    <div class="section-label">Resumo</div>
    <div class="actions-grid">
        <div class="action-card stats-card">
            <span class="card-title" id="totalProfiles">@Model.Count()</span>
            <span class="card-subtitle">Total de Perfis</span>
            <div class="card-icons">
                <i class="fas fa-user-shield"></i>
            </div>
        </div>

        <div class="action-card stats-card stats-card-active">
            <span class="card-title">@ViewBag.PerfisAtivos</span>
            <span class="card-subtitle">Perfis em Uso</span>
            <div class="card-icons">
                <i class="fas fa-users"></i>
            </div>
        </div>

        <div class="action-card stats-card stats-card-info">
            <span class="card-title">@ViewBag.TotalUsuarios</span>

            <span class="card-subtitle">Total de Usuários</span>
            <div class="card-icons">
                <i class="fas fa-user-friends"></i>
            </div>
        </div>
    </div>

    <!-- Lista de Perfis -->
    <div class="purple-divider"></div>
    <div class="section-label">Todos os Perfis</div>

    <div class="forms-list" id="profilesGrid">
        @if (Model != null && Model.Any())
        {
            @foreach (var perfil in Model)
            {
                var usuariosCount = perfil.Usuarios?.Count ?? 0;
                var usuariosAtivos = perfil.Usuarios?.Count(u => u.Ativo == "S") ?? 0;

                <div class="form-item profile-item" data-nome="@perfil.Nome?.ToLower()">

                    <div class="form-info">
                        <div class="profile-info-header">
                            <div class="form-icon">
                                <i class="fas fa-user-shield"></i>
                            </div>
                            <div class="profile-info-content">
                                <p class="name profile-name">
                                    @perfil.Nome
                                    @if (usuariosCount > 0)
                                    {
                                        <span class="user-count-badge">
                                            <i class="fas fa-users"></i>
                                            @usuariosCount @(usuariosCount == 1 ? "usuário" : "usuários")
                                        </span>
                                    }
                                </p>

                                @if (perfil.Permissoes != null && perfil.Permissoes.Any())
                                {
                                    <p class="date profile-permissions">
                                        <i class="fas fa-key"></i>
                                        @perfil.Permissoes.Count @(perfil.Permissoes.Count == 1 ? "permissão" : "permissões")
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="actions">
                        @if (usuariosAtivos > 0)
                        {
                            <div class="profile-status-badge status-active">
                                <i class="fas fa-circle"></i>
                                @usuariosAtivos ativo@(usuariosAtivos > 1 ? "s" : "")
                            </div>
                        }
                        else if (usuariosCount > 0)
                        {
                            <div class="profile-status-badge status-inactive">
                                <i class="fas fa-circle"></i>
                                Sem ativos
                            </div>
                        }
                        else
                        {
                            <div class="profile-status-badge status-unused">
                                <i class="fas fa-circle"></i>
                                Sem usuários
                            </div>
                        }

                        <a class="btn-eye" asp-controller="AccessProfile" asp-action="Edit" asp-route-id="@perfil.IdPerfil"
                            title="Ver detalhes">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-records">
                <div class="no-records-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <h3>Nenhum perfil cadastrado</h3>
                <p>Comece adicionando seu primeiro perfil de acesso ao sistema.</p>
                <button type="button" class="btn-save"
                    onclick="window.location.href='@Url.Action("Create", "AccessProfile")'">
                    <i class="fa-solid fa-plus"></i> Adicionar Primeiro Perfil
                </button>
            </div>
        }
    </div>

    <!-- Mensagem quando nenhum resultado for encontrado -->
    <div class="no-records" id="noResultsMessage" style="display: none;">
        <div class="no-records-icon">
            <i class="fas fa-search"></i>
        </div>
        <h3>Nenhum perfil encontrado</h3>
        <p>Tente ajustar os termos de busca.</p>
    </div>

    <!-- Informações sobre Permissões -->
    <div class="purple-divider"></div>
    <div class="section-label">Sobre Perfis de Acesso</div>

    <div class="info-cards-grid">
        <div class="info-card">
            <div class="info-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h4>Controle de Acesso</h4>
            <p>Gerencie permissões e restrições para diferentes tipos de usuários no sistema.</p>
        </div>

        <div class="info-card">
            <div class="info-icon">
                <i class="fas fa-users-cog"></i>
            </div>
            <h4>Gestão de Usuários</h4>
            <p>Cada perfil pode ter múltiplos usuários com as mesmas permissões e níveis de acesso.</p>
        </div>

        <div class="info-card">
            <div class="info-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h4>Segurança</h4>
            <p>Configure níveis de segurança adequados para proteger informações sensíveis.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchProfilesInput');
            const profilesGrid = document.getElementById('profilesGrid');
            const noResultsMessage = document.getElementById('noResultsMessage');
            const profileItems = document.querySelectorAll('.profile-item');

            // Função para filtrar perfis
            function filterProfiles() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                profileItems.forEach(item => {
                    const nome = item.getAttribute('data-nome') || '';
                    const matchesSearch = nome.includes(searchTerm);

                    if (matchesSearch) {
                        item.style.display = 'flex';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                // Mostrar/ocultar mensagem de "nenhum resultado"
                if (visibleCount === 0 && profileItems.length > 0) {
                    profilesGrid.style.display = 'none';
                    noResultsMessage.style.display = 'block';
                } else {
                    profilesGrid.style.display = 'flex';
                    noResultsMessage.style.display = 'none';
                }
            }

            // Event listener para busca
            searchInput.addEventListener('input', filterProfiles);

            // Limpar busca ao pressionar ESC
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    searchInput.value = '';
                    filterProfiles();
                }
            });
        });
    </script>
}