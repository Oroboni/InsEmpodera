@{
    ViewData["Title"] = "Relatório - Rede Primária";
    Layout = "_Layout";
    // Rolagem ativada (linha DisableMainScroll removida)
    
    int? selectedAtorId = ViewBag.SelectedAtorId;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/atores.css" />
    <link rel="stylesheet" href="~/css/pages/reports.css" />
}

<div class="report-page-container">
    <div class="report-breadcrumb">
    <h1>
        <a asp-controller="Report" asp-action="index">Relatórios</a> 
        > 
        <strong>Rede Primária</strong>
    </h1>
</div>
    <div class="report-content-box">
        <div class="report-filters">
            <form asp-action="PrimaryNetwork" method="get" id="atorSelectForm">
                <div class="form-group">
                    <label>Ator</label>
                    <div class="select-wrapper">
                        <i class="fa-solid fa-user"></i>
                        <select name="atorId" asp-items="ViewBag.AtorList" onchange="this.form.submit()">
                            <option value="">Selecione um Ator...</option>
                        </select>
                        <i class="fa-solid fa-chevron-down select-arrow"></i>
                    </div>
                </div>
            </form>
        </div>

        <div class="report-body">
            @if (selectedAtorId == null)
            {
                <div class="report-empty-state">
                    <img src="https://placehold.co/300x200/f0f0f0/6b7280?text=Ilustra%C3%A7%C3%A3o" alt="Selecione um ator" />
                    <p>Primeiro selecione um ator.</p>
                </div>
            }
            else
            {
                <div class="metric-card-row">
                    <div class="metric-card">
                        <div class="title">Amplitude</div>
                        <div class="value">2</div>
                    </div>
                    <div class="metric-card">
                        <div class="title">Densidade</div>
                        <div class="value">50.00%</div>
                    </div>
                    <div class="metric-card">
                        <div class="title">Centralidade</div>
                        <div class="value" style="font-size: 1rem; color: #666; margin-top: 10px;">
                            Nenhum item encontrado
                        </div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 40px; margin-top: 20px;">
                    
                    <div class="chart-container" style="max-width: 400px; margin: 0 auto;">
                        <canvas id="networkDonutChart"></canvas>
                    </div>

                    <div class="chart-container-bar" style="width: 100%; height: 400px;">
                        <canvas id="networkBarChart"></canvas>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js"></script>
}