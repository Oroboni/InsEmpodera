@{
    ViewData["Title"] = "Relatório - Fichas de 1º Contato";
    Layout = "_Layout";
    
    // Variável auxiliar para verificar se há comunidade selecionada
    bool temComunidade = !string.IsNullOrEmpty(Context.Request.Query["comunidadeId"]);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/reports.css" />
    
}

<div class="report-page-container">
    <div class="report-breadcrumb">
        <h1>
            <a asp-controller="Report" asp-action="index">Relatórios</a> 
            > 
            <strong>Fichas de 1º Contato</strong>
        </h1>
    </div>

    <div class="report-content-box">
        <div class="report-filters">
            
            <!-- Seleção Principal de Comunidade (SEMPRE VISÍVEL) -->
            <form asp-action="FirstContact" method="get" id="comunidadeForm" style="margin-bottom: @(temComunidade ? "20px" : "0");">
                <div class="form-group">
                    <label for="comunidadeId" style="font-weight: bold; font-size: 1rem;">Comunidade</label>
                    <div class="select-wrapper">
                        <i class="fa-solid fa-city"></i>
                        <select id="comunidadeId" name="comunidadeId" asp-items="ViewBag.ComunidadeList" onchange="this.form.submit()" style="border-color: #4f46e5; border-width: 2px;">
                            <option value="">Selecione uma comunidade...</option>
                        </select>
                        <i class="fa-solid fa-chevron-down select-arrow"></i>
                    </div>
                </div>
            </form>
            
            <!-- SÓ MOSTRA OS OUTROS FILTROS SE TIVER COMUNIDADE SELECIONADA -->
            @if (temComunidade)
            {
                <!-- Filtros Avançados (Começa FECHADO - sem o atributo 'open') -->
                <details class="filter-box">
                    <summary>
                        <span><i class="fa-solid fa-filter" style="margin-right: 8px;"></i> Filtros Avançados</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </summary>
                    
                    <div class="filter-grid">
                        <div class="form-group">
                            <label>Gênero</label>
                            <div class="select-wrapper">
                                <select name="genero" id="genero">
                                    <option value="" selected disabled>Todos</option>
                                    <option value="feminino">Feminino</option>
                                    <option value="masculino">Masculino</option>
                                    <option value="nao_declarado">Não declarado</option>
                                    <option value="transgenero">Transgênero</option>
                                </select>
                                <i class="fa-solid fa-chevron-down select-arrow"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Estrutura familiar</label>
                            <div class="select-wrapper">
                                <select name="estrutura_familiar" id="estrutura_familiar">
                                    <option value="" selected disabled>Todas</option>
                                    <option value="companheiro_sem_matrimonio">Companheiro/a sem matrimônio</option>
                                    <option value="familia_nuclear">Família nuclear</option>
                                    <option value="familia_sem_matrimonio_formal">Família sem matrimônio formal</option>
                                    <option value="mora_com_filhos">Mora com filhos/as</option>
                                    <option value="mora_sozinho">Mora sozinho</option>
                                    <option value="outro">Outro</option>
                                </select>
                                <i class="fa-solid fa-chevron-down select-arrow"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Condições 1º contato</label>
                            <div class="select-wrapper">
                                <select name="condicoes_primeiro_contato" id="condicoes_primeiro_contato">
                                    <option value="" selected disabled>Todas</option>
                                    <option value="analfabetismo">Analfabetismo</option>
                                    <option value="apoio_economico">Apoio econômico</option>
                                    <option value="capacitacao_formacao">Capacitação e formação</option>
                                    <option value="comportamental">Comportamental</option>
                                    <option value="condutas_antissociais">Condutas antissociais</option>
                                    <option value="crise_psicologica">Crise psicológica</option>
                                    <option value="deslocamento">Deslocamento</option>
                                    <option value="drogas_intravenosas">Drogas intravenosas</option>
                                    <option value="escolares">Escolares</option>
                                    <option value="estigma_identidade_sexual">Estigma por identidade sexual</option>
                                    <option value="exclusao_grave">Exclusão grave</option>
                                    <option value="gravidez_parto">Gravidez/parto</option>
                                    <option value="hiv_aids">HIV/AIDS</option>
                                    <option value="hepatite">Hepatite</option>
                                    <option value="ist">IST</option>
                                    <option value="incapacidade">Incapacidade</option>
                                    <option value="legal">Legal</option>
                                    <option value="migracao_imigracao">Migração/Imigração</option>
                                    <option value="organizacao_planejamento">Organização e planejamento</option>
                                    <option value="outras_dependencias">Outras dependências</option>
                                    <option value="pobreza_extrema">Pobreza extrema</option>
                                    <option value="problemas_saude">Problemas de saúde</option>
                                    <option value="problemas_familiares">Problemas familiares</option>
                                    <option value="problemas_sexuais">Problemas sexuais</option>
                                    <option value="psiquiatricas">Psiquiátricas</option>
                                    <option value="redes_interinstitucionais">Redes interinstitucionais</option>
                                    <option value="relacionais">Relacionais</option>
                                    <option value="sem_trabalho">Sem trabalho</option>
                                    <option value="substancias_alcool">Substâncias/álcool</option>
                                    <option value="trabalho_sexual">Trabalho sexual</option>
                                    <option value="transtorno_estresse_pos_traumatico">Transtorno estresse pós traumático</option>
                                    <option value="trafico_pessoas">Tráfico de pessoas</option>
                                    <option value="tuberculoso">Tuberculoso</option>
                                    <option value="vida_rua">Vida de rua</option>
                                    <option value="violacao_adulto">Violação de adulto</option>
                                    <option value="violacao_criancas">Violação de crianças</option>
                                    <option value="violencia_intracomunitaria">Violência intracomunitária</option>
                                    <option value="violencia_intrafamiliar">Violência intrafamiliar</option>
                                </select>
                                <i class="fa-solid fa-chevron-down select-arrow"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Resultados</label>
                            <div class="select-wrapper">
                                <select name="resultados" id="resultados">
                                    <option value="" selected disabled>Todos</option>
                                    <option value="inclusao_atividades">Inclusão em atividades</option>
                                    <option value="inicia_programa">Inicia um programa</option>
                                    <option value="interrompeu_contato">Interrompeu contato</option>
                                    <option value="seguiu_contato">Seguiu contato</option>
                                    <option value="veio_ao_encontro">Veio ao encontro</option>
                                </select>
                                <i class="fa-solid fa-chevron-down select-arrow"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Respostas</label>
                            <div class="select-wrapper">
                                <select name="respostas" id="respostas">
                                    <option value="" selected disabled>Todas</option>
                                    <option value="acolhida_dia_noite">Acolhida (dia ou noite)</option>
                                    <option value="acompanhamento">Acompanhamento</option>
                                    <option value="conselho_orientacao">Conselho/Orientação</option>
                                    <option value="cuidados_medicos">Cuidados médicos</option>
                                    <option value="da_se_informacao">Dá-se uma informação</option>
                                    <option value="encaminhamento">Encaminhamento</option>
                                    <option value="escuta_imediata_manejo_crise">Escuta imediata/manejo de crise</option>
                                    <option value="higiene_roupa_limpa">Higiene/Roupa limpa</option>
                                    <option value="indicacoes_sugestoes">Indicações, sugestões</option>
                                    <option value="marca_se_encontro">Marca-se um encontro</option>
                                </select>
                                <i class="fa-solid fa-chevron-down select-arrow"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Hora do 1º contato</label>
                            <div class="select-wrapper">
                                <select name="hora_primeiro_contato" id="hora_primeiro_contato">
                                    <option value="" selected disabled>Qualquer horário</option>
                                    <option value="06_12">Das 06:00 às 12:00</option>
                                    <option value="12_20">Das 12:01 às 20:00</option>
                                    <option value="20_06">Das 20:01 às 05:59</option>
                                </select>
                                <i class="fa-solid fa-chevron-down select-arrow"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Como se estabeleceu</label>
                            <div class="select-wrapper">
                                <select name="como_estabeleceu_contato" id="como_estabeleceu_contato">
                                    <option value="" selected disabled>Todos</option>
                                    <option value="outras_instituicoes">Em outras instituições</option>
                                    <option value="casa_pessoa">Na casa da pessoa</option>
                                    <option value="estrutura_organizacao">Na estrutura da organização</option>
                                    <option value="na_rua">Na rua</option>
                                    <option value="outro">Outro</option>
                                    <option value="por_telefone">Por telefone</option>
                                </select>
                                <i class="fa-solid fa-chevron-down select-arrow"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Escolaridade</label>
                            <div class="select-wrapper">
                                <select name="escolaridade" id="escolaridade">
                                    <option value="" selected disabled>Todas</option>
                                    <option value="sabe_calcular">Sabe calcular</option>
                                    <option value="sabe_ler_escrever">Sabe ler e escrever</option>
                                    <option value="sabe_usar_computador">Sabe usar o computador</option>
                                </select>
                                <i class="fa-solid fa-chevron-down select-arrow"></i>
                            </div>
                        </div>

                        <!-- Campos de Data -->
                        <div class="form-group">
                            <label>De (data)</label>
                            <div class="input-wrapper">
                                <input type="date" />
                                <i class="fa-solid fa-calendar"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Até (data)</label>
                            <div class="input-wrapper">
                                <input type="date" />
                                <i class="fa-solid fa-calendar"></i>
                            </div>
                        </div>

                        <!-- Botão de Filtrar para confirmar a ação -->
                        <div class="form-group" style="justify-content: flex-end;">
                             <label>&nbsp;</label> <!-- Espaço vazio para alinhar -->
                            <button type="button" class="btn btn-primary" style="height: 42px; width: 100%;">Aplicar Filtros</button>
                        </div>
                    </div>
                </details>
                
                <!-- Configurações de Visualização (fora do sanfona) -->
                <div class="report-type-filters">
                    <div class="form-group" style="flex: 1;">
                        <label>Tipo de Visualização</label>
                        <div class="select-wrapper">
                            <select name="tipo" id="tipo">
                                <option value="por_categoria">Por categoria</option>
                                <option value="por_tabela">Por tabela</option>
                            </select>
                            <i class="fa-solid fa-chevron-down select-arrow"></i>
                        </div>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label>Campo Principal *</label>
                        <div class="select-wrapper">
                            <select name="campo" id="campo">
                                <option value="" selected disabled>Selecione...</option>
                                <option value="como_estabeleceu_contato">Como se estabeleceu o primeiro contato</option>
                                <option value="emprego">Emprego</option>
                                <option value="estado">Estado</option>
                                <option value="estado_familiar">Estado familiar</option>
                                <option value="estrutura_familiar">Estrutura familiar</option>
                                <option value="genero">Gênero</option>
                                <option value="hora_primeiro_contato">Hora do primeiro contato</option>
                                <option value="local_tratamento">Local de tratamento</option>
                            </select>
                            <i class="fa-solid fa-chevron-down select-arrow"></i>
                        </div>
                    </div>
                </div>
            }
        </div> 
        
        <div class="report-body">
            @if (!temComunidade)
            {
                <div class="report-empty-state">
                    <img src="https://placehold.co/300x200/f0f0f0/6b7280?text=Ilustra%C3%A7%C3%A3o" alt="Selecione uma comunidade" />
                    <p>Primeiro selecione uma comunidade.</p>
                </div>
            }
            else
            {
                <div class="chart-container">
                    <canvas id="firstContactPieChart"></canvas>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js"></script>
}