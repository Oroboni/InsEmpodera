@{
    ViewData["Title"] = "Relatórios";
    ViewData["PageCSS"] = "reports";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/reports.css" />
}

<div class="report-page-container">
    <div class="report-breadcrumb">
        <h2 class="page-title">Relatórios</h2>
    </div>

    <div class="report-menu-group">
        <div class="report-card-grid">
            <form asp-action="RelatorioComunidade" method="post" enctype="multipart/form-data">
                <div class="report-card-content">
                    <h3>Selecione os arquivos</h3>

                    <input 
                        type="file" 
                        name="files" 
                        class="report-card-input"
                        accept=".xlsx,.xls"
                        multiple />
                </div>

                <button type="submit" class="report-card-button">
                    Importar Relatórios
                </button>
            </form>
        </div>
    </div>
</div>