@{
    ViewData["Title"] = "Senha alterada";
    Layout = "_LoginLayout";
}
@section Styles { <link rel="stylesheet" href="~/css/forget.css" /> }

<div class="background-circles" aria-hidden="true">
    <div class="circle circle-1"></div><div class="circle circle-2"></div>
    <div class="circle circle-3"></div><div class="circle circle-4"></div>
    <div class="circle circle-5"></div><div class="circle circle-6"></div>
</div>

<main class="container-geral confirmation-container" data-testid="reset-confirmation">
    <section class="painel-recovery confirmation-panel">
        <div class="confirmation-icon" aria-hidden="true">✓</div>
        <h2>Senha alterada com sucesso</h2>
        <p class="recovery-description">
            Sua nova senha já está ativa. Você pode voltar ao login e acessar o Empodera.
        </p>
        <a asp-action="Index" asp-controller="Account" class="recovery-button confirmation-link">Ir para o login</a>
    </section>
    <section class="painel-info">
        <h1>Tudo pronto</h1>
        <p>Para sua segurança, os acessos antigos foram invalidados.</p>
    </section>
</main>
