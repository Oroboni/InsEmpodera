@model Empodera.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Definir nova senha";
    Layout = "_LoginLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/forget.css" />
}

<div class="background-circles" aria-hidden="true">
    <div class="circle circle-1"></div><div class="circle circle-2"></div>
    <div class="circle circle-3"></div><div class="circle circle-4"></div>
    <div class="circle circle-5"></div><div class="circle circle-6"></div>
</div>

<main class="container-geral reset-container">
    <section class="painel-recovery">
        <div class="logo"><img src="@Url.Content("~/images/Logo-empodera.svg")" alt="Empodera"></div>
        <form class="recovery-form" method="post" asp-action="ResetPassword" asp-controller="Account">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden">
            <input asp-for="Code" type="hidden">
            <h2>Crie uma nova senha</h2>
            <p class="recovery-description">
                Use pelo menos 8 caracteres, com maiúscula, minúscula, número e caractere especial.
            </p>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert" data-testid="reset-error"></div>
            <div class="form-group">
                <label asp-for="Password" class="input-label">Nova senha</label>
                <input asp-for="Password" class="form-input" autocomplete="new-password" data-testid="reset-password">
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword" class="input-label">Confirme a nova senha</label>
                <input asp-for="ConfirmPassword" class="form-input" autocomplete="new-password"
                       data-testid="reset-password-confirmation">
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <button type="submit" class="recovery-button" data-testid="reset-submit">Salvar nova senha</button>
            <a asp-action="Index" asp-controller="Account" class="cancel-button">Cancelar</a>
        </form>
    </section>
    <section class="painel-info">
        <h1>Proteja sua conta</h1>
        <p>Depois da alteração, sessões anteriores serão encerradas e o link não poderá ser reutilizado.</p>
        <a asp-action="Index" asp-controller="Account" class="back-to-login">
            <span class="back-arrow" aria-hidden="true">←</span> Voltar ao login
        </a>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
