@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<div class="background-circles">
        <div class="circle circle-1"></div>
        <div class="circle circle-2"></div>
        <div class="circle circle-3"></div>
        <div class="circle circle-4"></div>
        <div class="circle circle-5"></div>
        <div class="circle circle-6"></div>
    </div>

    <main class="container-geral">
        
        <section class="painel-info">
            <h1>Seja bem-vindo!</h1>
            <p>Coloque usuário e senha para entrar</p>
        </section>

        <section class="painel-login">
            <div class="logo">
                <img src="@Url.Content("~/images/Logo-empodera.svg")" alt="Logo">
            </div>

            <form class="login-form" method="post" asp-action="Index" asp-controller="Account">
                @Html.AntiForgeryToken()
                
                <h2>Faça seu Login:</h2>

                @if (ViewData["LoginError"] is string loginError)
                {
                    <div class="validation-summary-errors" role="alert">@loginError</div>
                }
                
                <div class="form-group">
                    <input 
                        type="email" 
                        class="form-input" 
                        placeholder="Digite seu e-mail"
                        name="Email"
                        data-testid="login-email"
                        required
                    >
                </div>

                <div class="form-group">
                    <input 
                        type="password" 
                        id="passwordInput"
                        class="form-input" 
                        placeholder="Digite sua senha"
                        name="Password"
                        data-testid="login-senha"
                        required
                    >
                </div>

                <div class="form-options">
                    <div class="checkbox-container">
                        <input type="checkbox" id="showPassword">
                        <label for="showPassword">Mostrar senha</label>
                    </div>
                    <a asp-action="Forgot" asp-controller="Account" class="forgot-password">Esqueceu a senha?</a>
                </div>

                <button type="submit" class="login-button" data-testid="login-entrar">ENTRAR</button>
            </form>
        </section>

    </main>

@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
