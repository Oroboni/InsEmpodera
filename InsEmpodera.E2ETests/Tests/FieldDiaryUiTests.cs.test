using Empodera.Models;
using InsEmpodera.E2ETests.Infrastructure;
using Microsoft.EntityFrameworkCore;
using Microsoft.Playwright;
using Xunit;

namespace InsEmpodera.E2ETests.Tests;

[Collection(E2ECollection.Name)]
public sealed class FieldDiaryUiTests(E2ETestFixture fixture) : BrowserTestBase(fixture)
{
    [Fact(DisplayName = "Diário de campo — Nova preserva comunidade filtrada e aceita endereço com espaços")]
    public Task SelectedCommunity_CarriesToCreateAndAddressKeepsSpaces() =>
        RunInBrowserAsync(nameof(SelectedCommunity_CarriesToCreateAndAddressKeepsSpaces), async page =>
        {
            var prerequisites = await GetPrerequisitesAsync();
            await LoginAsync(page);
            await page.GotoAsync("/DiarioCampo");
            await page.Locator("#comunidadeFilter").SelectOptionAsync(prerequisites.CommunityId.ToString());
            await page.Locator(".btn-add[data-create-url]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/DiarioCampo/Create" &&
                new Uri(url).Query.Contains($"comunidadeId={prerequisites.CommunityId}"));
            await Assertions.Expect(page.Locator("select[name=FkIdComunidade]"))
                .ToHaveValueAsync(prerequisites.CommunityId.ToString());
            await Assertions.Expect(page.Locator("#mapa-diario.leaflet-container")).ToBeVisibleAsync();
            var address = page.Locator("input[name=Localizacao]");
            await address.PressSequentiallyAsync("Rua da Paz");
            await Assertions.Expect(address).ToHaveValueAsync("Rua da Paz");
        });

    [Fact(DisplayName = "Diário de campo — formulário visível cria registro sem campo obsoleto")]
    public Task CreateScreen_ValidVisibleFormPersistsWithoutObsoleteFotoField() =>
        RunInBrowserAsync(nameof(CreateScreen_ValidVisibleFormPersistsWithoutObsoleteFotoField), async page =>
        {
            await LoginAsync(page);
            var prerequisites = await GetPrerequisitesAsync();
            var marker = Unique("Diário criado pela UI");
            var countBefore = await Fixture.QueryAsync(db => db.DiariosCampo.CountAsync());

            await page.GotoAsync("/DiarioCampo/Create");
            await Assertions.Expect(page.Locator("input[name=Foto]")).ToHaveCountAsync(0);
            await page.Locator("select[name=FkIdComunidade]").SelectOptionAsync(prerequisites.CommunityId.ToString());
            await page.Locator("input[name=Data]").FillAsync("2026-08-20");
            await page.Locator("textarea[name=Descricao]").FillAsync(marker);
            await page.Locator("input[name=Localizacao]").PressSequentiallyAsync("Rua do Diário, 50");
            await Assertions.Expect(page.Locator("input[name=Localizacao]")).ToHaveValueAsync("Rua do Diário, 50");
            await page.Locator("form.main-form [data-axis-picker] summary").ClickAsync();
            await page.Locator($"input[name=EixosSelecionados][value='{prerequisites.AxisIds[0]}']").CheckAsync();
            await page.Locator("form.main-form > .buttons-container button[type=submit]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/DiarioCampo");

            Assert.Equal(countBefore + 1, await Fixture.QueryAsync(db => db.DiariosCampo.CountAsync()));
            var created = await Fixture.QueryAsync(db => db.DiariosCampo
                .Where(diary => diary.Descricao == marker)
                .Select(diary => new
                {
                    diary.IdDCampo, diary.Foto, diary.FkIdComunidade,
                    diary.Data, diary.Descricao, diary.Localizacao
                })
                .SingleAsync());
            Assert.Null(created.Foto);
            Assert.Equal(prerequisites.CommunityId, created.FkIdComunidade);
            Assert.Equal(new DateTime(2026, 8, 20), created.Data.Date);
            Assert.Equal(marker, created.Descricao);
            Assert.Equal("Rua do Diário, 50", created.Localizacao);
            Assert.Equal([prerequisites.AxisIds[0]], await Fixture.QueryAsync(db => db.DiarioEixos
                .Where(link => link.FkIdDiario == created.IdDCampo)
                .Select(link => link.FkIdEixo).ToArrayAsync()));

            await page.GotoAsync($"/DiarioCampo/Edit/{created.IdDCampo}");
            await Assertions.Expect(page.Locator("select[name=FkIdComunidade]"))
                .ToHaveValueAsync(prerequisites.CommunityId.ToString());
            await Assertions.Expect(page.Locator("input[name=Data]")).ToHaveValueAsync("2026-08-20");
            await Assertions.Expect(page.Locator("textarea[name=Descricao]")).ToHaveValueAsync(marker);
            await Assertions.Expect(page.Locator("input[name=Localizacao]")).ToHaveValueAsync("Rua do Diário, 50");
            await page.Locator("input[name=Data]").FillAsync("2026-08-23");
            await page.Locator("textarea[name=Descricao]").FillAsync(marker + " editado");
            await page.Locator("input[name=Localizacao]").FillAsync("Avenida do Diário, 80");
            await page.Locator("#editForm button[type=submit]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == $"/DiarioCampo/Edit/{created.IdDCampo}");

            var edited = await Fixture.QueryAsync(db => db.DiariosCampo
                .Where(diary => diary.IdDCampo == created.IdDCampo)
                .Select(diary => new { diary.Data, diary.Descricao, diary.Localizacao })
                .SingleAsync());
            Assert.Equal(new DateTime(2026, 8, 23), edited.Data.Date);
            Assert.Equal(marker + " editado", edited.Descricao);
            Assert.Equal("Avenida do Diário, 80", edited.Localizacao);
            await page.GotoAsync($"/DiarioCampo/Edit/{created.IdDCampo}");
            await Assertions.Expect(page.Locator("input[name=Data]")).ToHaveValueAsync("2026-08-23");
            await Assertions.Expect(page.Locator("textarea[name=Descricao]")).ToHaveValueAsync(marker + " editado");
            await Assertions.Expect(page.Locator("input[name=Localizacao]")).ToHaveValueAsync("Avenida do Diário, 80");
            await page.Locator("#openDeleteModalBtn").ClickAsync();
            await page.Locator("#deleteConfirmationModal form button[type=submit]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/DiarioCampo");
            Assert.False(await Fixture.QueryAsync(db => db.DiariosCampo
                .AnyAsync(diary => diary.IdDCampo == created.IdDCampo)));
            Assert.False(await Fixture.QueryAsync(db => db.DiarioEixos
                .AnyAsync(link => link.FkIdDiario == created.IdDCampo)));
        });

    [Fact(DisplayName = "Diário de campo — cadastro inválido exibe orientação, sem tela de erro nem gravação")]
    public Task CreateScreen_InvalidCommunityShowsValidationInsteadOfErrorPage() =>
        RunInBrowserAsync(nameof(CreateScreen_InvalidCommunityShowsValidationInsteadOfErrorPage), async page =>
        {
            await LoginAsync(page);
            var before = await Fixture.QueryAsync(db => db.DiariosCampo.CountAsync());
            await page.GotoAsync("/DiarioCampo/Create");
            await page.Locator("input[name=Data]").FillAsync("2026-08-20");
            await page.Locator("textarea[name=Descricao]").FillAsync("Tentativa com comunidade inexistente");
            await page.Locator("select[name=FkIdComunidade]").EvaluateAsync("select => { const option = new Option('Inexistente', '999999'); select.add(option); select.value = '999999'; }");
            await page.Locator("form.main-form > .buttons-container button[type=submit]").ClickAsync();

            await Assertions.Expect(page).ToHaveURLAsync(new System.Text.RegularExpressions.Regex(@"/DiarioCampo/Create$"));
            await Assertions.Expect(page.Locator("form.main-form [role=alert]"))
                .ToContainTextAsync("Selecione uma comunidade válida.");
            Assert.Equal(before, await Fixture.QueryAsync(db => db.DiariosCampo.CountAsync()));
        });

    [Fact(DisplayName = "Diário de campo — listar, pesquisar, editar vínculos e excluir")]
    public Task SeededDiary_ListSearchFilterDetailsEditRelationshipsAndDelete_ThroughUi() =>
        RunInBrowserAsync(nameof(SeededDiary_ListSearchFilterDetailsEditRelationshipsAndDelete_ThroughUi), async page =>
        {
            var prerequisites = await GetPrerequisitesAsync();
            var marker = Unique("Diário UI");
            var diaryId = await Fixture.QueryAsync(async db =>
            {
                var diary = new DiarioCampo
                {
                    FkIdComunidade = prerequisites.CommunityId,
                    Data = new DateTime(2026, 8, 20),
                    Descricao = marker,
                    Localizacao = "Rua Inicial, 10",
                    Foto = "fixture.png",
                    FkIdUsuario = 1,
                    DtCriacao = DateTime.UtcNow,
                    DtModificacao = DateTime.UtcNow
                };
                db.DiariosCampo.Add(diary);
                await db.SaveChangesAsync();
                db.DiarioEixos.Add(new DiarioEixo
                {
                    FkIdDiario = diary.IdDCampo,
                    FkIdEixo = prerequisites.AxisIds[0]
                });
                await db.SaveChangesAsync();
                return diary.IdDCampo;
            });

            await LoginAsync(page);
            await page.GotoAsync("/DiarioCampo");
            var communityName = await Fixture.QueryAsync(db => db.Comunidades
                .Where(community => community.Id_Comunidade == prerequisites.CommunityId)
                .Select(community => community.Nome).SingleAsync());
            await page.Locator("#comunidadeFilter").SelectOptionAsync(new SelectOptionValue { Label = communityName });
            await Assertions.Expect(page.Locator("input[type=search]")).ToBeEnabledAsync();
            await page.Locator("input[type=search]").FillAsync(marker);
            var diaryCard = page.Locator(".form-item").Filter(new() { HasText = marker });
            await Assertions.Expect(diaryCard).ToBeVisibleAsync();
            await Assertions.Expect(page.Locator(".form-item:visible")).ToHaveCountAsync(1);
            await page.Locator("input[type=search]").FillAsync("diario-inexistente");
            await Assertions.Expect(page.Locator("#noRecordsMessage")).ToBeVisibleAsync();

            await page.GotoAsync($"/DiarioCampo/Details/{diaryId}");
            await Assertions.Expect(page.Locator("textarea[readonly]")).ToContainTextAsync(marker);
            await page.GetByRole(AriaRole.Link, new() { Name = "Editar" }).ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == $"/DiarioCampo/Edit/{diaryId}");

            var editedMarker = marker + " editado";
            await page.Locator("input[name=Data]").FillAsync("2026-08-21");
            await page.Locator("textarea[name=Descricao]").FillAsync(editedMarker);
            await page.Locator("input[name=Localizacao]").FillAsync("Avenida Atualizada, 20");
            await page.Locator("#editForm [data-axis-picker] summary").ClickAsync();
            await page.Locator($"[data-axis-picker] .tag-remove-btn").ClickAsync();
            await page.Locator($"input[name=EixosSelecionados][value='{prerequisites.AxisIds[1]}']").CheckAsync();
            await page.Locator("#editForm button[type=submit]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == $"/DiarioCampo/Edit/{diaryId}");

            var updated = await Fixture.QueryAsync(db => db.DiariosCampo
                .Where(diary => diary.IdDCampo == diaryId)
                .Select(diary => new { diary.Descricao, diary.Localizacao, diary.Data, diary.Foto })
                .SingleAsync());
            Assert.Equal(editedMarker, updated.Descricao);
            Assert.Equal("Avenida Atualizada, 20", updated.Localizacao);
            Assert.Equal("fixture.png", updated.Foto);
            Assert.Equal([prerequisites.AxisIds[1]], await Fixture.QueryAsync(db => db.DiarioEixos
                .Where(link => link.FkIdDiario == diaryId)
                .Select(link => link.FkIdEixo).ToListAsync()));

            await page.GotoAsync($"/DiarioCampo/Edit/{diaryId}");
            await page.Locator("#openDeleteModalBtn").ClickAsync();
            await Assertions.Expect(page.Locator("#deleteConfirmationModal")).ToBeVisibleAsync();
            await page.Locator("#cancelDeleteBtn").ClickAsync();
            await Assertions.Expect(page.Locator("#deleteConfirmationModal")).ToBeHiddenAsync();
            await page.Locator("#openDeleteModalBtn").ClickAsync();
            await page.Locator("#deleteConfirmationModal form button[type=submit]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/DiarioCampo");

            Assert.False(await Fixture.QueryAsync(db => db.DiariosCampo.AnyAsync(diary => diary.IdDCampo == diaryId)));
            Assert.False(await Fixture.QueryAsync(db => db.DiarioEixos.AnyAsync(link => link.FkIdDiario == diaryId)));
        });

    [Fact(DisplayName = "Diário de campo — criar, substituir, reabrir e excluir ação com participantes e eixos")]
    public Task InstitutionalAction_CreateReplaceReopenDelete_PersistsAndCleansRelationships() =>
        RunInBrowserAsync(nameof(InstitutionalAction_CreateReplaceReopenDelete_PersistsAndCleansRelationships), async page =>
        {
            await LoginAsync(page);
            var prerequisites = await GetPrerequisitesAsync();
            var marker = Unique("Diário com ação dinâmica");
            var secondActorId = await Fixture.QueryAsync(async db =>
            {
                var actor = new Atores
                {
                    Nome = Unique("Segundo participante"),
                    Ativo = "S",
                    FkIdUsuario = 1,
                    DtCriacao = DateTime.UtcNow,
                    DtModificacao = DateTime.UtcNow
                };
                db.Atores.Add(actor);
                await db.SaveChangesAsync();
                return actor.IdAtores;
            });

            await page.GotoAsync("/DiarioCampo/Create");
            await page.Locator("select[name=FkIdComunidade]").SelectOptionAsync(prerequisites.CommunityId.ToString());
            await page.Locator("input[name=Data]").FillAsync("2026-08-22");
            await page.Locator("textarea[name=Descricao]").FillAsync(marker);
            await page.Locator("form.main-form [data-axis-picker] summary").ClickAsync();
            await page.Locator($"input[name=EixosSelecionados][value='{prerequisites.AxisIds[0]}']").CheckAsync();

            await page.Locator("button.btn-add-circle").ClickAsync();
            await Assertions.Expect(page.Locator("#modalAcao")).ToBeVisibleAsync();
            await page.Locator("#nomeAcao").FillAsync("Encaminhamento institucional");
            await page.Locator("#provedorAcao").FillAsync("Rede internacional de apoio");
            await page.Locator("#quantidadeAcao").FillAsync("2");
            await page.Locator("#atorAcao").SelectOptionAsync(prerequisites.ActorId.ToString());
            await page.GetByRole(AriaRole.Button, new() { Name = "Adicionar participante" }).ClickAsync();
            await page.Locator("#atorAcao").SelectOptionAsync(secondActorId.ToString());
            await page.GetByRole(AriaRole.Button, new() { Name = "Adicionar participante" }).ClickAsync();
            await Assertions.Expect(page.Locator("#atoresSelecionadosAcao li")).ToHaveCountAsync(2);
            await page.Locator("#modalAcao [data-axis-picker] summary").ClickAsync();
            await page.Locator($"#modalAcao input[name=modalEixos][value='{prerequisites.AxisIds[0]}']").CheckAsync();
            await page.Locator("#modalAcao .btn-confirm").ClickAsync();
            await Assertions.Expect(page.Locator("#container-institucional .action-list-item"))
                .ToContainTextAsync("Encaminhamento institucional");
            await Assertions.Expect(page.Locator("input[name='TempAcoes.Index']")).ToHaveCountAsync(1);

            await page.Locator("form.main-form > .buttons-container button[type=submit]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/DiarioCampo");
            var diaryId = await Fixture.QueryAsync(db => db.DiariosCampo
                .Where(diary => diary.Descricao == marker)
                .Select(diary => diary.IdDCampo).SingleAsync());
            Assert.Equal(string.Empty, await Fixture.QueryAsync(db => db.DiariosCampo
                .Where(diary => diary.IdDCampo == diaryId).Select(diary => diary.Localizacao).SingleAsync()));

            var action = await Fixture.QueryAsync(db => db.DiarioDAcoes
                .Where(item => item.FkIdDiario == diaryId)
                .Select(item => new { item.IdDAcoes, item.Nome, item.PeovedorEx, item.Quantidade })
                .SingleAsync());
            Assert.Equal("Encaminhamento institucional", action.Nome);
            Assert.Equal("Rede internacional de apoio", action.PeovedorEx);
            Assert.Equal(2, action.Quantidade);
            Assert.True(await Fixture.QueryAsync(db => db.DetalhesEixos.AnyAsync(link =>
                link.Detalhes.FkIdDDacoes == action.IdDAcoes
                && link.FkIdEixo == prerequisites.AxisIds[0])));
            Assert.True(await Fixture.QueryAsync(db => db.DAAtores.AnyAsync(link =>
                link.FkIdDDacoes == action.IdDAcoes
                && link.FK_id_Atores == prerequisites.ActorId)));
            Assert.True(await Fixture.QueryAsync(db => db.DAAtores.AnyAsync(link =>
                link.FkIdDDacoes == action.IdDAcoes
                && link.FK_id_Atores == secondActorId)));

            await page.GotoAsync($"/DiarioCampo/Edit/{diaryId}");
            await Assertions.Expect(page.Locator("#container-institucional .action-list-item"))
                .ToContainTextAsync("Encaminhamento institucional");
            await Assertions.Expect(page.Locator("#container-institucional .action-list-item"))
                .ToContainTextAsync("Rede internacional de apoio");
            await page.Locator("#container-institucional .action-list-item button[title=Remover]").ClickAsync();
            await Assertions.Expect(page.Locator("input[name=DAcoesExistentes]")).ToHaveCountAsync(0);

            await page.Locator("button.btn-add-circle").ClickAsync();
            await page.Locator("#nomeAcao").FillAsync("Encaminhamento revisado");
            await page.Locator("#provedorAcao").FillAsync("Serviço comunitário");
            await page.Locator("#quantidadeAcao").FillAsync("1");
            await page.Locator("#atorAcao").SelectOptionAsync(secondActorId.ToString());
            await page.GetByRole(AriaRole.Button, new() { Name = "Adicionar participante" }).ClickAsync();
            await page.Locator("#modalAcao [data-axis-picker] summary").ClickAsync();
            await page.Locator($"#modalAcao input[name=modalEixos][value='{prerequisites.AxisIds[1]}']").CheckAsync();
            await page.Locator("#modalAcao .btn-confirm").ClickAsync();
            await Assertions.Expect(page.Locator("input[name='TempAcoes.Index']")).ToHaveCountAsync(1);
            await page.Locator("#editForm button[type=submit]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == $"/DiarioCampo/Edit/{diaryId}");

            Assert.False(await Fixture.QueryAsync(db => db.DiarioDAcoes
                .AnyAsync(item => item.IdDAcoes == action.IdDAcoes)));
            Assert.False(await Fixture.QueryAsync(db => db.DAAtores
                .AnyAsync(link => link.FkIdDDacoes == action.IdDAcoes)));
            Assert.False(await Fixture.QueryAsync(db => db.DetalhesEixos
                .AnyAsync(link => link.Detalhes.FkIdDDacoes == action.IdDAcoes)));
            var replacement = await Fixture.QueryAsync(db => db.DiarioDAcoes
                .Where(item => item.FkIdDiario == diaryId)
                .Select(item => new { item.IdDAcoes, item.Nome, item.PeovedorEx, item.Quantidade })
                .SingleAsync());
            Assert.Equal("Encaminhamento revisado", replacement.Nome);
            Assert.Equal("Serviço comunitário", replacement.PeovedorEx);
            Assert.Equal(1, replacement.Quantidade);
            Assert.True(await Fixture.QueryAsync(db => db.DetalhesEixos.AnyAsync(link =>
                link.Detalhes.FkIdDDacoes == replacement.IdDAcoes
                && link.FkIdEixo == prerequisites.AxisIds[1])));
            Assert.True(await Fixture.QueryAsync(db => db.DAAtores.AnyAsync(link =>
                link.FkIdDDacoes == replacement.IdDAcoes
                && link.FK_id_Atores == secondActorId)));

            await page.GotoAsync($"/DiarioCampo/Edit/{diaryId}");
            await Assertions.Expect(page.Locator("#container-institucional .action-list-item"))
                .ToContainTextAsync("Encaminhamento revisado");
            await page.Locator("#openDeleteModalBtn").ClickAsync();
            await page.Locator("#deleteConfirmationModal form button[type=submit]").ClickAsync();
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/DiarioCampo");
            Assert.False(await Fixture.QueryAsync(db => db.DiariosCampo
                .AnyAsync(item => item.IdDCampo == diaryId)));
            Assert.False(await Fixture.QueryAsync(db => db.DiarioDAcoes
                .AnyAsync(item => item.IdDAcoes == replacement.IdDAcoes)));
            Assert.False(await Fixture.QueryAsync(db => db.DAAtores
                .AnyAsync(link => link.FkIdDDacoes == replacement.IdDAcoes)));
            Assert.False(await Fixture.QueryAsync(db => db.DetalhesEixos
                .AnyAsync(link => link.Detalhes.FkIdDDacoes == replacement.IdDAcoes)));
        });

    private async Task<DiaryPrerequisites> GetPrerequisitesAsync() =>
        await Fixture.QueryAsync(async db => new DiaryPrerequisites(
            await db.Comunidades.Where(community => community.Ativo == "S")
                .OrderBy(community => community.Id_Comunidade)
                .Select(community => community.Id_Comunidade).FirstAsync(),
            await db.Eixos.OrderBy(axis => axis.IdEixo)
                .Select(axis => axis.IdEixo).Take(2).ToArrayAsync(),
            await db.Atores.Where(actor => actor.Ativo == "S")
                .OrderBy(actor => actor.IdAtores).Select(actor => actor.IdAtores).FirstAsync()));

    private sealed record DiaryPrerequisites(int CommunityId, int[] AxisIds, int ActorId);
}
