using InsEmpodera.E2ETests.Infrastructure;
using InsEmpodera.E2ETests.Pages;
using Microsoft.Playwright;
using Xunit;

namespace InsEmpodera.E2ETests.Tests;

[Collection(E2ECollection.Name)]
public sealed class AuthenticationAndNavigationTests(E2ETestFixture fixture) : BrowserTestBase(fixture)
{
    [Fact(DisplayName = "Autenticação — proteger páginas, validar credenciais, criar e encerrar sessão")]
    public Task ProtectedPage_RedirectsToLogin_AndValidLoginCreatesSession() =>
        RunInBrowserAsync(nameof(ProtectedPage_RedirectsToLogin_AndValidLoginCreatesSession), async page =>
        {
            await page.GotoAsync("/Users");
            Assert.Equal("/Account", new Uri(page.Url).AbsolutePath);
            await Assertions.Expect(page.GetByRole(AriaRole.Heading, new() { Name = "Faça seu Login:" }))
                .ToBeVisibleAsync();

            var login = new LoginPage(page);
            await login.EntrarAsync(E2ETestFixture.AdminEmail, "senha-incorreta");
            Assert.Equal("/Account", new Uri(page.Url).AbsolutePath);

            await login.EntrarAsync(E2ETestFixture.AdminEmail, E2ETestFixture.AdminPassword);
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/");
            await Assertions.Expect(page.Locator("#sidebar")).ToContainTextAsync("Olá, joao");

            await page.GotoAsync("/Users");
            await Assertions.Expect(page.GetByRole(AriaRole.Heading, new() { Name = "Usuários" }))
                .ToBeVisibleAsync();

            var logoutRequest = await page.RunAndWaitForRequestAsync(
                () => page.Locator("#sidebar li[data-page=logout] button[type=submit]").ClickAsync(),
                request => new Uri(request.Url).AbsolutePath == "/Account/Logout");
            Assert.Equal("POST", logoutRequest.Method);
            Assert.Contains("__RequestVerificationToken=", logoutRequest.PostData ?? string.Empty);
            await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/Account");
            await page.GotoAsync("/Users");
            Assert.Equal("/Account", new Uri(page.Url).AbsolutePath);
        });

    [Theory(DisplayName = "Login — senha, recuperação e idioma acompanham o navegador")]
    [InlineData("pt-BR", "pt-BR")]
    [InlineData("en-US", "en")]
    [InlineData("es-ES", "es")]
    public Task LoginInteractions_ShowPassword_ForgotLink_AndBrowserLocaleWork(
        string browserLocale,
        string expectedHtmlLanguage) =>
        RunInBrowserAsync(
            $"{nameof(LoginInteractions_ShowPassword_ForgotLink_AndBrowserLocaleWork)}-{expectedHtmlLanguage}",
            async page =>
            {
                await page.GotoAsync("/Account");
                Assert.Equal(expectedHtmlLanguage, await page.Locator("html").GetAttributeAsync("lang"));

                var password = page.GetByTestId("login-senha");
                await password.FillAsync("segredo");
                Assert.Equal("password", await password.GetAttributeAsync("type"));
                await page.Locator("#showPassword").CheckAsync();
                Assert.Equal("text", await password.GetAttributeAsync("type"));
                await page.Locator("#showPassword").UncheckAsync();
                Assert.Equal("password", await password.GetAttributeAsync("type"));

                await page.Locator("a.forgot-password").ClickAsync();
                await page.WaitForURLAsync(url => new Uri(url).AbsolutePath == "/Account/Forgot");
                await page.GetByTestId("recovery-email").FillAsync($"missing-{Guid.NewGuid():N}@example.org");
                await page.GetByTestId("recovery-submit").ClickAsync();
                await Assertions.Expect(page.GetByTestId("recovery-submitted")).ToBeVisibleAsync();
            },
            new BrowserNewContextOptions
            {
                BaseURL = Fixture.BaseUrl,
                Locale = browserLocale,
                ViewportSize = new ViewportSize { Width = 1280, Height = 900 }
            });
}
