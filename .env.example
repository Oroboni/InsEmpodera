# Copie para .env (o .env nunca vai para o Git) e troque TODOS os valores.
# Gere senhas fortes, por exemplo: openssl rand -base64 24

# Banco (MySQL 8.4)
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_USER=empodera_app
MYSQL_PASSWORD=troque-esta-senha-da-aplicacao

# Endereço público (HTTPS) e domínio aceito pela aplicação
APP_URL_PUBLICA=https://seu-dominio.example
APP_DOMINIO=seu-dominio.example
APP_PORTA=8080

# E-mail de recuperação de senha (senha de aplicativo do Gmail).
# Deixe EMAIL_SENHA vazio enquanto a conta não existir: o sistema funciona normalmente,
# "Esqueci minha senha" mostra um aviso e o administrador troca senhas na tela Usuários.
EMAIL_USUARIO=empodera.ajuda@gmail.com
EMAIL_SENHA=

# Só na instalação nova: senha do administrador (usuário 1). Apague depois do primeiro acesso.
SENHA_INICIAL_ADMIN=
